{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/servicios", "destination": "/#servicios", "permanent": true },
    { "source": "/servicios/:path*", "destination": "/#servicios", "permanent": true },
    { "source": "/nosotros", "destination": "/#equipo", "permanent": true },
    { "source": "/metodologia", "destination": "/#metodologia", "permanent": true },
    { "source": "/contacto", "destination": "/discovery/", "permanent": true },
    { "source": "/cotiza", "destination": "/discovery/", "permanent": true },
    { "source": "/licenciaskommo", "destination": "/kommo/", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": false },
    { "source": "/blog/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/(fonts|vendor|img|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
