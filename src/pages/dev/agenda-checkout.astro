---
// /dev/agenda-checkout/ — "Stripe simulado" de la agenda (noindex; solo existe en desarrollo y se borra de dist/ en Verificar).
// El Checkout simulado de server/agenda/mock.js manda aquí: ?session_id=cs_test_MOCK_<evento>&apartado=<evento>.
//   "Simular pago" → POST /api/agenda/estado/ { simular: 'pago' } (solo responde en simulación) → /agendar/confirmado/?session_id=…
//   "Cancelar"     → /power-session/?pago=cancelado&apartado=… (como el cancel_url real de Stripe)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage } from '../../lib/site';
import { POWER_PRICE } from '../../components/agenda/textos';
import { CONFIRM_PATH, LANDING } from '../../../shared/agenda.js';

const base = getPage('/') as any;
const page = { ...base, id: 'dev-agenda-checkout', url: '/dev/agenda-checkout/', canonical: 'https://ingeniak.mx/dev/agenda-checkout/', indexable: false, hidden: true, primaryCta: null, sections: [] } as any;
---
<BaseLayout page={page} nav="reduced" noindex title="Dev · Stripe simulado · Ingeniak" rail={false} coldOpen={false} footer={false}>
  <section class="dv-co" data-dev-checkout data-confirm={CONFIRM_PATH} data-cancel={LANDING.power}>
    <div class="dv-co__card glass-panel">
      <p class="chip-sim">Stripe simulado · nada se cobra</p>
      <h1 class="dv-co__h" data-allow-number>Power Session · 90 min 1:1 con Rik Landeros</h1>
      <p class="dv-co__price"><span data-offer="power-price">{POWER_PRICE}</span> · pago único</p>
      <dl class="dv-co__dl">
        <div><dt>Sesión de pago</dt><dd data-dv-sid>—</dd></div>
        <div><dt>Apartado</dt><dd data-dv-ap>—</dd></div>
      </dl>
      <p class="dv-co__err" data-dv-err hidden>No se pudo simular el pago (¿la API está en simulación?).</p>
      <div class="dv-co__a">
        <button type="button" class="btn" data-dv-pay>
          <span class="btn__t">Simular pago</span>
          <span class="btn__node" aria-hidden="true"><svg viewBox="0 0 16 16"><rect class="n" x="5" y="5" width="6" height="6" rx="1"/><path class="r" d="M8 8h6M11 5l3 3-3 3"/></svg></span>
        </button>
        <a class="btn btn--ghost" data-dv-cancel><span class="btn__t">Cancelar</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-dev-checkout]');
  if (root) {
    const q = new URLSearchParams(location.search);
    const sid = q.get('session_id') ?? '';
    const ap = q.get('apartado') ?? '';
    root.querySelector('[data-dv-sid]')!.textContent = sid || '—';
    root.querySelector('[data-dv-ap]')!.textContent = ap || '—';
    const cancel = root.querySelector<HTMLAnchorElement>('[data-dv-cancel]')!;
    cancel.href = `${root.dataset.cancel}?pago=cancelado&apartado=${encodeURIComponent(ap)}`;
    root.querySelector<HTMLButtonElement>('[data-dv-pay]')!.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      try {
        const r = await fetch('/api/agenda/estado/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ simular: 'pago', session_id: sid }),
        });
        const j = await r.json().catch(() => ({}));
        if (!j.ok) throw new Error('sin simulación');
        location.assign(`${root.dataset.confirm}?session_id=${encodeURIComponent(sid)}`);
      } catch {
        root.querySelector<HTMLElement>('[data-dv-err]')!.hidden = false;
        b.disabled = false;
      }
    });
  }
</script>

<style>
  .dv-co{display:grid;place-items:center;min-height:calc(100svh - var(--hdr));padding:calc(var(--hdr) + 48px) var(--safe-x) 64px}
  .dv-co__card{display:grid;gap:18px;width:min(520px,100%);padding:32px}
  .dv-co .chip-sim{justify-self:start}
  .dv-co__h{font:500 1.5rem/1.2 var(--f-display);letter-spacing:-.015em}
  .dv-co__price{font:300 1.375rem/1.3 var(--f-display);color:var(--soft)}
  .dv-co__dl{display:grid;gap:8px;font:400 .8125rem/1.4 var(--f-mono);color:var(--muted);word-break:break-all}
  .dv-co__dl dt{color:var(--text-2)}
  .dv-co__dl dd{margin:0}
  .dv-co__err{color:var(--amber)}
  .dv-co__a{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}
</style>
