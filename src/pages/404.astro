---
// /404 · T-404 (ESPEC-v2 §5.13). Un solo ImageSection de portada + Footer. noindex y sin JSON-LD (SEOHead lo decide por la plantilla).
// Placa: "404-hero" (Kain mirando una rama de luz cortada). Mientras no exista, respaldo = home-hero en espejo (el sujeto pasa
// a la izquierda y el texto a la derecha; cuando llegue 404-hero, su propio lado manda).
// Texto: src/content/paginas/404.json → sections.hero si el área copy lo publica; si no, el brief de sitemap.json + ESPEC §5.13.
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSection from '../components/cine/ImageSection.astro';
import ScriptList from '../components/ui/ScriptList.astro';
import Btn from '../components/ui/Btn.astro';
import Copy from '../components/ui/Copy.astro';
import { plateReady } from '../components/cine/plate';
import { tryCopy } from '../components/layout/copyText';
import { tokensToText } from '../components/ui/ui-data';
import { getPage, section, waHref } from '../lib/site';

const page = getPage('/404') as any;
const hero = section(page, 'hero') ?? {};
const pl = hero.plate ?? { id: '404-hero' };
const fallback = pl.launchFallback ?? { plate: 'home-hero', mirror: true };
const fbId = typeof fallback === 'string' ? fallback : fallback.plate;
const lcpPlate = plateReady(pl.id) ? pl.id : plateReady(fbId) ? fbId : undefined;

const c = tryCopy(page.id)?.sections?.hero ?? {};
const T = {
  eyebrow: c.eyebrow ?? 'Error 404 · Ruta sin conexión',
  h1: c.h1?.text ?? page.h1,
  lede: c.lede ?? 'Kain buscó por todos lados y esta página no existe (o se mudó).',
  rows: (c.items as any[] | undefined) ?? [
    { title: 'Inicio', line: 'Qué hacemos y cómo funciona el sistema.', href: '/' },
    { title: 'Servicios', line: 'Agentes de IA, CRM, automatización y más, por etapa.', href: '/servicios/' },
    { title: 'Casos', line: 'Sistemas reales operando hoy, con su fuente.', href: '/casos/' },
    { title: 'Blog', line: 'Guías sin humo para decidir mejor.', href: '/blog/' },
  ],
  search: c.search ?? 'Buscar en el sitio',
  rescueLabel: c.rescueLabel ?? 'Rutas que sí están conectadas',
  wa: { label: c.ctaSecondary?.label ?? page.secondaryCta?.label ?? 'Escríbele a Kain', msg: c.ctaSecondary?.waMessage ?? page.secondaryCta?.waMessage },
};
const wa = T.wa.msg ? waHref(T.wa.msg) : page.secondaryCta?.href;
---
<BaseLayout page={page} lcpPlate={lcpPlate} lcpSrcsetMax={pl.srcsetMax ?? 2752} rail={false} noindex bodyClass="e404-page">
  <ImageSection id="hero" plate={pl.id} fallbackPlate={fallback} height="hero" mobile="top" priority srcsetMax={pl.srcsetMax} class="e404">
    <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{T.eyebrow}</p>
    <h1 id="hero-t" class="t-display-2 e404__h1" data-split>{T.h1}</h1>
    <Copy text={T.lede} as="p" class="t-lede t-lede--2" />
    <ScriptList label={T.rescueLabel} headingLevel={3} rows={T.rows.map((r: any, i: number) => ({ n: String(i + 1).padStart(2, '0'), title: tokensToText(r.title), line: tokensToText(r.line ?? ''), href: r.href }))} />
    <div class="ctas">
      <Btn variant="ghost" icon="search" label={T.search} data-search-open aria-keyshortcuts="Meta+K Control+K">
        {T.search} <kbd class="e404__kbd" data-kbd-mod aria-hidden="true">⌘K</kbd>
      </Btn>
      {wa && <Btn variant="ghost" href={wa} label={T.wa.label} />}
    </div>
  </ImageSection>
</BaseLayout>
