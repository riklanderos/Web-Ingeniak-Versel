---
// /blog/<slug>/ · T-ARTICLE (ESPEC §5.10). Una página por artículo de sitemap.json cuyo texto ya existe en
// src/content/paginas/<page.id>.json. Hoy: /blog/cuanto-cuesta-agente-ia-whatsapp-mexico/ y /blog/kommo-vs-gohighlevel/.
// Los demás artículos aparecen solos (y dejan de pintarse como texto en los enlaces) en cuanto el área copy publique su JSON.
// El hub /blog/ (T-HUB) no sale de aquí: necesita su propia ruta src/pages/blog/index.astro.
import ArticleTemplate from '../../components/templates/ArticleTemplate.astro';
import { pages } from '../../lib/site';

export function getStaticPaths() {
  const copies = import.meta.glob('../../content/paginas/*.json');
  const hasCopy = (id: string) => Object.keys(copies).some((k) => k.endsWith(`/${id}.json`));
  return pages
    .filter((p: any) => p.template === 'T-ARTICLE' && hasCopy(p.id))
    .map((p: any) => ({ params: { slug: p.url.split('/').filter(Boolean).pop() }, props: { page: p } }));
}
const { page } = Astro.props;
---
<ArticleTemplate page={page} />
