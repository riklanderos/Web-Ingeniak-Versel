---
// Btn · ESPEC §2.9. Un solo primario azul en el sitio: "Agenda tu Discovery Session".
//   primary → .btn + data-primary (regla de un azul, F15) + data-magnetic (±6 px, pointer:fine) + nodo del isotipo
//             micro=true → envuelve en .cta-p con la microcopia "30 min · 1:1 · Google Meet · sin costo" pegada al botón
//   ghost   → .btn.btn--ghost (WhatsApp "Escríbele a Kain": wa=true pone el icono de línea a la izquierda)
//   sm      → .btn.btn--sm (encabezado; ghost=true lo vuelve contorno)
//   icon    → .btn-icon circular de 40 px (aria-label obligatorio: prop label)
import Icon from './Icon.astro';
import { DISCOVERY_MICRO } from './ui-data';

interface Props {
  variant?: 'primary' | 'ghost' | 'sm' | 'icon';
  href?: string; label?: string; micro?: boolean; wa?: boolean; ghost?: boolean;
  icon?: string; external?: boolean; node?: boolean; type?: 'button' | 'submit';
  class?: string; id?: string; [key: string]: any;
}
const { variant = 'primary', href, label, micro = false, wa = false, ghost = false, icon, external, node, type = 'button', class: cls, id, ...rest } = Astro.props;

const isExternal = external ?? (!!href && /^https?:\/\//.test(href));
const isWa = wa || (!!href && /wa\.me\//.test(href));
const hasSlot = Astro.slots.has('default');
const text = label;
if (variant === 'icon' && !label) throw new Error('[ui/Btn] variant="icon" necesita label (aria-label)');
const showNode = node ?? (variant === 'primary' || (variant === 'sm' && !ghost));
const classes = [
  variant === 'icon' ? 'btn-icon' : 'btn',
  variant === 'ghost' && 'btn--ghost',
  variant === 'sm' && 'btn--sm',
  variant === 'sm' && ghost && 'btn--ghost',
  isWa && variant !== 'icon' && 'btn--wa',
  cls,
];
const attrs: Record<string, any> = {
  ...rest,
  id,
  'data-primary': variant === 'primary' ? '' : undefined,
  'data-magnetic': variant === 'primary' ? '' : undefined,
  'data-wa': isWa ? '' : undefined,
  target: isExternal && !isWa ? '_blank' : undefined,
  rel: isExternal ? 'noopener' : undefined,
  'aria-label': variant === 'icon' ? label : rest['aria-label'],
};
const Tag = href ? 'a' : 'button';
---
{variant === 'primary' && micro ? (
  <div class="cta-p">
    <Tag class:list={classes} href={href} type={href ? undefined : type} {...attrs}>
      <span class="btn__t">{hasSlot ? <slot /> : text}</span>
      <span class="btn__node" aria-hidden="true"><svg viewBox="0 0 16 16"><rect class="n" x="5" y="5" width="6" height="6" rx="1" /><path class="r" d="M8 8h6M11 5l3 3-3 3" /></svg></span>
    </Tag>
    <p class="t-micro btn-micro" data-allow-number>{DISCOVERY_MICRO}</p>
  </div>
) : variant === 'icon' ? (
  <Tag class:list={classes} href={href} type={href ? undefined : type} {...attrs}>
    <Icon name={icon ?? (isWa ? 'whatsapp' : 'arrow')} size={18} />
  </Tag>
) : (
  <Tag class:list={classes} href={href} type={href ? undefined : type} {...attrs}>
    {isWa && <Icon name="whatsapp" size={variant === 'sm' ? 16 : 18} class="btn__ico" />}
    {!isWa && icon && <Icon name={icon} size={variant === 'sm' ? 16 : 18} class="btn__ico" />}
    <span class="btn__t">{hasSlot ? <slot /> : text}</span>
    {isExternal && !isWa && variant !== 'primary' && <Icon name="external" size={16} class="btn__ext" />}
    {showNode && <span class="btn__node" aria-hidden="true"><svg viewBox="0 0 16 16"><rect class="n" x="5" y="5" width="6" height="6" rx="1" /><path class="r" d="M8 8h6M11 5l3 3-3 3" /></svg></span>}
  </Tag>
)}
