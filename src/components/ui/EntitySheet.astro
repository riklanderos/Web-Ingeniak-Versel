---
// EntitySheet · ESPEC §2.11 "Ficha" + §6 #39. <dl> con filetes: término en mono, valor en Inter.
// Mismos datos que el JSON-LD y llms.txt (SITE + METRICS). La razón social NO se imprime hasta confirmarla (§4.8, R14).
//   home   → "Ficha técnica · Ingeniak en datos" (inicio ESC 12)
//   footer → ficha compacta de la entidad en los créditos finales
//   about  → Nosotros (entidad + equipo + sub-marca)
//   local  → NAP de /agentes-ia-guadalajara/
//   case   → ficha del caso: rows=[{term, value}] (solo lo confirmado) + metricIds (cifras del caso)
// rows (cualquier variante): el copy es la ÚNICA fuente (p. ej. home.sections.faq.entity). Los tokens ({{metric:…}},
//   {{Price}}…) se resuelven con data-metric / data-allow-number; "Alianza" suma el sello de Kommo; "Contacto" enlaza el
//   correo (mailto) y el WhatsApp; "Primer paso" enlaza «Cotizar proyecto» al modal de cotización (data-cotizar
//   data-section="ficha", href SITE.quote.href; CAMBIO-COTIZAR §1.4). Sin rows, la ficha sale de SITE + METRICS.
// waHref: el enlace de WhatsApp de la página (mensaje único por página, R10/check-seo) para las filas de contacto, teléfono y
//   WhatsApp; sin él, un mensaje genérico. Filas con href: WhatsApp lleva data-wa (medición); un sitio externo abre en otra
//   pestaña (target _blank, rel noopener) con la marca visual ↗ fuera del texto accesible.
import Metric from './Metric.astro';
import KommoBadge from './KommoBadge.astro';
import { SITE, waHref, linkTarget } from '../../lib/site';
import { priceText, type MetricId } from '../../lib/metrics';
import { currentLang, localHref } from '../../lib/i18n';
import { COUNTRIES, VKTOR, annotateFigures, esc } from './ui-data';
import { QUOTE, quoteAttrs, quoteHref, isHiddenHref } from '../layout/cta';

interface Props {
  variant?: 'home' | 'footer' | 'case' | 'about' | 'local';
  rows?: { term: string; value: string; href?: string }[]; metricIds?: MetricId[];
  title?: string | false; class?: string; id?: string; waHref?: string;
}
const { variant = 'home', rows = [], metricIds = [], title, class: cls, id, waHref: waPage } = Astro.props;
const A = SITE.address;
const addr = `${A.street}, ${A.locality}, ${A.region} ${A.postal}`;
const tel = `tel:${SITE.phoneE164}`;
const lang = currentLang();
const en = lang === 'en';
const PRICE_FROM_CAP = priceText('Price', lang);
// Rótulos fijos de la ficha (versión /en/, 2026-11-20). En español, idénticos a los de siempre.
const T = en ? {
  name: 'Name', hq: 'Headquarters', office: 'Office', alliance: 'Partnership', kommo: 'Official Kommo partner in Latin America', prod: 'In production',
  countries: 'Countries', team: 'Team', teamV: 'A team that designs, builds and runs your system with you', method: 'Methodology', sub: 'Sub-brand',
  invest: 'Pricing', first: 'First step', entity: 'Entity', email: 'Email', reach: 'Reach', figure: 'Key figure', address: 'Address', mexico: 'Mexico',
  phone: 'Phone and WhatsApp', msgKain: 'Message Kain', serve: 'We serve', serveV: 'Guadalajara and its metro area; Mexico and Latin America remotely',
  sheet: 'Fact sheet', hqTag: 'HQ',
} : {
  name: 'Nombre', hq: 'Sede', office: 'Oficina', alliance: 'Alianza', kommo: 'Partner oficial de Kommo en LATAM', prod: 'En producción',
  countries: 'Países', team: 'Equipo', teamV: 'Un equipo que diseña, construye y opera tu sistema contigo', method: 'Metodología', sub: 'Sub-marca',
  invest: 'Inversión', first: 'Primer paso', entity: 'Entidad', email: 'Correo', reach: 'Alcance', figure: 'Cifra', address: 'Dirección', mexico: 'México',
  phone: 'Teléfono y WhatsApp', msgKain: 'Escríbele a Kain', serve: 'Atendemos', serveV: 'Guadalajara y su zona metropolitana; México y Latinoamérica en remoto',
  sheet: 'Ficha', hqTag: 'sede',
};
const wa = waPage || waHref(en ? 'Hi Kain, I’m coming from the English site and want more information about Ingeniak.' : 'Hola Kain, quiero información sobre Ingeniak.');
const heading = title === false ? null : title ?? (en
  ? ({ home: 'Fact sheet · Ingeniak by the numbers', footer: 'Company fact sheet', case: 'Case fact sheet', about: 'Fact sheet · Ingeniak', local: 'Ingeniak in Guadalajara' } as const)
  : ({ home: 'Ficha técnica · Ingeniak en datos', footer: 'Ficha de la entidad', case: 'Ficha del caso', about: 'Ficha · Ingeniak', local: 'Ingeniak en Guadalajara' } as const))[variant];
const vktor = VKTOR.map((v) => v.name).join(' · ');
const countries = COUNTRIES.map((c) => (c.sede ? `${c.name} (${T.hqTag})` : c.name)).join(', ');
// Términos del copy que deciden enlaces y sellos: español e inglés (en-home.json, en-contacto.json).
const RX_FIRST = /primer paso|first step/;
const RX_ALLIANCE = /alianza|partnership|alliance/i;
const RX_NUMBERS = /oficina|direcci|contacto|tel|office|address|contact|phone/i;
const RX_CONTACT = /contacto|correo|whatsapp|tel[eé]fono|contact|e-?mail|phone/;
// "Primer paso": enlace «Cotizar proyecto» al modal. Si el copy todavía trae el texto heredado de la Discovery, la fila usa
// el texto de la cotización (etiqueta + "te contactamos por WhatsApp y correo"), nunca un enlace a una landing oculta.
const qHref = quoteHref(Astro.url?.pathname);
const qAttrs = Object.entries(quoteAttrs('ficha')).map(([k, v]) => (v === '' ? k : `${k}="${esc(v)}"`)).join(' ');
const qLink = (label: string) => `<a href="${esc(qHref)}" ${qAttrs}>${esc(label)}</a>`;
const firstStepText = QUOTE.primerPaso;   // _comun.cta.primerPaso
function firstStepHtml(value: string): string {
  const v = /discovery|google\s?meet|\b30\s?min/i.test(value) ? firstStepText : value;
  const h = annotateFigures(v);
  const k = esc(QUOTE.label);
  return h.includes(k) ? h.replace(k, qLink(QUOTE.label)) : `${qLink(QUOTE.label)} · ${h}`;
}
/** Valor de una fila del copy → HTML seguro con tokens resueltos y los enlaces propios de su término. */
const EMAIL = /[\w.+-]+@[\w-]+(?:\.[\w-]+)+/g;
function rowHtml(term: string, value: string, href?: string) {
  let h = annotateFigures(value);
  const t = term.toLowerCase();
  if (RX_FIRST.test(t)) return firstStepHtml(value);
  if (href && isHiddenHref(href)) return h;
  if (href) {
    const to0 = linkTarget(href);
    if (!to0) return h;
    const to = localHref(to0, lang);
    if (/^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i.test(to)) return `<a href="${esc(to)}" data-wa>${h}</a>`;
    if (/^https?:\/\//i.test(to) && !/^https?:\/\/(www\.)?ingeniak\.mx(\/|$)/i.test(to)) return `<a href="${esc(to)}" target="_blank" rel="noopener">${h}<span aria-hidden="true"> ↗</span></a>`;
    return `<a href="${esc(to)}">${h}</a>`;
  }
  if (RX_CONTACT.test(t) || EMAIL.test(value)) {
    EMAIL.lastIndex = 0;
    h = h.replace(EMAIL, (m) => `<a href="mailto:${m}">${m}</a>`);
    h = h.replace(/(WhatsApp\s*)?(<span data-allow-number>\+52[^<]*<\/span>)/, (_m, w = '', num) => `<a href="${esc(wa)}" data-wa>${w}${num}</a>`);
  }
  return h;
}
const copyRows = variant !== 'case' && rows.length > 0;
---
<div class:list={['sheet', `sheet--${variant}`, cls]} id={id} role="group" aria-label={heading ?? T.sheet} data-ui-reveal>
  {heading && <p class="t-label t-label--cyan sheet__h"><span class="node" aria-hidden="true"></span>{heading}</p>}
  <dl class="sheet__dl">
    {variant === 'case' && (
      <>
        {rows.map((r) => <div class="sheet__row"><dt>{r.term}</dt><dd set:html={rowHtml(r.term, r.value, r.href)} /></div>)}
        {metricIds.map((m) => <div class="sheet__row sheet__row--metric"><dt>{T.figure}</dt><dd><Metric id={m} variant="inline" label /></dd></div>)}
      </>
    )}

    {copyRows && rows.map((r) => (
      <div class:list={['sheet__row', RX_ALLIANCE.test(r.term) && 'sheet__row--badge']}>
        <dt>{r.term}</dt>
        <dd data-allow-number={RX_NUMBERS.test(r.term) ? '' : undefined}>
          {RX_ALLIANCE.test(r.term)
            ? <><span set:html={annotateFigures(r.value)} /><KommoBadge size="sm" label={false} /></>
            : <Fragment set:html={rowHtml(r.term, r.value, r.href)} />}
        </dd>
      </div>
    ))}

    {!copyRows && (variant === 'home' || variant === 'about') && (
      <>
        {variant === 'about' && <div class="sheet__row"><dt>{T.name}</dt><dd>{SITE.name}</dd></div>}
        <div class="sheet__row"><dt>{T.hq}</dt><dd>{en ? 'Guadalajara, Jalisco, Mexico' : SITE.city}</dd></div>
        <div class="sheet__row"><dt>{T.office}</dt><dd data-allow-number>{addr}</dd></div>
        <div class="sheet__row sheet__row--badge"><dt>{T.alliance}</dt><dd><span>{T.kommo}</span><KommoBadge size="sm" label={false} /></dd></div>
        <div class="sheet__row"><dt>{T.prod}</dt><dd><Metric id="sistemas" variant="inline" label /></dd></div>
        <div class="sheet__row"><dt>{T.countries}</dt><dd><Metric id="paises" variant="inline" label />: {countries}</dd></div>
        {variant === 'about' && <div class="sheet__row"><dt>{T.team}</dt><dd>{T.teamV}</dd></div>}
        <div class="sheet__row"><dt>{T.method}</dt><dd>VKTOR™ = {vktor}</dd></div>
        {variant === 'about' && <div class="sheet__row"><dt>{T.sub}</dt><dd><span class="kain-mark">kain</span> · <a href={SITE.kainApp} target="_blank" rel="noopener">app.kain.mx ↗</a></dd></div>}
        <div class="sheet__row"><dt>{T.invest}</dt><dd data-allow-number>{PRICE_FROM_CAP}</dd></div>
        <div class="sheet__row"><dt>{T.first}</dt><dd set:html={firstStepHtml(firstStepText)} /></div>
      </>
    )}

    {!copyRows && variant === 'footer' && (
      <>
        <div class="sheet__row"><dt>{T.entity}</dt><dd>{SITE.name} · {en ? 'Guadalajara, Jalisco, Mexico' : SITE.city}</dd></div>
        <div class="sheet__row"><dt>{T.office}</dt><dd data-allow-number>{addr}</dd></div>
        <div class="sheet__row"><dt>{T.email}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div class="sheet__row"><dt>WhatsApp</dt><dd data-allow-number><a href={wa} data-wa>{SITE.phone}</a></dd></div>
        <div class="sheet__row"><dt>{T.reach}</dt><dd><Metric id="sistemas" variant="inline" label /> · <Metric id="paises" variant="inline" label /></dd></div>
        <div class="sheet__row sheet__row--badge"><dt>{T.alliance}</dt><dd><KommoBadge size="sm" /></dd></div>
      </>
    )}

    {!copyRows && variant === 'local' && (
      <>
        <div class="sheet__row"><dt>{T.name}</dt><dd>{SITE.name}</dd></div>
        <div class="sheet__row"><dt>{T.address}</dt><dd data-allow-number>{addr}, {T.mexico}</dd></div>
        <div class="sheet__row"><dt>{T.phone}</dt><dd data-allow-number><a href={tel}>{SITE.phone}</a> · <a href={wa} data-wa>{T.msgKain}</a></dd></div>
        <div class="sheet__row"><dt>{T.email}</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div class="sheet__row"><dt>{T.serve}</dt><dd>{T.serveV}</dd></div>
        <div class="sheet__row sheet__row--badge"><dt>{T.alliance}</dt><dd><span>{T.kommo}</span><KommoBadge size="sm" label={false} /></dd></div>
      </>
    )}
  </dl>
</div>
