---
// Montage · cifras como escena (§5.1 ESC 08, §6 #21, §7.4): cada cifra confirmada en --fs-mega (Lexend 200)
// con la placa del caso DENTRO de las letras (capa blanca en `screen` para legibilidad), filas alternadas,
// contexto mono, enlace al caso y nota de fuente. Las cifras son texto real (<Metric>, data-metric).
// Movimiento: filas xPercent ±6 en sentidos alternos y --px 20 % → 80 % dentro de las letras (scrub, sin pin).
// Slots: default (eyebrow + H2 con id "<id>-t") · foot (enlaces "Ver todos los casos →" …).
import Metric from '../ui/Metric.astro';
import { METRICS, SOURCE_NOTE, type MetricId } from '../../lib/metrics';
import { resolvePlate, AURA_ONDAS } from './plate';

interface Props {
  id?: string;
  ids: MetricId[];
  transversal?: MetricId[];
  stillFor?: Partial<Record<MetricId, string>>;
  anonNote?: string;
  class?: string;
}
const { id = 'casos', ids, transversal, stillFor = {}, anonNote = 'Nombres de clientes anonimizados.', class: cls } = Astro.props;
const still = (mid: MetricId) => {
  const key = stillFor[mid];
  if (!key) return AURA_ONDAS;
  const r = resolvePlate(key, { where: `Montage ${mid}` });
  return r.still ?? AURA_ONDAS;
};
---
<section id={id} class:list={['mt', cls]} data-shot="montage" aria-labelledby={`${id}-t`}>
  <div class="frame mt__head"><div class="mt__intro"><slot /></div></div>
  <ol class="mt__rows" role="list">
    {ids.map((mid, i) => {
      const m = METRICS[mid];
      const inner = (
        <>
          <span class="mt__fig" style={`--img:url('${still(mid)}')`}><Metric id={mid} variant="mega" label={false} /></span>
          <span class="mt__meta">
            <span class="mt__label">{m.label}</span>
            <span class="t-label mt__ctx">{m.ctx}</span>
            {m.href && <span class="lnk--mono mt__go">Ver caso <span aria-hidden="true">→</span></span>}
          </span>
        </>
      );
      return (
        <li class:list={['mt__row', i % 2 ? 'mt__row--r' : 'mt__row--l']} data-mt-row data-dir={i % 2 ? 1 : -1}>
          {m.href ? <a class="mt__link" href={m.href}>{inner}</a> : <div class="mt__link">{inner}</div>}
        </li>
      );
    })}
  </ol>
  {transversal && transversal.length > 0 && (
    <div class="frame mt__cross" data-reveal>
      <p class="t-label mt__cross-h"><span class="node" aria-hidden="true"></span>También en otros sistemas</p>
      <ul class="mt__cross-list" role="list">
        {transversal.map((t) => <li><Metric id={t} variant="inline" label /> <span class="t-micro">· {METRICS[t].ctx}</span></li>)}
      </ul>
    </div>
  )}
  <div class="frame mt__foot" data-reveal>
    <p class="t-micro mt__note"><sup class="fn">1</sup> {SOURCE_NOTE}. {anonNote}</p>
    <div class="mt__links"><slot name="foot" /></div>
  </div>
</section>
