---
// Montage · cifras como escena (§5.1 ESC 08, §6 #21, §7.4): cada cifra confirmada en --fs-mega con la placa del caso
// DENTRO de las letras (Lexend 400; capa de pantalla blanca .12 sobre una base cian → blanco: nunca glifos grises),
// encuadrada en el sujeto iluminado (x = foco de la placa, y 38 %: nunca en una cara); sin placa, relleno .lit (200).
// Filas alternadas, contexto mono, enlace al caso con data-still (corte por coincidencia, §5.1 ESC 08) y nota de fuente.
// Las cifras son texto real (<Metric>, data-metric).
// Movimiento: filas xPercent ±3 en sentidos alternos, deriva ±8 % alrededor del sujeto dentro de las letras (scrub) y
// entrada con barrido limpio (clip-path; el contenido nunca sale del árbol de accesibilidad).
// Slots: default (eyebrow + H2 con id "<id>-t") · foot (enlaces "Ver todos los casos →" …).
// R12 (sin enlaces muertos en el cuerpo): la fila enlaza al caso solo si su página está construida (linkTarget de
// src/lib/site); si no, es un <div> sin "Ver caso". Al construir el caso, la fila vuelve a enlazar sola.
// Placa con personas (caso, sector): la cifra real va sobre una imagen generada → chip "Imagen ilustrativa" en la fila
// (nunca se lee como foto del cliente).
import Metric from '../ui/Metric.astro';
import { METRICS, SOURCE_NOTE, type MetricId } from '../../lib/metrics';
import { resolvePlate, AURA_ONDAS } from './plate';
import { linkTarget } from '../../lib/site';

interface Props {
  id?: string;
  ids: MetricId[];
  transversal?: MetricId[];
  stillFor?: Partial<Record<MetricId, string>>;
  anonNote?: string;
  class?: string;
}
const { id = 'casos', ids, transversal, stillFor = {}, anonNote = 'Nombres de clientes anonimizados.', class: cls } = Astro.props;
const still = (mid: MetricId): { src: string; fx: number; real: boolean; illus: boolean } => {
  const key = stillFor[mid];
  if (!key) return { src: AURA_ONDAS, fx: 0.5, real: false, illus: false };
  const r = resolvePlate(key, { where: `Montage ${mid}` });
  // Toda placa es generada; se marca cuando muestra personas (alt "(imagen ilustrativa)" o sin Kain).
  const illus = /ilustrativa/i.test(r.alt) || !/\bKain\b/.test(r.alt);
  return r.still ? { src: r.still, fx: r.d.fx, real: true, illus } : { src: AURA_ONDAS, fx: 0.5, real: false, illus: false };
};
---
<section id={id} class:list={['mt', cls]} data-shot="montage" aria-labelledby={`${id}-t`}>
  <div class="frame mt__head"><div class="mt__intro"><slot /></div></div>
  <ol class="mt__rows" role="list">
    {ids.map((mid, i) => {
      const m = METRICS[mid];
      const st = still(mid);
      const href = m.href ? linkTarget(m.href) : null;
      const inner = (
        <>
          <span class="mt__fig" data-img={st.real ? 'still' : 'aura'} style={`--img:url('${st.src}');--fx-d:${st.fx}`}><Metric id={mid} variant="mega" label={false} /></span>
          <span class="mt__meta">
            <span class="mt__label">{m.label}</span>
            <span class="t-label mt__ctx">{m.ctx}</span>
            {st.illus && <span class="chip-illus mt__illus">Imagen ilustrativa</span>}
            {href && <span class="lnk--mono mt__go">Ver caso <span aria-hidden="true">→</span></span>}
          </span>
        </>
      );
      return (
        <li class:list={['mt__row', i % 2 ? 'mt__row--r' : 'mt__row--l']} data-mt-row data-dir={i % 2 ? 1 : -1}>
          {href ? <a class="mt__link" href={href} data-still>{inner}</a> : <div class="mt__link">{inner}</div>}
        </li>
      );
    })}
  </ol>
  {transversal && transversal.length > 0 && (
    <div class="frame mt__cross" data-reveal>
      <p class="t-label mt__cross-h"><span class="node" aria-hidden="true"></span>Más resultados</p>
      <ul class="mt__cross-list" role="list">
        {transversal.map((t) => <li><Metric id={t} variant="inline" label /> <span class="t-micro">· {METRICS[t].ctx}</span></li>)}
      </ul>
    </div>
  )}
  <div class="frame mt__foot" data-reveal>
    <p class="t-micro mt__note"><sup class="fn">1</sup> {SOURCE_NOTE}. {anonNote}</p>
    <div class="mt__links"><slot name="foot" /></div>
  </div>
</section>
