---
// ColdOpen · firma "Del nodo al pecho" (ESPEC §1.1, §7.3). Solo en /, una vez por sesión, se salta con cualquier gesto.
// Va en el slot "over" de la portada (ImageSection priority): es una capa óptica registrada al ancla "pecho" de la placa.
// html.co lo decide el <head> de BaseLayout (coldOpen); si la página no usa BaseLayout, lo decide el script en línea de aquí,
// ANTES de que se pinte la portada (no corre con movimiento reducido, saveData, referrer propio o si ya se vio en la sesión).
// Red de seguridad CSS: con html.co, a los 3.2 s la portada queda completa aunque el JS no cargue. ?replay fuerza la firma.
// Al terminar: html.co se retira, se emite "cine:coldopen-end" en document y la sección recibe "cine:intro".
interface Props { plate?: string }
---
<script is:inline>
(function(){try{var d=document.documentElement,q=location.search.indexOf('replay')>-1,ss=null;
if(d.hasAttribute('data-co-candidate'))return; /* BaseLayout ya decidió html.co en el <head> */
try{ss=sessionStorage.getItem('ingeniak-coldopen')}catch(e){}
var mm=window.matchMedia('(prefers-reduced-motion: reduce)').matches,c=navigator.connection,
same=false;try{same=!!document.referrer&&new URL(document.referrer).host===location.host}catch(e){}
if(q||(!mm&&d.dataset.motion!=='reduced'&&!(c&&(c.saveData||/2g/.test(c.effectiveType||'')))&&!ss&&!same)){
if(!mm&&d.dataset.motion!=='reduced'){d.classList.add('co');d.classList.remove('enc');
addEventListener('pagereveal',function(e){if(e.viewTransition&&!q){d.classList.remove('co');d.dataset.vt='1';}},{once:true});}}
}catch(e){}})();
</script>
