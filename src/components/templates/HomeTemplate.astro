---
// HomeTemplate · T-HOME (ESPEC §5.1, §5.1.1, §12). El inicio "Plano secuencia — el turno de noche de Kain".
// Data-driven: la estructura sale de src/data/sitemap.json (secciones, placas, CTA, mensajes de WhatsApp) y el texto
// publicable de src/content/paginas/<page.id>.json (área copy). Ninguna cifra se escribe aquí: tokens → <Metric>/data-metric.
// Ritmo de intensidad (§5): 00 firma 3 · 01 portada 3 · 02 créditos 1 · 03 gemelos 3 · 04 manifiesto 1 · 05 runtime 3 ·
// 06 Kain 2 · 07 servicios 1 · 08 montaje 2 · 09 VKTOR 2 · 10 locaciones 2 · 11 equipo 2 · 12 ficha+FAQ 1 · 13 amanecer 3.
// Una sola .lit (H1). Un solo primario azul por pantalla (portada y cierre). Toda sección con id (SceneRail, actos 3·6·4).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSection from '../cine/ImageSection.astro';
import ColdOpen from '../cine/ColdOpen.astro';
import FigCaption from '../cine/FigCaption.astro';
import LightBranch from '../cine/LightBranch.astro';
import TwinScene from '../cine/TwinScene.astro';
import Intertitle from '../cine/Intertitle.astro';
import PlateSequence from '../cine/PlateSequence.astro';
import Montage from '../cine/Montage.astro';
import LocationSwitcher from '../cine/LocationSwitcher.astro';
import Dawn from '../cine/Dawn.astro';
import { resolvePlate, anchorStyle } from '../cine/plate';
import Btn from '../ui/Btn.astro';
import HeroCtas from './HeroCtas.astro';
import Metric from '../ui/Metric.astro';
import Copy from '../ui/Copy.astro';
import SumarioCover from '../ui/SumarioCover.astro';
import PainList from '../ui/PainList.astro';
import DefinitionBlock from '../ui/DefinitionBlock.astro';
import ScriptList from '../ui/ScriptList.astro';
import ChatSim from '../ui/ChatSim.astro';
import ChatTabs from '../ui/ChatTabs.astro';
import HomeStation from './HomeStation.astro';
import Aura from './Aura.astro';
import Credits from '../ui/Credits.astro';
import EntitySheet from '../ui/EntitySheet.astro';
import FAQAccordion from '../ui/FAQAccordion.astro';
import { annotateFigures, esc, TEAM } from '../ui/ui-data';
import { heroPlateOf } from '../layout/navData';
import { section, getPlate, waHref, SITE, linkTarget, isBuilt, type Page } from '../../lib/site';
import { METRICS, type MetricId } from '../../lib/metrics';

interface Props {
  page: Page;
  copy: any;
}
const { page, copy } = Astro.props;
const P = page as any;
const S = (id: string) => copy?.sections?.[id] ?? {};
const has = (id: string) => !!section(page, id) && !S(id)._omitir;
const plateOf = (id: string) => section(page, id)?.plate ?? {};
const plateIds = (id: string): string[] => {
  const p = plateOf(id).id;
  return Array.isArray(p) ? p : p ? [p] : [];
};
const wa = (msg?: string) => (msg ? waHref(msg) : P.secondaryCta?.href ?? SITE.waBase);
const primary = P.primaryCta ?? { label: 'Agenda tu Discovery Session', href: SITE.discovery };

/** Titular de dos voces: text (Lexend 600) + soft (Lexend 300). La .lit solo se aplica donde se permite (H1). */
const voice = (t?: string, lit?: string) => {
  if (!t) return '';
  if (lit && t.includes(lit)) {
    const i = t.indexOf(lit);
    return annotateFigures(t.slice(0, i)) + `<span class="lit">${annotateFigures(lit)}</span>` + annotateFigures(t.slice(i + lit.length));
  }
  return annotateFigures(t);
};
const headline = (h: any) => (h ? voice(h.text) + (h.soft ? ` <span class="soft">${annotateFigures(h.soft)}</span>` : '') : '');
/** Eslogan en dos tiempos: "Tu negocio trabajando, <b>sin depender más de ti.</b>" */
const sloganHTML = (s?: string) => {
  if (!s) return '';
  const i = s.indexOf(', ');
  return i > 0 ? `${annotateFigures(s.slice(0, i + 1))} <b>${annotateFigures(s.slice(i + 2))}</b>` : annotateFigures(s);
};
/** Remate en dos tiempos: "No te falta esfuerzo. <b>Te falta un sistema.</b>" */
const remateHTML = (s?: string) => {
  if (!s) return '';
  const m = s.match(/^(.+?[.!?])\s+(.+)$/);
  return m ? `${annotateFigures(m[1])} <b>${annotateFigures(m[2])}</b>` : annotateFigures(s);
};

/* ── 01 · Portada ─────────────────────────────────────────────────────────── */
const hero = S('hero');
const heroPlateKey = plateIds('hero')[0] ?? 'home-hero';
const heroPlate = plateOf('hero');
const heroR = resolvePlate(heroPlateKey, { srcsetMax: heroPlate.srcsetMax ?? 2752 });
const lcpPlate = heroR.id ?? undefined; // la placa realmente pintada (null = aura, sin precarga)
const sumarioIds = (hero.sumario?.metricIds ?? []) as MetricId[];

/* ── 02 · Con qué construimos: sello Kommo + logos en dos filas parejas ─────── */
const stackLogos = (S('stack').logos ?? []).map((l: any) => ({ logo: l.slug, name: l.label }));
const logoCols = Math.max(1, Math.ceil((stackLogos.length + 1) / 2)); // +1: el sello de Kommo

/* ── 03 · Problema (planos gemelos) ───────────────────────────────────────── */
const prob = S('problema');
const [twinA, twinB] = plateIds('problema');

/* Enlaces del cuerpo (R12 · QA enlaces): solo rutas construidas; una planeada se omite (nunca '#'). */
const built = <T extends { href?: string }>(list?: T[]): T[] => (list ?? []).filter((l) => !!l?.href && isBuilt(l.href));
/** ¿Todas las cifras de una fila enlazan a una ruta construida? (MetricRow enlaza todas o ninguna) */
const allBuilt = (ids: MetricId[] = []) => ids.every((id) => !METRICS[id]?.href || isBuilt(METRICS[id].href as string));

/* ── 05 · Sistema (SystemRuntime) ─────────────────────────────────────────── */
const sis = S('sistema');
const sisPlates = plateIds('sistema');
// stage (etiqueta mono "01 · Atraer" + nodo del riel) y title (H3 "Tráfico que sí compra") van por separado (§5.1 ESC 05)
const stations = (sis.steps ?? []).map((s: any, i: number) => ({
  id: s.id,
  stage: s.stage,
  title: s.title ?? s.stage,
  line: s.line,
  plate: sisPlates[i],
  href: s.link?.href ? linkTarget(s.link.href) ?? undefined : undefined,
  hrefLabel: s.link?.label,
  metricIds: s.metricIds,
  leadCard: s.leadCard as string | undefined,
}));
/* UI registrada de cada estación (StationUI de ui): sobre la superficie de cristal vacía de su placa, dentro de su caja
   (anclas de caja de plates.json → --aw/--ah), SIMULACIÓN y data-nosnippet. Kain nunca queda debajo de un cristal: en
   pages.css cada UI se recorta a la parte de la superficie libre del sujeto. Móvil: la superficie mide < 180 px → mini demo
   bajo el copy de la estación (slot metric-<id>, que vive dentro de un <p>: solo elementos en línea; pedido a cine un
   slot demo-<id> fuera del <p> para pasar a <StationUI demo>). */
const STATION_UI: Record<string, { kind: 'ads' | 'chat' | 'kanban' | 'flow' | 'dash'; anchors: string[] }> = {
  atraer: { kind: 'ads', anchors: ['pantalla', 'superficie'] },
  atender: { kind: 'chat', anchors: ['telefono', 'pantalla'] },
  organizar: { kind: 'kanban', anchors: ['superficie', 'carriles'] },
  automatizar: { kind: 'flow', anchors: ['constelacion', 'superficie'] },
  medir: { kind: 'dash', anchors: ['pantalla', 'superficie'] },
};   // la pieza la pinta StationUI (ui); aquí solo la superficie de cada placa
const stationUi = stations.map((st: any) => {
  const def = STATION_UI[st.id];
  if (!def || !st.plate) return null;
  const r = resolvePlate(st.plate, {});
  const anchor = def.anchors.find((n) => r.anchors[n]?.box?.d);
  return anchor ? { ...def, anchor, id: st.id, lead: st.leadCard, mobile: !!r.anchors[anchor]?.box?.m } : null;
});
const KANBAN = ['Nuevo', 'Calificado', 'Cita agendada', 'Ganado'];
const SU: Record<string, any> = Object.fromEntries(stationUi.filter(Boolean).map((u: any) => [u.id, u]));

/* ── 06 · Kain (push hacia el teléfono, ChatSim registrado) ───────────────── */
const kain = S('kain');
const kainKey = plateIds('kain')[0] ?? 'home-kain';
const kainPlate = plateOf('kain');
const kainR = resolvePlate(kainKey, { layout: kainPlate.layout });
// El teléfono de cristal: ancla de caja de la placa (resolvePlate ya la trae espejada; anchorStyle da --ax/--ay/--aw/--ah).
// Si la placa no lo trae, la UI va en el texto.
const telD = kainR.anchors.telefono?.box?.d ?? null;
// Móvil (QA #7): la placa vertical también trae la caja del teléfono → el teléfono de cristal se enciende con la miniatura
// de ChatSim (§3.7: < 180 px) en vez de verse vacío; la conversación completa sigue en línea, bajo la placa (alto acotado).
const telM = kainR.anchors.telefono?.box?.m ?? null;
const phoneStyle = telD ? anchorStyle('telefono') : '';
const chatTabs = (kain.chat?.tabs ?? (kain.chat?.scripts ?? ['salud']).map((id: string) => ({ id }))) as { id: string; label?: string }[];
const chatId = 'kain-chat';

/* ── 07 · Servicios ───────────────────────────────────────────────────────── */
const serv = S('servicios');
// Filas: la planeada se pinta como texto (sin enlace ni flecha); el fotograma que sigue al cursor sigue funcionando.
const servGroups = (serv.groups ?? []).map((g: any) => ({
  label: g.label,
  glyph: g.glyph,
  rows: (g.items ?? []).map((it: any) => ({ title: it.title, line: it.line, href: it.href ? linkTarget(it.href) ?? undefined : undefined, plate: it.href ? heroPlateOf(it.href) : undefined })),
}));
// Fotograma 21:9 fijo bajo el H2 (columna izquierda, máscara a --ink): el riel de servicios por defecto; al pasar por una
// fila (puntero fino) toma la portada de esa fila. Luz propia de la escena: nunca 40vh de tinta plana (§5).
const servStill = (() => {
  const base = '/img/cine/riel-servicios-still';
  return { src: `${base}-640.webp`, srcset: `${base}-360.webp 360w, ${base}-640.webp 640w` };
})();

/* ── 08 · Casos (Montaje) ─────────────────────────────────────────────────── */
const casos = S('casos');
const casoPlates = plateIds('casos');
const casoIds = (casos.rows ?? []).map((r: any) => r.metricId) as MetricId[];
const stillFor = Object.fromEntries(casoIds.map((id, i) => [id, casoPlates[i]]).filter(([, p]) => !!p));

/* ── 09 · VKTOR ───────────────────────────────────────────────────────────── */
const vk = S('vktor');
const vkKey = plateIds('vktor')[0] ?? 'metodologia-hero';
const vkPlate = plateOf('vktor');

/* ── 10 · Industrias ──────────────────────────────────────────────────────── */
const ind = S('industrias');
const indPlates = plateIds('industrias');
// §5.1 ESC 10: chip SIMULACIÓN con 2 burbujas del guion del sector activo (copy: sectors[].bubbles)
const sectors = (ind.sectors ?? []).map((s: any, i: number) => ({
  slug: s.slug,
  name: s.name,
  line: s.line,
  metricId: s.metricId,
  href: s.href ? linkTarget(s.href) ?? undefined : undefined,
  bubbles: s.bubbles,
  plate: indPlates.find((p) => p === `ind-${s.slug}-hero`) ?? indPlates[i] ?? `ind-${s.slug}-hero`,
}));
const indLabel = (ind.hud?.[0]?.text ?? '').replace(/\s*\d+\s*\/\s*\d+\s*$/, '') || 'Locación';
// R13: 09 (VKTOR, Kain presenta sobre su escalón) y 10 son escenas seguidas → la locación arranca en un sector cuya
// placa tenga otra pose. LocationSwitcher siempre abre en la primera fila (pedido `start` a cine): ese sector sube al
// frente. Poses de las portadas de sector (lista de aceptación §9.4 · pedido `pose` en plates.json a imágenes).
const POSE: Record<string, string> = {
  'metodologia-hero': 'presenta', 'ind-salud-hero': 'presenta', 'ind-belleza-hero': 'presenta', 'ind-nutricion-hero': 'sostiene la tableta',
  'ind-finanzas-hero': 'presenta', 'ind-inmobiliario-hero': 'presenta', 'ind-industrial-hero': 'señala', 'ind-retail-hero': 'sostiene el teléfono',
  'ind-horeca-hero': 'presenta',
};
const vkPose = POSE[vkKey];
const firstOther = sectors.findIndex((s: any) => POSE[s.plate] && POSE[s.plate] !== vkPose);
if (vkPose && firstOther > 0 && POSE[sectors[0]?.plate] === vkPose) sectors.unshift(...sectors.splice(firstOther, 1));

/* ── 11 · Equipo (R6: sin placa equipo-real → TeamCredits con las fotos reales sobre un aura, sin collage) ── */
const eq = S('equipo');
const team = (eq.credits ?? []).map((c: any) => {
  const t = TEAM.find((x) => x.name === c.name);
  return t ? { ...t, role: c.role } : null;
}).filter(Boolean);

/* ── 12 · Ficha + FAQ ─────────────────────────────────────────────────────── */
const faq = S('faq');
const faqFooter = (() => {
  const t = faq.footer as string | undefined;
  if (!t) return '';
  let h = esc(t);
  h = h.replace(/Escríbele a Kain por WhatsApp/, (m) => `<a class="lnk hm-faq__wa" href="${esc(wa(S('hero').ctaSecondary?.waMessage))}" data-wa>${m}</a>`);
  h = h.replace(SITE.email, (m) => `<a class="lnk" href="mailto:${m}">${m}</a>`);
  return h;
})();

/* ── 13 · Cierre ──────────────────────────────────────────────────────────── */
const fin = S('cta-final');
const finPlate = plateOf('cta-final');

// Riel en 3 actos (I · La noche 01–03 · II · El sistema 04–09 · III · El amanecer 10–13).
const railGroups = [3, 6, 4];
---
<BaseLayout page={page} coldOpen lcpPlate={lcpPlate} lcpSrcsetMax={heroPlate.srcsetMax ?? 2752} railGroups={railGroups} bodyClass="hm">

  {/* ── 00 + 01 · Firma "Del nodo al pecho" + portada ──────────────────── */}
  <ImageSection
    id="hero"
    plate={heroPlateKey}
    layout={heroPlate.layout}
    mirror={heroPlate.mirror}
    height="hero"
    mobile="split"
    priority
    wide
    breathe
    srcsetMax={heroPlate.srcsetMax ?? 2752}
    hud={hero.hud}
    class="hm-hero tpl-hero"
  >
    <ColdOpen slot="over" plate={heroPlateKey} />
    {sumarioIds.length === 3 && <SumarioCover slot="over" ids={sumarioIds} />}
    {hero.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(hero.eyebrow)} /></p>}
    <h1 id="hero-t" data-split><span class="t-display" set:html={voice(hero.h1?.text, hero.h1?.lit)} />{hero.h1?.soft && <> <span class="t-deck" set:html={annotateFigures(hero.h1.soft)} /></>}</h1>
    <HeroCtas href={hero.ctaPrimary?.href ?? primary.href} label={hero.ctaPrimary?.label ?? primary.label}
      waHref={wa(hero.ctaSecondary?.waMessage)} waLabel={hero.ctaSecondary?.label ?? 'Escríbele a Kain'} />
    <LightBranch from="mano" />
    {hero.fig && <FigCaption slot="anchors" n={1} title={(hero.fig.label ?? 'Fig. 01 · Kain').replace(/^Fig\.\s*\d+\s*·\s*/, '')} anchor="fig" target="mano"><Copy text={hero.fig.text} /></FigCaption>}
    {/* R3: la línea de confianza y el Fig. 01 en línea (§5.1.1: el Fig. 01 se queda en la portada) van después de la placa en móvil;
        en escritorio `more` es la misma columna de texto, justo bajo los CTA */}
    {(hero.trust || hero.fig) && (
      <Fragment slot="more">
        {hero.trust && <Copy as="p" class="t-label trust" text={hero.trust} />}
        {hero.fig && <FigCaption variant="inline" n={1} title={(hero.fig.label ?? 'Fig. 01 · Kain').replace(/^Fig\.\s*\d+\s*·\s*/, '')}><Copy text={hero.fig.text} /></FigCaption>}
      </Fragment>
    )}
  </ImageSection>

  {/* ── 02 · Con qué construimos (créditos; sumario en fila en escritorios bajos y móvil) ── */}
  {has('stack') && (
    <section id="stack" class="hm-stack tpl-glow" aria-labelledby="stack-t" style={`--logo-cols:${logoCols}`}>
      <Aura kind="ondas" x="50%" y="45%" o={1} only="m" />
      <div class="frame hm-stack__frame">
        {sumarioIds.length === 3 && <SumarioCover ids={sumarioIds} variant="row" class="hm-stack__sumario" />}
        <div class="hm-stack__head">
          <h2 id="stack-t" class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{S('stack').eyebrow ?? 'Con qué construimos'}</h2>
          {S('stack').lede && <Copy as="p" class="hm-stack__lede" text={S('stack').lede} />}
        </div>
        <Credits
          variant="logos"
          class="hm-stack__logos"
          items={stackLogos}
        />
      </div>
    </section>
  )}

  {/* ── 03 · El problema (TwinScene, fijada +100 % en escritorio) ─────────── */}
  {has('problema') && twinA && twinB && (
    <TwinScene id="problema" class="tpl-glow-m" plateA={twinA} plateB={twinB} layout={plateOf('problema').layout} mirror={plateOf('problema').mirror} clock={prob.hudClock}>
      {prob.eyebrow && <p class="t-label eyebrow"><span class="node node--amber" aria-hidden="true"></span><Fragment set:html={annotateFigures(prob.eyebrow)} /></p>}
      <h2 id="problema-t" class="t-h2" data-split set:html={headline(prob.h2)} />
      {/* Escena fijada: todo debe caber en una pantalla (1280 × 720). El lede del copy no entra en el plano; los dolores sí. */}
      <PainList mode="twin" items={(prob.items ?? []).map((it: any) => ({ pain: it.pain, fix: it.fix }))} label="Dolores y su salida con el sistema" />
      {prob.remate && <p slot="end" class="t-deck hm-remate" set:html={remateHTML(prob.remate)} />}
    </TwinScene>
  )}

  {/* ── 04 · Qué es Ingeniak (intertítulo: manifiesto + definición citable + "en datos") ── */}
  {has('que-es') && (
    <Intertitle id="que-es" aura="isotipo" auraSide="right" ghost={S('que-es').ghost ? { text: S('que-es').ghost, mode: 'bleed', side: 'right' } : undefined} class="hm-quees tpl-glow" hud={S('que-es').hud?.[0]?.text}>
      <Aura kind="ondas" x="62%" y="94%" o={1} only="d" />
      <Aura kind="isotipo" x="72%" o={0.9} only="m" sticky />
      {S('que-es').eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(S('que-es').eyebrow)} /></p>}
      <h2 id="que-es-t" class="t-h2 hm-manifesto" data-words set:html={headline(S('que-es').h2)} />
      {S('que-es').lede && <Copy as="p" class="t-lede t-lede--2 hm-quees__lede" text={S('que-es').lede} data-reveal />}
      <div class="hm-quees__grid">
        {S('que-es').definition && (
          <DefinitionBlock faqId={S('que-es').definition.faqId} heading={S('que-es').definition.heading} headingLevel={3} class="hm-quees__def" />
        )}
        {(S('que-es').body ?? []).length > 0 && (
          <div class="hm-quees__body" data-reveal>
            {(S('que-es').body as string[]).map((b) => <Copy as="p" class="t-body" text={b} />)}
          </div>
        )}
      </div>
      {S('que-es').metricRow && (
        <Metric variant="row" ids={S('que-es').metricRow.metricIds} heading={S('que-es').metricRow.title} note={S('que-es').metricRow.sourceNote !== false} link={allBuilt(S('que-es').metricRow.metricIds)} class="hm-quees__row" />
      )}
    </Intertitle>
  )}

  {/* ── 05 · El sistema (SystemRuntime, fijada +280 % en escritorio) ──────── */}
  {has('sistema') && stations.length > 0 && (
    <PlateSequence
      id="sistema"
      preset="runtime"
      steps={stations}
      figLabel={sis.fig ? `${sis.fig.label} — ${String(sis.fig.text ?? '').replace(/\.$/, '')}` : undefined}
      note={sis.note}
      class="hm-sistema tpl-glow"
    >
      {/* Sin escena fijada (móvil, movimiento reducido) el titular va solo antes de las estaciones: luz propia bajo él */}
      <span class="hm-seq-glow" aria-hidden="true"></span>
      {sis.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(sis.eyebrow)} /></p>}
      <h2 id="sistema-t" class="t-h2" data-split set:html={headline(sis.h2)} />
      {SU.atraer && <HomeStation slot="ui-atraer" u={SU.atraer} />}
      {SU.atender && <HomeStation slot="ui-atender" u={SU.atender} />}
      {SU.organizar && <HomeStation slot="ui-organizar" u={SU.organizar} />}
      {SU.automatizar && <HomeStation slot="ui-automatizar" u={SU.automatizar} />}
      {SU.medir && <HomeStation slot="ui-medir" u={SU.medir} />}
      {/* Móvil: la superficie de la placa vertical mide < 180 px → mini demo bajo el copy de cada estación */}
      {SU.atraer && <HomeStation slot="metric-atraer" u={SU.atraer} mode="demo" kanban={KANBAN} />}
      {SU.atender && <HomeStation slot="metric-atender" u={SU.atender} mode="demo" kanban={KANBAN} />}
      {SU.organizar && <HomeStation slot="metric-organizar" u={SU.organizar} mode="demo" kanban={KANBAN} />}
      {SU.automatizar && <HomeStation slot="metric-automatizar" u={SU.automatizar} mode="demo" kanban={KANBAN} />}
      {SU.medir && <HomeStation slot="metric-medir" u={SU.medir} mode="demo" kanban={KANBAN} />}
    </PlateSequence>
  )}

  {/* ── 06 · Conoce a Kain (push hacia el teléfono; ChatSim registrado; móvil "split") ── */}
  {has('kain') && (
    <ImageSection
      id="kain"
      plate={kainKey}
      layout={kainPlate.layout}
      mirror={kainPlate.mirror}
      height="mid"
      mobile="split"
      srcsetMax={kainPlate.srcsetMax ?? 2752}
      push={{ anchor: telD ? 'telefono' : 'pecho', to: 1.12 }}
      hud={kain.hud}
      class="hm-kain tpl-glow-m"
    >
      <span class="tpl-introglow" aria-hidden="true"></span>
      {kain.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(kain.eyebrow)} /></p>}
      <h2 id="kain-t" class="t-h2" data-split set:html={headline(kain.h2)} />
      {kain.lede && <Copy as="p" class="t-lede t-lede--2" text={kain.lede} />}

      {/* Escritorio ≤ 100svh: viñetas en 2 columnas; pestañas de sector (ChatTabs, fuera del teléfono) con el límite de Kain
          como su nota; CTAs en una fila. Móvil (split): todo esto va después de la placa, con el chat en línea arriba. */}
      <Fragment slot="more">
        {(kain.items ?? []).length > 0 && (
          <ul class="hm-kain__list" role="list" data-reveal="stagger">
            {(kain.items as string[]).map((it) => <li><span class="hm-kain__bar" aria-hidden="true"></span><Copy text={it} /></li>)}
          </ul>
        )}
        {chatTabs.length > 1 && (
          <div class="hm-kain__sim" data-reveal>
            <ChatTabs for={telD ? `${chatId} ${chatId}-m` : `${chatId}-m`} tabs={chatTabs} class="hm-kain__tabs" />
            {kain.limite && <Copy as="p" class="t-micro hm-kain__limit" text={kain.limite} />}
          </div>
        )}
        <div class:list={['hm-kain__inline', telD && 'only-m']}>
          <ChatSim mode="inline" tabs={chatTabs} tabsOutside={chatTabs.length > 1} id={`${chatId}-m`} note={false} />
        </div>
        {chatTabs.length <= 1 && kain.limite && <Copy as="p" class="t-micro hm-kain__limit" text={kain.limite} />}
        {kain.slogan && <p class="t-deck hm-kain__slogan" set:html={sloganHTML(kain.slogan)} />}
        <div class="ctas hm-kain__ctas">
          <Btn variant="ghost" href={wa(kain.ctaSecondary?.waMessage)} label={kain.ctaSecondary?.label ?? 'Escríbele a Kain'} />
          {built(kain.links).map((l: any) => l.external
            ? <a class="lnk" href={l.href} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>
            : <a class="lnk" href={l.href} set:html={`${esc(l.label).replace(/\bKain\b/, '<span class="kain-mark">kain</span>')} <span aria-hidden="true">→</span>`} />)}
        </div>
      </Fragment>

      {telD && (
        <div slot="anchors" class="anchor anchor--panel hm-phone" data-anchor="telefono" data-m={telM ? undefined : 'none'} data-lock style={phoneStyle}>
          <ChatSim mode="registered" tabs={chatTabs} tabsOutside={chatTabs.length > 1} id={chatId} note={false} />
        </div>
      )}
    </ImageSection>
  )}

  {/* ── 07 · Servicios (filas de guion por 5 etapas, fotograma que sigue al cursor) ── */}
  {has('servicios') && (
    <Intertitle id="servicios" aura="ondas" auraSide="center" layout="split" class="hm-serv tpl-glow">
      <Fragment slot="head">
        <div class="hm-serv__head">
          {serv.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(serv.eyebrow)} /></p>}
          <h2 id="servicios-t" class="t-h2" data-split set:html={headline(serv.h2)} />
          {/* Fotograma 21:9 a sangre de la columna (máscara a --ink, sin caja): el riel; al recorrer las filas, su portada */}
          <figure class="hm-serv__still" aria-hidden="true" data-serv-still>
            <img src={servStill.src} srcset={servStill.srcset} sizes="(min-width: 1280px) 30vw, 90vw" alt="" width="640" height="274" loading="lazy" decoding="async" />
          </figure>
          {serv.closing && <Copy as="p" class="t-lede t-lede--2 hm-serv__closing" text={serv.closing} data-reveal />}
          {built(serv.links).length > 0 && (
            <p class="hm-links" data-reveal>{built(serv.links).map((l: any) => <a class="lnk" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</p>
          )}
        </div>
      </Fragment>
      <Aura kind="isotipo" x="8%" y="2%" o={0.9} only="d" clip />
      <Aura kind="ondas" x="60%" o={1} only="m" sticky />
      <ScriptList groups={servGroups} followStill label="Servicios de Ingeniak" />
    </Intertitle>
  )}

  {/* ── 08 · Casos (Montaje: cifras con la portada del caso dentro de las letras) ── */}
  {has('casos') && casoIds.length > 0 && (
    <Montage id="casos" ids={casoIds} transversal={casos.transversal} stillFor={stillFor} anonNote={casos.note} class="hm-casos tpl-glow">
      <Aura kind="ondas" x="55%" y="10%" o={1} clip />
      {casos.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(casos.eyebrow)} /></p>}
      <h2 id="casos-t" class="t-h2" data-split set:html={headline(casos.h2)} />
      {casos.lede && <Copy as="p" class="t-lede t-lede--2 hm-casos__lede" text={casos.lede} data-reveal />}
      <Fragment slot="foot">{built(casos.links).map((l: any) => <a class="lnk" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</Fragment>
    </Montage>
  )}

  {/* ── 09 · Metodología VKTOR™ (recorte + palabra gigante + escalones anclados) ── */}
  {has('vktor') && (
    <ImageSection
      id="vktor"
      plate={vkKey}
      layout={vkPlate.layout}
      mirror={vkPlate.mirror}
      height="mid"
      align="start"
      cutout
      ghost={vk.ghost ? { text: vk.ghost, mode: 'outline-fill' } : undefined}
      srcsetMax={vkPlate.srcsetMax ?? 1920}
      alt=""
      hud={vk.hud}
      class="hm-vktor tpl-glow-m"
    >
      <span class="tpl-introglow" aria-hidden="true"></span>
      {vk.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(vk.eyebrow)} /></p>}
      <h2 id="vktor-t" class="t-h2" data-split set:html={headline(vk.h2)} />
      {vk.lede && <Copy as="p" class="t-lede t-lede--2" text={vk.lede} />}
      {/* Móvil: las cinco fases en el texto (en la placa vertical solo caben las letras sobre los escalones). */}
      {(vk.phases ?? []).length > 0 && (
        <ol class="hm-vktor__phases only-m" role="list" aria-label="Las cinco fases de VKTOR™">
          {(vk.phases as any[]).map((ph) => (
            <li><b class="hm-vktor__l" aria-hidden="true">{ph.letter}</b><span class="hm-vktor__v"><span class="sr-only">{ph.name}: </span>{ph.verb}</span></li>
          ))}
        </ol>
      )}
      {built(vk.links).length > 0 && (
        <p class="hm-links hm-vktor__go">{built(vk.links).map((l: any) => <a class="lnk" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</p>
      )}
      <Fragment slot="anchors">
        {(vk.phases ?? []).length > 0 && (
          <ol class="hm-steps" role="list" aria-label="Las cinco fases de VKTOR™">
            {(vk.phases as any[]).map((ph, i) => (
              <li class:list={['anchor hm-step', i === 4 && 'hm-step--r']} data-anchor={`escalon-${i + 1}`} data-lock style={anchorStyle(`escalon-${i + 1}`, `--i:${i}`)}>
                <span class="hm-step__k"><b aria-hidden="true">{ph.letter}</b><span class="hm-step__t"><span class="sr-only">{ph.name}: </span>{ph.verb}</span></span>
                <span class="hm-step__stem" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
        )}
      </Fragment>
    </ImageSection>
  )}

  {/* ── 10 · Industrias (locaciones: la portada del sector activo a sangre) ── */}
  {has('industrias') && sectors.length > 0 && (
    <LocationSwitcher id="industrias" sectors={sectors} label={indLabel.toUpperCase()} class="hm-ind">
      <Aura kind="isotipo" x="70%" o={0.9} only="m" sticky />
      {ind.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(ind.eyebrow)} /></p>}
      <h2 id="industrias-t" class="t-h2" data-split set:html={headline(ind.h2)} />
      {ind.lede && <Copy as="p" class="t-lede t-lede--2 hm-ind__lede" text={ind.lede} />}
      <Fragment slot="foot">
        {ind.footer && <Copy as="p" class="t-micro hm-ind__foot" text={ind.footer} />}
        {built(ind.links).map((l: any) => <a class="lnk hm-ind__all" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
      </Fragment>
    </LocationSwitcher>
  )}

  {/* ── 11 · El equipo (fotos reales en duotono sobre aura; R6: sin collage generado) ── */}
  {has('equipo') && (
    <Intertitle id="equipo" aura="isotipo" auraSide="center" class="hm-team tpl-glow">
      {/* Interino R6: la línea de reparto de Credits (ui) a lo ancho, sobre UNA aura centrada; titular arriba */}
        <div class="hm-team__head">
          {eq.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(eq.eyebrow)} /></p>}
          <h2 id="equipo-t" class="t-h2" data-split set:html={headline(eq.h2)} />
          {eq.lede && <Copy as="p" class="t-lede t-lede--2" text={eq.lede} data-reveal />}
          {built(eq.links).length > 0 && (
            <p class="hm-links" data-reveal>{built(eq.links).map((l: any) => <a class="lnk" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</p>
          )}
        </div>
      <Credits variant="team" size="lg" items={team} class="hm-team__credits" />
    </Intertitle>
  )}

  {/* ── 12 · Ficha técnica + preguntas (G01, G02, G04, G07, G08, G11) ──────── */}
  {/* Aviso QA ronda 2 (#faq a 1280 × 720): el aura propia del intertítulo subía ≈ 420 px sobre #equipo y tapaba sus
      créditos (la deriva de GSAP sumaba la traslación del CSS). Luz de ondas de plantilla, recortada a la escena. */}
  {has('faq') && (
    <Intertitle id="faq" aura="none" layout="split" class="hm-faq tpl-glow">
      <Fragment slot="head">
        <EntitySheet variant="home" title={faq.eyebrow} class="hm-faq__sheet" />
      </Fragment>
      <Aura kind="ondas" x="70%" y="52%" o={1} only="d" />
      <Aura kind="isotipo" x="-30%" y="4%" o={0.9} only="d" clip />
      <Aura kind="ondas" x="50%" o={1} only="m" sticky />
      <h2 id="faq-t" class="t-h2 hm-faq__h" data-split set:html={headline(faq.h2)} />
      <FAQAccordion ids={faq.faqIds ?? []} glass id="faq-list" />
      {faqFooter && <p class="t-small hm-faq__foot" set:html={faqFooter} data-reveal />}
    </Intertitle>
  )}

  {/* ── 13 · 06:00 · Rise (Dawn) ─────────────────────────────────────────── */}
  {has('cta-final') && (
    <Dawn id="cta-final" plate={plateIds('cta-final')[0] ?? 'cta-amanecer'} mirror={finPlate.mirror} layout={finPlate.layout} hud={fin.hud} class="tpl-glow-m">
      <span class="tpl-introglow" aria-hidden="true"></span>
      {fin.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span><Fragment set:html={annotateFigures(fin.eyebrow)} /></p>}
      <h2 id="cta-final-t" class="t-h2" data-split set:html={headline(fin.h2)} />
      {fin.lede && <Copy as="p" class="t-lede t-lede--2" text={fin.lede} />}
      <div class="ctas">
        {fin.micro ? (
          <div class="cta-p">
            <Btn variant="primary" href={fin.ctaPrimary?.href ?? primary.href} label={fin.ctaPrimary?.label ?? primary.label} />
            <Copy as="p" class="t-micro btn-micro" text={fin.micro} data-allow-number />
          </div>
        ) : (
          <Btn variant="primary" href={fin.ctaPrimary?.href ?? primary.href} micro label={fin.ctaPrimary?.label ?? primary.label} />
        )}
        <Btn variant="ghost" href={wa(fin.ctaSecondary?.waMessage)} label={fin.ctaSecondary?.label ?? 'Escríbele a Kain'} />
      </div>
    </Dawn>
  )}
</BaseLayout>

<script>
  // 07 · Servicios: el fotograma fijo bajo el H2 toma la portada de la fila que se recorre (puntero fino o foco) y vuelve al
  // riel al salir de la lista. Usa la misma fuente que el fotograma que sigue al cursor de ScriptList (data-still-src).
  const still = document.querySelector<HTMLElement>('[data-serv-still]');
  const list = document.querySelector<HTMLElement>('#servicios [data-script]');
  const img = still?.querySelector('img');
  if (still && list && img) {
    const base = { src: img.getAttribute('src') ?? '', srcset: img.getAttribute('srcset') ?? '' };
    let cur = base.src;
    const show = (src: string, srcset = '') => {
      if (!src || src === cur) return;
      cur = src;
      still.classList.add('is-swap');
      window.setTimeout(() => {
        img.srcset = srcset;
        img.src = src;
        still.classList.remove('is-swap');
      }, 160);
    };
    const pick = (e: Event) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.script__row');
      const src = row?.dataset.stillSrc;
      if (src) show(src);
    };
    list.addEventListener('pointerover', pick);
    list.addEventListener('focusin', pick);
    list.addEventListener('pointerleave', () => show(base.src, base.srcset));
  }
</script>
