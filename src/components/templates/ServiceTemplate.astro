---
// ServiceTemplate · T-SERVICE (ESPEC §5.2 y §5.2.1). Una sola plantilla para las páginas de servicio:
// recorre sitemap.json → page.sections EN SU ORDEN y pinta cada id con el componente que le asigna §5.2.1,
// con el texto de src/content/paginas/<page.id>.json (área copy). Nada de texto fijo de página aquí.
//   hero                      → SharedTake + ImageSection (hero, Kain trabajando) + UI registrada en su superficie + Breadcrumbs
//   definicion · que-es       → Intertitle (sobre la toma desenfocada si sigue a la portada) + DefinitionBlock + MetricRow
//   senales · dolores         → ImageSection mid tone="dolor" (móvil split) + lista de señales (dolor ámbar → salida cian)
//   capacidades · entregables · que-hacemos · incluye · … → ScriptList (+ ChatSim en teléfono de cristal sobre aura)
//   como-funciona             → riel-servicios a sangre con los nodos del flujo REGISTRADOS sobre los 5 nodos de la placa
//                               (si la placa no trae nodo-1…5 o no son 5 nodos: SystemFlow sobre aura)
//   vs-chatbot · comparativa  → tabla comparativa por criterio (con `rows`) · si-no · fit · antes-despues → TwoColumnScript
//   integraciones · canales   → LogoCredits por grupo · casos → Montage (1–2 filas) + ResultsLedger · industrias → Still mini
//   vktor → VktorRail · inversion → Intertitle de precio · faq → FAQAccordion · relacionados → Still ×3 · cta-final → Dawn
//   ids con placa no listados (crm-vivo, dashboard, …) → ImageSection mid (UI registrada si el copy trae `chat`)
// Reglas: un azul por pantalla (solo portada y cierre llevan primario) · una .lit (portada) · cada sección con su id.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../nav/Breadcrumbs.astro';
import ImageSection from '../cine/ImageSection.astro';
import SharedTake from '../cine/SharedTake.astro';
import Intertitle from '../cine/Intertitle.astro';
import Montage from '../cine/Montage.astro';
import Dawn from '../cine/Dawn.astro';
import LightBranch from '../cine/LightBranch.astro';
import { resolvePlate, anchorStyle, plateReady, AURA_ISOTIPO, AURA_ONDAS, type Resolved } from '../cine/plate';
import Btn from '../ui/Btn.astro';
import Copy from '../ui/Copy.astro';
import Metric from '../ui/Metric.astro';
import ScriptList from '../ui/ScriptList.astro';
import ChatSim from '../ui/ChatSim.astro';
import PainList from '../ui/PainList.astro';
import TwoColumnScript from '../ui/TwoColumnScript.astro';
import VktorRail from '../ui/VktorRail.astro';
import SystemFlow from '../ui/SystemFlow.astro';
import DefinitionBlock from '../ui/DefinitionBlock.astro';
import FAQAccordion from '../ui/FAQAccordion.astro';
import ResultsLedger from '../ui/ResultsLedger.astro';
import FigCaption from '../cine/FigCaption.astro';
import Still from '../ui/Still.astro';
import KommoBadge from '../ui/KommoBadge.astro';
import Icon from '../ui/Icon.astro';
import { annotateFigures, esc, logoUrl, logoWide, TOOLS, VKTOR } from '../ui/ui-data';
import HeroCtas from './HeroCtas.astro';
import Aura from './Aura.astro';
import { ledeParts, eyebrowRepeatsCrumbs, builtCrumbs, builtRelated } from './heroKit';
import { getPlate, pages, waHref, SITE, linkTarget, isBuilt, plateAlt, type Page } from '../../lib/site';
import { METRICS, type MetricId } from '../../lib/metrics';

interface Props { page: Page; copy: any }
const { page, copy } = Astro.props;
const P = page as any;
const C: Record<string, any> = copy?.sections ?? {};

/* ── Secciones en el orden del sitemap (sin condicionales ni las que el copy omite) ── */
const list = ((P.sections ?? []) as any[]).filter((s) => s?.id && C[s.id] && !C[s.id]._omitir && s.status !== 'conditional');

const DEF = ['definicion', 'que-es'];
const PAIN = ['senales', 'dolores'];
const SCRIPT = ['capacidades', 'entregables', 'que-hacemos', 'incluye', 'construimos', 'implementamos', 'que-automatizamos', 'casos-uso', 'contenido', 'licencias'];
const TWO = ['vs-chatbot', 'comparativa', 'selector', 'fit', 'si-no', 'antes-despues'];
const SCENE = ['crm-vivo', 'agente-chat', 'calendario', 'este-sitio', 'dashboard', 'como-medimos', 'kain-ejemplo', 'vktor-cine'];
type Kind = 'hero' | 'def' | 'pain' | 'script' | 'flow' | 'compare' | 'two' | 'logos' | 'cases' | 'ind' | 'vktor' | 'price' | 'faq' | 'related' | 'dawn' | 'scene' | 'generic';
function kindOf(s: any): Kind {
  const id: string = s.id; const c = C[id] ?? {};
  if (id === 'hero') return 'hero';
  if (id === 'cta-final') return 'dawn';
  if (DEF.includes(id)) return 'def';
  if (PAIN.includes(id)) return 'pain';
  if (id === 'como-funciona') return 'flow';
  if (TWO.includes(id)) return c.rows?.length ? 'compare' : 'two';
  if (SCRIPT.includes(id)) return 'script';
  if (id === 'integraciones' || id === 'canales') return 'logos';
  if ((id === 'casos' || id === 'caso') && !s.plate) return 'cases';
  if (id === 'industrias') return 'ind';
  if (id === 'vktor') return 'vktor';
  if (id === 'inversion') return 'price';
  if (id === 'faq') return 'faq';
  if (id === 'relacionados') return 'related';
  if (s.plate && (SCENE.includes(id) || id === 'caso')) return 'scene';
  if (s.plate) return 'scene';
  return 'generic';
}

/* Bloques: la portada y la definición que la sigue comparten toma (SharedTake, §3.12) */
type Block = { kind: Kind; s: any; c: any; next?: { s: any; c: any } };
const blocks: Block[] = [];
for (let i = 0; i < list.length; i++) {
  const s = list[i];
  const kind = kindOf(s);
  if (kind === 'hero' && list[i + 1] && kindOf(list[i + 1]) === 'def') {
    blocks.push({ kind, s, c: C[s.id], next: { s: list[i + 1], c: C[list[i + 1].id] } });
    i++;
  } else blocks.push({ kind, s, c: C[s.id] });
}

/* ── Utilidades de texto ── */
const lastWord = (t = '') => (t.trim().split(/\s+/).pop() ?? '').replace(/[.,:;!?¿¡]+$/, '');
/** Espacio duro después de palabras de 1–2 letras (a, la, de, en, un, tu…): ninguna línea del titular termina en ellas.
 *  Se aplica al texto ya escapado y antes del SplitText (que respeta el espacio duro dentro de su línea). */
const NBSP_RX = /(?<=^|[\s\u00a0(¿¡])(a|al|de|el|en|la|lo|un|tu|su|mi|y|o|e|u|es|se|te|no|ni)\s+/gi;
/** Recorre el HTML ya escapado y solo toca el texto fuera de los nodos que guardan cifras o importes exactos
 *  ([data-allow-number], [data-metric]: precio, cifras de metrics.ts), que check-cifras compara literalmente. */
const keepShort = (html: string) => {
  let depth = 0;                              // profundidad dentro de un nodo protegido
  return html.replace(/(<[^>]+>)|([^<]+)/g, (_m: string, tag?: string, txt?: string) => {
    if (tag) {
      if (depth > 0) { if (/^<\//.test(tag)) depth--; else if (!/\/>$/.test(tag)) depth++; return tag; }
      if (/\sdata-(allow-number|metric)\b/.test(tag) && !/\/>$/.test(tag)) depth = 1;
      return tag;
    }
    return depth > 0 ? txt! : txt!.replace(NBSP_RX, (_x: string, w: string) => `${w}\u00a0`);
  });
};
/** Titular de dos voces {text, soft, lit?} → HTML (tokens resueltos; la .lit solo en la portada). */
function head(h: any, lit = false): string {
  if (!h) return '';
  return keepShort(headRaw(h, lit));
}
function headRaw(h: any, lit = false): string {
  if (!h) return '';
  let t = annotateFigures(h.text ?? '');
  if (lit) {
    const word = h.lit ?? lastWord(h.text);
    const w = esc(word);
    const at = word ? t.lastIndexOf(w) : -1;
    if (at >= 0) t = `${t.slice(0, at)}<span class="lit">${w}</span>${t.slice(at + w.length)}`;
  }
  return t + (h.soft ? ` <span class="soft">${annotateFigures(h.soft)}</span>` : '');
}
const toneOf = (t?: string) => (t === 'ambar' || t === 'amber' ? 'amber' : t === 'muted' ? 'muted' : 'cyan') as 'cyan' | 'amber' | 'muted';
const wa = (c: any) => (c?.ctaSecondary?.waMessage ? waHref(c.ctaSecondary.waMessage) : P.secondaryCta?.href ?? waHref('Hola Kain'));
const ext = (href = '') => /^https?:\/\//.test(href);
/** Enlaces del cuerpo (R12 · QA enlaces): solo rutas construidas; una planeada se omite o se pinta como texto (nunca '#'). */
const built = (list?: any[]) => (list ?? []).filter((l) => l?.href && isBuilt(l.href));
const hrefOr = (h?: string) => (h ? linkTarget(h) ?? undefined : undefined);

/* ── Placas de la página (para no repetir encuadre en los fotogramas) ── */
const plateOf = (s: any) => (s?.plate?.id ? s.plate : null);
const used = new Set<string>();
for (const s of list) { const p = plateOf(s); if (p) { const r = resolvePlate(p.id, { fallbackPlate: p.launchFallback, mirror: p.mirror }); if (r.id) used.add(r.id); } }

/* Fotograma de una página destino: su portada si ya existe y no se repite aquí; si no, un suplente con el mismo tema. */
const STAND_IN: Record<string, string> = {
  'kain-hero': 'home-kain', 'kommo-hero': 'home-sistema-3-organizar', 'gohighlevel-hero': 'home-sistema-3-organizar',
  'crm-ia-hero': 'home-sistema-3-organizar', 'n8n-hero': 'home-sistema-4-automatizar', 'software-hero': 'home-sistema-5-medir',
  'paid-media-hero': 'home-sistema-1-atraer', 'paginas-web-hero': 'home-sistema-1-atraer', 'seo-hero': 'home-sistema-1-atraer',
  'consultoria-hero': 'home-sistema-5-medir', 'metodologia-hero': 'metodologia-hero',
};
const NEUTRAL = ['home-problema-b', 'home-sistema-5-medir', 'home-kain', 'home-hero'];
const stillsTaken = new Set<string>();
function stillFor(href: string): string | undefined {
  const url = href.split('#')[0];
  const target = (pages as any[]).find((p) => p.url === url);
  const tried: string[] = [];
  for (const s of (target?.sections ?? []) as any[]) if (s.plate?.id) { tried.push(s.plate.id); if (s.plate.launchFallback) tried.push(typeof s.plate.launchFallback === 'string' ? s.plate.launchFallback : s.plate.launchFallback.plate); }
  const heroId = target?.sections?.find((s: any) => s.plate)?.plate?.id;
  if (heroId && STAND_IN[heroId]) tried.splice(1, 0, STAND_IN[heroId]);
  tried.push(...NEUTRAL);
  const pick = tried.find((id) => id && plateReady(id) && !used.has(id) && !stillsTaken.has(id) && id !== 'cta-amanecer');
  if (pick) stillsTaken.add(pick);
  return pick;
}

/* Panel registrado (superficie de cristal con ancho y alto: telefono, pantalla, tableta) en fracciones de la placa */
function panel(r: Resolved, names = ['telefono', 'pantalla', 'tableta', 'superficie']): { name: string; style: string; m: boolean } | null {
  if (!r.id) return null;
  const a = getPlate(r.id)?.anchors ?? {};
  const name = names.find((n) => Array.isArray(a[n]?.d) && a[n].d.length >= 4);
  if (!name) return null;
  const [x, y, w, h] = a[name].d as number[];
  let style = `--ax:${r.mirror ? 1 - x - w : x};--ay:${y};--aw:${w};--ah:${h};`;
  const m = a[name].m as number[] | null;
  if (Array.isArray(m) && m.length >= 4) style += `--ax-m:${r.mirror ? 1 - m[0] - m[2] : m[0]};--ay-m:${m[1]};--aw-m:${m[2]};--ah-m:${m[3]};`;
  return { name, style, m: Array.isArray(m) };
}

/* ── Portada ── */
const heroS = list.find((s) => s.id === 'hero');
const hp = plateOf(heroS) ?? { id: 'home-sistema-2-atender' };
const hr = resolvePlate(hp.id, { fallbackPlate: hp.launchFallback, mirror: hp.mirror, layout: hp.layout === 'sin sujeto' ? undefined : hp.layout });
const heroPanel = panel(hr);
const heroUi = C.hero?.ui;
const heroLines = heroUi?.bubbles?.length
  ? heroUi.bubbles.map((b: any, i: number, all: any[]) => ({
      who: b.who, text: b.text, time: b.time,
      delay: b.who === 'kain' ? 600 : i === 0 ? 500 : 900,
      event: i === all.length - 1 && heroUi.status ? heroUi.status : undefined,
    }))
  : null;
// R3 · intro móvil: lede ≤ 20 palabras (la oración con la cifra baja a `more`); etiqueta solo si no repite los crumbs
const heroLede = ledeParts(C.hero?.lede, 20);
const heroBubbles: any[] = (heroUi?.bubbles ?? []).slice(0, 2);
const heroEyebrowDup = eyebrowRepeatsCrumbs(C.hero?.eyebrow, P.breadcrumbs);

/* ── Señales: pie de foto "Fig. 02" en el piso de la placa, unido al teléfono de la persona (§3.8) ── */
const painS = list.find((s) => PAIN.includes(s.id));
const painFig: string | null = painS ? (C[painS.id]?.fig?.label ?? 'Lo que pasa a las 11:48\u00a0p.\u00a0m.') : null;
const painFigTarget = (id?: string) => {
  const r = id ? resolvePlate(id, {}) : null;
  return ['telefono', 'mano', 'rostro'].find((n) => r?.anchors[n]?.d) ?? 'mano';
};

/* ── 06 · Comparativa con placa propia (QA #16/#18/#19): ya no es la portada empujada (recortaba a Kain y en la placa
   vertical repetía el mismo encuadre). Es la estación Organizar del inicio: Kain, de cuerpo completo, sostiene la tarjeta
   del lead frente a los carriles del embudo (R13: pose y objeto distintos a la portada). La tarjeta de lead (SIMULACIÓN)
   se registra en la parte LIBRE de la superficie (nunca sobre Kain) y la tabla nace en la disolución inferior de la misma
   placa. Placa: la de sitemap.json si la sección la trae (pedido a orquestador); si no, CMP_PLATE si no se usa ya. ── */
const CMP_PLATE = 'home-sistema-3-organizar';
const cmpS = list.find((s) => TWO.includes(s.id) && C[s.id]?.rows?.length);
const cmpPlate: any = cmpS ? (plateOf(cmpS) ?? (plateReady(CMP_PLATE) && !used.has(CMP_PLATE) ? { id: CMP_PLATE } : null)) : null;
const cmpSceneId: string | null = cmpPlate ? cmpS.id : null;
if (cmpPlate) used.add(cmpPlate.id);
const LEAD_STAGES = ['Nuevo', 'Calificado', 'Cita agendada'];

/* ── 09 · VKTOR™ a sangre (QA #23: la segunda mitad de la página no tenía ninguna escena con placa): Kain de pie sobre la
   última de cinco losas de cristal (pose distinta a la comparativa y al cierre, R13); cada losa lleva registrada la letra
   de su fase y el riel completo nace en la disolución inferior. Placa: la de sitemap.json o VK_PLATE. ── */
const VK_PLATE = 'metodologia-hero';
const vkS = list.find((s) => s.id === 'vktor');
const vkPlate: any = vkS ? (plateOf(vkS) ?? (plateReady(VK_PLATE) && !used.has(VK_PLATE) ? { id: VK_PLATE } : null)) : null;
if (vkPlate) used.add(vkPlate.id);

/** Letra de cada fase en la cara de su losa (anclas escalon-1…5, escritorio y vertical). En la losa donde está parado Kain
 *  se corre a la parte libre, hacia afuera del sujeto (nunca sobre sus pies). */
function slabSteps(vr: Resolved) {
  const dir = vr.mirror ? -1 : 1;
  const clear = (p: [number, number] | null, sub: number[] | null): [number, number] | null => {
    if (!p || !sub || !(p[0] > sub[0] && p[0] < sub[2])) return p;
    return [dir > 0 ? Math.min(sub[2] - 0.055, p[0] + 0.07) : Math.max(sub[0] + 0.055, p[0] - 0.07), p[1]];
  };
  return VKTOR.map((f, i) => {
    const a = `escalon-${i + 1}`;
    const d = clear(vr.anchors[a]?.d ?? null, vr.subject.d), m = clear(vr.anchors[a]?.m ?? null, vr.subject.m);
    return { ...f, a, style: d ? `--ax:${+d[0].toFixed(4)};--ay:${d[1]};` + (m ? `--ax-m:${+m[0].toFixed(4)};--ay-m:${m[1]};` : '') + `--i:${i};` : '' };
  }).filter((f) => f.style);
}

/** Parte libre de una superficie de cristal ([x, y, w, h] de la placa): se recorta al lado del sujeto con 2 % de aire, así
 *  la UI registrada nunca queda sobre Kain (§0.1-5); `pad` la separa de los bordes superior e inferior de la superficie. */
function freeBox(r: Resolved, names: string[], pad = 0.08): { name: string; style: string } | null {
  if (!r.id) return null;
  const raw: any = getPlate(r.id);
  const name = names.find((n) => Array.isArray(raw?.anchors?.[n]?.d) && raw.anchors[n].d.length >= 4);
  if (!name) return null;
  let [x, y, w, h] = raw.anchors[name].d as number[];
  const sd = raw.subject?.d as number[] | undefined;
  if (sd) {
    if (sd[0] >= x + w * 0.5) w = Math.min(w, sd[0] - 0.02 - x);
    else if (sd[2] <= x + w * 0.5) { const nx = Math.max(x, sd[2] + 0.02); w = x + w - nx; x = nx; }
  }
  y += h * pad; h *= 1 - pad * 2;
  const X = r.mirror ? 1 - x - w : x;
  const f = (n: number) => +n.toFixed(4);
  return { name, style: `--ax:${f(X)};--ay:${f(y)};--aw:${f(w)};--ah:${f(h)};` };
}

/* ── Cómo funciona: ¿la placa trae los nodos registrables? ── */
function flowPlate(s: any) {
  const p = plateOf(s);
  if (!p) return null;
  const r = resolvePlate(p.id, { fallbackPlate: p.launchFallback, mirror: p.mirror });
  return { p, r };
}

/* Casos: 1–2 filas de Montage (ESPEC §5.2 #07), registro con todas las cifras del copy y la portada de cada caso */
function casesData(c: any) {
  // Una fila por caso: dos cifras del mismo caso (mismo href) no ocupan las dos filas del montaje (§5.2 #07: dental + retail)
  const seen = new Set<string>();
  const rowIds = ((c.rows ?? []).map((r: any) => r.metricId) as MetricId[]).filter((id) => {
    if (!METRICS[id]) return false;
    const k = (METRICS[id] as any).href ?? id;
    if (seen.has(k)) return false;
    seen.add(k);
    return true;
  }).slice(0, 2);
  // Registro filtrado (§5.2 #07): solo las cifras que el montaje no muestra ya
  const ledgerIds = ((c.ledger?.metricIds ?? (c.rows ?? []).map((r: any) => r.metricId)) as MetricId[]).filter((id) => METRICS[id] && !rowIds.includes(id));
  const stillMap: Record<string, string> = {};
  for (const id of rowIds) {
    const href = METRICS[id]?.href;
    const tp = href ? (pages as any[]).find((x) => x.url === href) : null;
    const pid = tp?.sections?.find((x: any) => x.plate)?.plate?.id;
    if (pid && plateReady(pid)) stillMap[id] = pid;
  }
  return { rowIds, ledgerIds, stillMap };
}
/* Destello que recorre el riel del nodo 1 al último (escritorio en X, vertical en Y) */
const beadStyle = (n: number) =>
  `--b0x:var(--A-nodo-1-x);--b0y:var(--A-nodo-1-y);--b1x:var(--A-nodo-${n}-x);--b1y:var(--A-nodo-${n}-y);` +
  `--b0xm:var(--A-nodo-1-xm);--b0ym:var(--A-nodo-1-ym);--b1xm:var(--A-nodo-${n}-xm);--b1ym:var(--A-nodo-${n}-ym)`;
const lay = (p: any) =>(p?.layout && p.layout !== 'sin sujeto' ? p.layout : undefined);

/* Aura propia (WebP ya desenfocado, sin filter en vivo) colocada donde la sección necesita luz: detrás del teléfono de
   cristal, del titular del precio, etc. Se usa en lugar del aura de Intertitle porque su deriva (yPercent de GSAP)
   reemplaza el centrado translate(-50%) y la baja medio alto de aura (pedido a cine en peticiones.md). La deriva de
   esta aura es CSS con scroll (animation-timeline: view()); con movimiento reducido queda fija. */
function aura(kind: 'isotipo' | 'ondas', pos = ''): string {
  const src = kind === 'ondas' ? AURA_ONDAS : AURA_ISOTIPO;
  const [w, h] = kind === 'ondas' ? [960, 640] : [640, 640];
  const el = `<div class="svc-aura svc-aura--${kind}${pos ? ` svc-aura--${pos}` : ''}" aria-hidden="true">`
    + `<img src="${src}" alt="" width="${w}" height="${h}" loading="lazy" decoding="async" /></div>`;
  // Caja de recorte (la penumbra opaca del WebP no tapa la escena anterior ni la siguiente); el teléfono vive en su columna
  return pos === 'phone' ? el : `<div class="tpl-aura-box" aria-hidden="true">${el}</div>`;
}
const lcp = hr.id ?? undefined;
/* Sigue explorando: los destinos del copy que ya existen y, si faltan, páginas construidas que esta página ya enlaza */
const relS = list.find((s) => s.id === 'relacionados');
const prefer = [...((C.casos?.rows ?? []) as any[]).map((r) => r.href), ...((C.industrias?.items ?? []) as any[]).map((r) => r.href)].filter(Boolean);
const relItems: any[] = relS ? builtRelated(C.relacionados?.items, { self: P.url, want: 3, prefer }) : [];
---
<BaseLayout page={page} lcpPlate={lcp} lcpSrcsetMax={hp.srcsetMax ?? 2752} bodyClass="svc">
  {blocks.map((b) => {
    const { s, c } = b;
    const p = plateOf(s);

    /* ───────────── 01 · Portada (+ 02 definición dentro de la toma compartida) ───────────── */
    if (b.kind === 'hero') return (
      <SharedTake plate={hp.id} fallbackPlate={hp.launchFallback} mirror={hp.mirror}>
        <ImageSection
          id={s.id} plate={hp.id} fallbackPlate={hp.launchFallback} layout={lay(hp)} mirror={hp.mirror}
          height="hero" priority take mobile="split" srcsetMax={hp.srcsetMax} alt={plateAlt(hr.id ?? hp.id, P.id) || undefined}
          class="svc-hero tpl-hero" data-svc="hero"
        >
          {/* R3: crumbs O etiqueta, nunca ambas en el intro móvil (los crumbs se quedan en escritorio) */}
          <Breadcrumbs page={page} items={builtCrumbs((page as any).breadcrumbs)} class="tpl-mhide" />
          {c.eyebrow && <p class:list={['t-label t-label--cyan eyebrow', heroEyebrowDup && 'tpl-dhide']}><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h1 id={`${s.id}-t`} class="t-display-2 svc-h1" data-split set:html={head(c.h1, true)} />
          {c.lede && (
            <p class="t-lede t-lede--2 svc-hero__lede"><Copy text={heroLede.intro} />{heroLede.rest && <span class="tpl-mhide"> <Copy text={heroLede.rest} /></span>}</p>
          )}
          <HeroCtas href={c.ctaPrimary?.href ?? SITE.discovery} label={c.ctaPrimary?.label ?? 'Agenda tu Discovery Session'}
            waHref={wa(c)} waLabel={c.ctaSecondary?.label ?? 'Escríbele a Kain'} />
          {heroLines && heroPanel && <LightBranch from="mano" via=".svc-ui" />}
          {heroLines && heroPanel && (
            <div slot="anchors" class="anchor anchor--panel svc-panel svc-ui" data-anchor={heroPanel.name} data-lock style={heroPanel.style} data-nosnippet>
              <ChatSim mode="registered" scripts={{ portada: heroLines }} tabs={[{ id: 'portada', label: 'WhatsApp' }]} note={false} />
            </div>
          )}
          {/* R3/R4: en móvil la cifra del lede y las 2 burbujas del guion (versión en línea de la UI registrada) bajan
              después de la placa, dentro de la misma sección; en el teléfono de la placa queda la miniatura encendida */}
          {(heroLede.rest || heroBubbles.length > 0) && (
            <Fragment slot="more">
              {heroLede.rest && <Copy text={heroLede.rest} as="p" class="t-lede t-lede--2 svc-hero__proof tpl-dhide" />}
              {heroBubbles.length > 0 && (
                <div class="svc-bubbles tpl-dhide" role="group" aria-label="Simulación de una conversación por WhatsApp" data-nosnippet>
                  <p class="svc-bubbles__top">
                    <span class="chip-sim">SIMULACIÓN</span>
                    {heroBubbles[0]?.time && <span class="t-micro svc-bubbles__time" data-allow-number>{heroUi?.timeLabel ?? 'Hora ilustrativa'} · {heroBubbles[0].time}</span>}
                  </p>
                  {heroBubbles.map((b: any) => (
                    <p class:list={['svc-bubble', b.who === 'kain' ? 'svc-bubble--kain' : 'svc-bubble--cliente']}>
                      <span class="sr-only">{b.who === 'kain' ? 'Kain' : 'Cliente'}: </span><span set:html={annotateFigures(b.text)} />
                    </p>
                  ))}
                  {heroUi?.status && <p class="t-micro svc-bubbles__status"><span class="node" aria-hidden="true"></span>{heroUi.status}</p>}
                </div>
              )}
            </Fragment>
          )}
        </ImageSection>

        {b.next && (
          <Intertitle id={b.next.s.id} rack aura="none" labelledby={`${b.next.s.id}-def-q`} class="svc-def tpl-glow">
            <Aura kind="ondas" x="40%" y="104%" o={1} only="d" />
            <DefinitionBlock
              id={`${b.next.s.id}-def`}
              faqId={b.next.c.definition?.faqId}
              heading={b.next.c.definition?.heading ?? b.next.c.h2?.text}
              text={b.next.c.definition?.text}
              label={b.next.c.eyebrow}
            />
            {(b.next.c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body svc-def__body" data-reveal />)}
            {b.next.c.metricRow?.metricIds?.length > 0 && (
              <Metric variant="row" ids={b.next.c.metricRow.metricIds} heading={b.next.c.metricRow.title} note={b.next.c.metricRow.sourceNote !== false} class="svc-def__row" />
            )}
          </Intertitle>
        )}
      </SharedTake>
    );

    /* ───────────── Definición suelta (si no sigue a la portada) ───────────── */
    if (b.kind === 'def') return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-def-q`} class="svc-def tpl-glow">
        <DefinitionBlock id={`${s.id}-def`} faqId={c.definition?.faqId} heading={c.definition?.heading ?? c.h2?.text} text={c.definition?.text} label={c.eyebrow} />
        {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body svc-def__body" data-reveal />)}
        {c.metricRow?.metricIds?.length > 0 && <Metric variant="row" ids={c.metricRow.metricIds} heading={c.metricRow.title} note={c.metricRow.sourceNote !== false} class="svc-def__row" />}
        <Fragment set:html={aura('isotipo', 'right')} />
      </Intertitle>
    );

    /* ───────────── 03 · Señales (persona en luz ámbar) ───────────── */
    if (b.kind === 'pain') {
      const items = (c.items ?? []) as { pain: string; painLine?: string; fix: string }[];
      const withLine = items.some((it) => it.painLine);
      return (
        <ImageSection
          id={s.id} plate={p?.id ?? 'home-problema-a'} fallbackPlate={p?.launchFallback} layout={lay(p)} mirror={p?.mirror}
          height={p?.height ?? 'mid'} tone="dolor" mobile={p?.mobile ?? 'split'} srcsetMax={p?.srcsetMax ?? 1920} alt="" class="svc-pain tpl-glow-m"
        >
          <span class="tpl-introglow" aria-hidden="true"></span>
          {c.eyebrow && <p class="t-label t-label--amber eyebrow"><span class="node node--amber" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          {/* Pie de foto anclado al piso (ancla fig de la placa; en la vertical es null → no se pinta en móvil, R4) */}
          {painFig && <FigCaption slot="anchors" n={2} title={painFig} anchor="fig" target={painFigTarget(p?.id)}></FigCaption>}
          <Fragment slot="more">
            <Aura kind="ondas" x="50%" o={1} only="m" sticky />
            {withLine ? (
              <div class="pain pain--draw svc-signals" data-pain="draw">
                <ol class="pain__list" aria-label={c.eyebrow ?? 'Señales y su solución'}>
                  {items.map((it, i) => (
                    <li class="pain__item" style={`--i:${i}`} data-pain-item>
                      <p class="pain__pain"><span class="pain__node" aria-hidden="true"></span><span class="sr-only">Señal: </span><span set:html={annotateFigures(it.pain)} /></p>
                      {it.painLine && <p class="svc-signals__line" set:html={annotateFigures(it.painLine)} />}
                      <p class="pain__fix">
                        <span class="pain__branch" aria-hidden="true"><svg viewBox="0 0 28 20" preserveAspectRatio="none"><path d="M1 1v7l8 8h18" pathLength="1" /></svg></span>
                        <span class="sr-only">Con el sistema: </span><span class="pain__fix-t" set:html={annotateFigures(it.fix)} />
                      </p>
                    </li>
                  ))}
                </ol>
              </div>
            ) : <PainList items={items} mode="draw" label={c.eyebrow} />}
            {c.remate && <Copy text={c.remate} as="p" class="pain__remate" />}
          </Fragment>
        </ImageSection>
      );
    }

    /* ───────────── 04 · Capacidades (filas de guion + teléfono de cristal sobre aura) ───────────── */
    if (b.kind === 'script') {
      const rows = (c.items ?? []).map((it: any, i: number) => ({ n: it.n ?? String(i + 1).padStart(2, '0'), title: it.title, line: it.line, href: hrefOr(it.href), external: ext(it.href) }));
      const groups = c.groups?.map((g: any) => ({ label: g.label, glyph: g.glyph, rows: (g.items ?? []).map((it: any) => ({ title: it.title, line: it.line, href: hrefOr(it.href) })) }));
      const tabs = c.chat ? (c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']) : null;
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class={tabs ? 'svc-cap svc-cap--chat tpl-glow' : 'svc-cap tpl-glow'}>
          <div class="svc-cap__grid">
            <div class="svc-cap__main">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
              {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
              <ScriptList rows={groups ? [] : rows} groups={groups} label={c.eyebrow} class="svc-cap__rows" />
              {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body" data-reveal />)}
              {built(c.links).length > 0 && (
                <p class="svc-links" data-reveal>{built(c.links).map((l: any) => <a class="lnk" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}<Icon name={l.external ? 'external' : 'arrow'} size={16} /></a>)}</p>
              )}
            </div>
            {tabs && (
              <div class="svc-cap__aside">
                <Fragment set:html={aura('isotipo', 'phone')} />
                <ChatSim mode="inline" tabs={tabs} title={c.chat.title ?? "Agente de IA"} />
              </div>
            )}
          </div>
          {!tabs && <Fragment set:html={aura('isotipo', 'right')} />}
          <Aura kind="ondas" x="30%" y="100%" o={1} only="d" />
        </Intertitle>
      );
    }

    /* ───────────── 05 · Cómo funciona (nodos registrados sobre el riel de la placa) ───────────── */
    if (b.kind === 'flow') {
      const nodes = ((c.nodes ?? []) as any[]).filter((n) => n.confirmed !== false);
      const fp = flowPlate(s);
      const regs = fp?.r.id ? nodes.map((_, i) => `nodo-${i + 1}`) : [];
      const registrable = !!fp?.r.id && nodes.length > 1 && regs.every((n) => fp!.r.anchors[n]?.d) && !fp!.r.anchors[`nodo-${nodes.length + 1}`];
      if (registrable) return (
        <ImageSection
          id={s.id} plate={fp!.p.id} fallbackPlate={fp!.p.launchFallback} layout="subject-center" mirror={fp!.p.mirror}
          height="mid" align="start" mobile="top" srcsetMax={fp!.p.srcsetMax ?? 1920} alt="" class="svc-flow tpl-glow-m" data-nodes={nodes.length}
        >
          <span class="tpl-introglow tpl-introglow--d" aria-hidden="true"></span>
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          {c.note && <Copy text={c.note} as="p" class="svc-flow__note t-small" />}
          <Fragment slot="anchors">
            <span class="svc-bead" aria-hidden="true" style={beadStyle(nodes.length)}></span>
            <ol class="svc-nodes" aria-label={c.h2?.text ?? 'Cómo funciona'}>
              {nodes.map((n, i) => {
                const isKain = n.kain ?? /^kain\b/i.test(n.label ?? '');
                return (
                  <li class="anchor svc-node" data-anchor={`nodo-${i + 1}`} style={anchorStyle(`nodo-${i + 1}`, `--k:${i};--nn:${nodes.length};`)}>
                    <span class="svc-node__stem" aria-hidden="true"></span>
                    <span class="svc-node__card">
                      <span class="svc-node__top">
                        <span class="svc-node__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        {isKain && <span class="kain-mark svc-node__kain" aria-hidden="true">kain</span>}
                        {(n.logos ?? []).map((l: string) => (
                          <span class:list={['logo-mask', logoWide(l) && 'logo-mask--wide']} style={`--logo:url(${logoUrl(l)})`} role="img" aria-label={TOOLS[l]?.name ?? l}></span>
                        ))}
                      </span>
                      <span class="svc-node__t">{n.label}</span>
                      {n.line && <span class="svc-node__l" set:html={annotateFigures(n.line)} />}
                    </span>
                  </li>
                );
              })}
            </ol>
          </Fragment>
        </ImageSection>
      );
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-flow-alt tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          <SystemFlow nodes={nodes.map((n) => ({ label: n.label, line: n.line, logo: n.logos?.[0], kain: n.kain ?? /^kain\b/i.test(n.label ?? ''), confirmed: n.confirmed }))} title={c.h2?.text} />
          {c.note && <Copy text={c.note} as="p" class="t-small" />}
          <Fragment set:html={aura('isotipo', 'center')} />
        </Intertitle>
      );
    }

    /* ───────────── 06 · Agente vs. chatbot (tabla por criterio) ───────────── */
    if (b.kind === 'compare') {
      const L = c.left ?? { title: 'Antes' }; const R = c.right ?? { title: 'Después' };
      const lt = toneOf(L.tone ?? 'ambar'); const rt = toneOf(R.tone ?? 'cian');
      const table = (
          <table class="svc-cmp" data-ui-reveal>
            <caption class="sr-only">{c.h2?.text} {c.h2?.soft}</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Criterio</span></th>
                <th scope="col" class={`svc-cmp__h tone-${lt}`}><span class={`tcs__node tcs__node--${lt === 'amber' ? 'no' : lt === 'cyan' ? 'yes' : 'neutral'}`} aria-hidden="true"></span>{L.title}</th>
                <th scope="col" class={`svc-cmp__h tone-${rt}`}><span class={`tcs__node tcs__node--${rt === 'amber' ? 'no' : rt === 'cyan' ? 'yes' : 'neutral'}`} aria-hidden="true"></span>{R.title}</th>
              </tr>
            </thead>
            <tbody>
              {c.rows.map((r: any, i: number) => (
                <tr style={`--i:${i}`}>
                  <th scope="row" class="svc-cmp__k">{r.criterio ?? r.k ?? r.label}</th>
                  <td class={`svc-cmp__c tone-${lt}`}><span class="svc-cmp__mk" aria-hidden="true">{L.title}</span><span set:html={annotateFigures(r.chatbot ?? r.left ?? r.antes ?? '')} /></td>
                  <td class={`svc-cmp__c tone-${rt}`}><span class="svc-cmp__mk" aria-hidden="true">{R.title}</span><span set:html={annotateFigures(r.agente ?? r.right ?? r.despues ?? '')} /></td>
                </tr>
              ))}
            </tbody>
          </table>
      );
      const cmpLinks = built(c.links).length > 0 && (
        <p class="svc-links" data-reveal>{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>
      );
      /* Escena con placa propia (QA #16/#18/#19): Kain de cuerpo completo con la tarjeta del lead; la tarjeta de lead
         (SIMULACIÓN) va registrada en la parte libre de la superficie de cristal y la tabla nace en la disolución inferior de
         la misma placa (una sola composición, nunca dos cajas). En móvil la superficie queda detrás de Kain → la tarjeta
         baja al flujo, antes de la tabla (R4: data-m="none" + versión en línea). */
      if (s.id === cmpSceneId) {
        const rr = resolvePlate(cmpPlate.id, { fallbackPlate: cmpPlate.launchFallback, mirror: cmpPlate.mirror });
        const pan = freeBox(rr, ['superficie', 'pantalla', 'telefono', 'tableta']);
        const leadAria = 'Simulación: un lead de WhatsApp llega a la etapa Cita agendada de tu CRM';
        const leadCard = () => (
          <div class="svc-lead__card" aria-hidden="true">
            <p class="svc-lead__top"><span class="chip-sim">SIMULACIÓN</span></p>
            <p class="svc-lead__k"><span class="node" aria-hidden="true"></span>Lead nuevo · WhatsApp</p>
            <ol class="svc-lead__stages">
              {LEAD_STAGES.map((t, i) => <li class:list={['svc-lead__st', i === LEAD_STAGES.length - 1 && 'is-on']} style={`--i:${i}`}><i></i><span>{t}</span></li>)}
            </ol>
            <p class="svc-lead__evt"><span class="svc-lead__ok"></span>Cita registrada en tu CRM</p>
          </div>
        );
        return (
          <ImageSection
            id={s.id} plate={cmpPlate.id} fallbackPlate={cmpPlate.launchFallback} layout={lay(cmpPlate)} mirror={cmpPlate.mirror} height="mid" align="start"
            mobile="split" srcsetMax={cmpPlate.srcsetMax ?? 1920} alt="" class="svc-back tpl-glow-m"
          >
            <span class="tpl-introglow" aria-hidden="true"></span>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
            {pan && (
              <div slot="anchors" class="anchor anchor--panel svc-lead" data-anchor={pan.name} data-m="none" data-lock data-nosnippet style={pan.style}
                role="img" aria-label={leadAria}>{leadCard()}</div>
            )}
            <Fragment slot="more">
              {pan && <div class="svc-lead svc-lead--inline tpl-dhide" role="img" aria-label={leadAria} data-nosnippet>{leadCard()}</div>}
              <div class="svc-back__table">
                <Aura kind="ondas" x="55%" y="70%" o={1} only="d" />
                {table}
                {cmpLinks}
              </div>
            </Fragment>
          </ImageSection>
        );
      }
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-cmp-sec tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
          {table}
          {cmpLinks}
          <Fragment set:html={aura('ondas', 'cmp')} />
        </Intertitle>
      );
    }

    /* ───────────── 06b · Lo que sí / lo que no · Es para ti si · Antes y después ───────────── */
    if (b.kind === 'two') {
      const variant = s.id === 'antes-despues' ? 'before-after' : s.id === 'si-no' ? 'dodont' : 'fit';
      const side = (x: any, d: 'cyan' | 'amber') => ({ title: x?.title ?? '', items: x?.items ?? [], tone: x?.tone ? toneOf(x.tone) : d });
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-two tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
          <Aura kind="ondas" x="50%" o={1} only="m" sticky />
          <TwoColumnScript variant={variant} left={side(c.left, 'cyan')} right={side(c.right, 'amber')} slogan={c.slogan} class="svc-two__cols" />
          <Fragment set:html={aura('ondas', 'two')} />
        </Intertitle>
      );
    }

    /* ───────────── 08 · Integraciones (créditos de herramientas por grupo) ───────────── */
    if (b.kind === 'logos') {
      const groups = (c.groups ?? (c.logos ? [{ label: c.eyebrow ?? '', logos: c.logos }] : [])) as any[];
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-int tpl-glow">
            <Aura kind="ondas" x="50%" o={1} only="m" sticky />
            <div class="svc-int__head">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            </div>
            <dl class="svc-int__groups" data-ui-stagger>
              {groups.map((g, i) => (
                <div class="svc-int__g" style={`--i:${i}`}>
                  <dt class="t-label svc-int__label">{g.label}</dt>
                  <dd class="svc-int__logos">
                    {(g.logos ?? []).length ? (g.logos as any[]).map((l) => {
                      const lh = hrefOr(l.href);
                      const Tag = lh ? 'a' : 'span';
                      return (
                        <Tag class="logo-credit svc-int__logo" href={lh}>
                          <span class:list={['logo-mask', logoWide(l.slug) && 'logo-mask--wide']} style={`--logo:url(${logoUrl(l.slug)})`} aria-hidden="true"></span>
                          <span class="logo-credit__name">{l.label ?? TOOLS[l.slug]?.name ?? l.slug}</span>
                        </Tag>
                      );
                    }) : <span class="logo-credit svc-int__logo"><Icon name="calendar" size={22} /><span class="sr-only">{g.label}</span></span>}
                  </dd>
                  {g.line && <dd class="svc-int__line" set:html={annotateFigures(g.line)} />}
                </div>
              ))}
            </dl>
            {c.note && (
              <div class="svc-int__note" data-reveal>
                {(groups.some((g) => (g.logos ?? []).some((l: any) => l.slug === 'kommo')) || /kommo/i.test(c.note)) && <KommoBadge size="sm" />}
                <Copy text={c.note} as="p" class="t-small" />
              </div>
            )}
            <Fragment set:html={aura('isotipo', 'int')} />
        </Intertitle>
      );
    }

    /* ───────────── 07 · Casos (Montage de 1–2 filas + registro filtrado) ───────────── */
    if (b.kind === 'cases') {
      const { rowIds, ledgerIds, stillMap } = casesData(c);
      return (
        <>
          <Montage id={s.id} ids={rowIds} stillFor={stillMap} anonNote={c.note ?? 'Nombres de clientes anonimizados.'} class={['svc-mt', 'tpl-glow', ledgerIds.length > 0 && 'svc-mt--ledger'].filter(Boolean).join(' ')}>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
            {/* El registro filtrado vive DENTRO de #casos (pie del montaje), con su propio titular */}
            <Fragment slot="foot">
              {ledgerIds.length > 0 && (
                <div class="svc-ledger" role="group" aria-labelledby={`${s.id}-registro-h`}>
                  <Fragment set:html={aura('ondas', 'ledger')} />
                  <h3 id={`${s.id}-registro-h`} class="t-label t-label--cyan eyebrow svc-ledger__h"><span class="node" aria-hidden="true"></span>{c.ledger?.caption ?? 'Registro de resultados'}</h3>
                  <ResultsLedger ids={ledgerIds} caption={c.ledger?.caption} id={`${s.id}-registro`} />
                </div>
              )}
              {[{ href: '/casos/', label: 'Ver todos los casos' }, { href: '/casos/#registro', label: 'Registro de resultados completo' }].filter((l) => isBuilt(l.href)).map((l) => (
                <a class="lnk" href={l.href}>{l.label} <Icon name="arrow" size={16} /></a>
              ))}
            </Fragment>
          </Montage>
        </>
      );
    }

    /* ───────────── 08b · Industrias: filas de guion (R7: una sola fila de stills por página fuera de los hubs, que es
       "Sigue explorando"). Sector, una línea y "Ver industria →" solo si la industria ya existe. ───────────── */
    if (b.kind === 'ind') return (
      <section id={s.id} class="svc-sec svc-ind tpl-glow" aria-labelledby={`${s.id}-t`}>
        <Fragment set:html={aura('ondas', 'ind')} />
        <div class="frame svc-ind__frame">
          <div class="svc-sec__head svc-ind__head">
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          </div>
          <ol class="svc-ind__list" role="list" data-ui-stagger>
            {(c.items ?? []).map((it: any, i: number) => {
              const href = hrefOr(it.href);
              const inner = (
                <>
                  <span class="svc-ind__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-ind__sector t-label">{it.label}</span>
                  <h3 class="svc-ind__t">{it.title}</h3>
                  {it.line && <span class="svc-ind__l">{it.line}</span>}
                  {href && <span class="svc-ind__go lnk--mono">Ver industria <span aria-hidden="true">→</span></span>}
                </>
              );
              return (
                <li class="svc-ind__row" style={`--i:${i}`}>
                  {href ? <a class="svc-ind__link" href={href}>{inner}</a> : <div class="svc-ind__link svc-ind__link--static">{inner}</div>}
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    );

    /* ───────────── 09 · VKTOR™ aplicado al servicio ───────────── */
    if (b.kind === 'vktor') {
      const link = c.links?.[0];
      const rail = (
        <VktorRail variant="phases" lines={(c.phases ?? []).map((f: any) => f.line)} href={hrefOr(link?.href ?? '/metodologia/') ?? false} linkLabel={link?.label ?? 'Conoce el protocolo completo'} class="svc-vk__rail" />
      );
      /* A sangre (QA #23): las cinco losas de la placa son las cinco fases; cada una lleva su letra registrada (escritorio y
         vertical, R4) y el riel con el texto de cada fase nace en la disolución inferior de la misma placa. */
      if (vkPlate) {
        const vr = resolvePlate(vkPlate.id, { fallbackPlate: vkPlate.launchFallback, mirror: vkPlate.mirror });
        const steps = slabSteps(vr);
        return (
          <ImageSection
            id={s.id} plate={vkPlate.id} fallbackPlate={vkPlate.launchFallback} layout={lay(vkPlate)} mirror={vkPlate.mirror} height="mid" align="start"
            mobile="split" srcsetMax={vkPlate.srcsetMax ?? 1920} alt="" class="svc-vks tpl-glow-m"
          >
            <span class="tpl-introglow" aria-hidden="true"></span>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
            {steps.length === 5 && (
              <Fragment slot="anchors">
                {steps.map((f) => (
                  <span class="anchor svc-slab" data-anchor={f.a} style={f.style} aria-hidden="true">
                    <b class="svc-slab__l">{f.l}</b><span class="svc-slab__n">{f.name}</span>
                  </span>
                ))}
              </Fragment>
            )}
            <Fragment slot="more">{rail}</Fragment>
          </ImageSection>
        );
      }
      return (
        <section id={s.id} class="svc-sec svc-vk tpl-glow" aria-labelledby={`${s.id}-t`}>
          <div class="frame">
            <div class="svc-sec__head">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            </div>
            {rail}
          </div>
          <Fragment set:html={aura('ondas', 'vk')} />
        </section>
      );
    }

    /* ───────────── 10 · Inversión (una línea + 3 factores, sin tabla) ───────────── */
    if (b.kind === 'price') return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-price tpl-glow">
        <div class="svc-price__grid">
          <div class="svc-price__head">
            <Fragment set:html={aura('isotipo', 'price')} />
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-display-2 svc-price__h" data-split set:html={head(c.h2)} />
          </div>
          <div class="svc-price__body">
            <Aura kind="ondas" x="50%" y="110%" o={1} only="d" />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
            {c.items?.length > 0 && (
              <ol class="svc-factors" data-ui-stagger>
                {c.items.map((it: any, i: number) => (
                  <li class="svc-factor" style={`--i:${i}`}>
                    <span class="svc-factor__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="svc-factor__t" set:html={annotateFigures(it.title)} />
                    {it.line && <span class="svc-factor__l" set:html={annotateFigures(it.line)} />}
                  </li>
                ))}
              </ol>
            )}
            {c.remate && <Copy text={c.remate} as="p" class="t-deck svc-price__remate" data-reveal />}
          </div>
        </div>
      </Intertitle>
    );

    /* ───────────── 11 · Preguntas frecuentes ───────────── */
    if (b.kind === 'faq') return (
      <Intertitle id={s.id} aura="none" layout="split" labelledby={`${s.id}-t`} class="svc-faq tpl-glow">
        <Fragment slot="head">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.footer && (
            <p class="svc-faq__foot t-small" data-reveal set:html={annotateFigures(c.footer).replace(SITE.email, `<a href="mailto:${SITE.email}">${SITE.email}</a>`)} />
          )}
          <div class="svc-faq__cta" data-reveal><Btn variant="ghost" href={wa(C.hero)} label={C.hero?.ctaSecondary?.label ?? 'Escríbele a Kain'} /></div>
        </Fragment>
        <Aura kind="ondas" x="50%" o={1} only="m" sticky />
        <FAQAccordion ids={c.faqIds ?? []} glass id={`${s.id}-list`} label={c.h2?.text ?? 'Preguntas frecuentes'} />
        <Fragment set:html={aura('ondas', 'faq')} />
      </Intertitle>
    );

    /* ───────────── 12 · Sigue explorando (Still ×3, texto dentro de la penumbra) ───────────── */
    if (b.kind === 'related' && !relItems.length) return null;
    if (b.kind === 'related') return (
      <section id={s.id} class="svc-sec svc-rel tpl-glow" aria-labelledby={`${s.id}-t`}>
        <div class="frame">
          <div class="svc-sec__head">
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          </div>
          <ul class="svc-rel__grid" role="list" data-ui-stagger>
            {relItems.map((it: any, i: number) => (
              <li style={`--i:${i}`}><Still href={it.href} plate={stillFor(it.href)} label={it.label} title={it.title} line={it.line} /></li>
            ))}
          </ul>
        </div>
      </section>
    );

    /* ───────────── 13 · Cierre (Dawn) ───────────── */
    if (b.kind === 'dawn') return (
      <Dawn id={s.id} plate={p?.id ?? 'cta-amanecer'} mirror={p?.mirror} fallbackPlate={p?.launchFallback} layout={lay(p)} class="tpl-glow-m">
        {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
        <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
        {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
        <div class="ctas">
          <Btn variant="primary" href={c.ctaPrimary?.href ?? SITE.discovery} label={c.ctaPrimary?.label ?? 'Agenda tu Discovery Session'} micro />
          <Btn variant="ghost" href={wa(c.ctaSecondary ? c : C.hero)} label={c.ctaSecondary?.label ?? 'Escríbele a Kain'} />
        </div>
        {/* c.micro ("Sin costo · Sin compromiso · 30 minutos…") repetiría la microcopia del primario y el lede:
            solo se imprime si el lede no dice ya lo mismo */}
        {c.micro && !/sin compromiso/i.test(c.lede ?? '') && <p class="t-micro dawn__note" data-allow-number>{c.micro}</p>}
      </Dawn>
    );

    /* ───────────── Escena con placa (crm-vivo, dashboard, agente-chat…) ───────────── */
    if (b.kind === 'scene') {
      const r = resolvePlate(p.id, { fallbackPlate: p.launchFallback, mirror: p.mirror });
      const pan = c.chat ? panel(r) : null;
      return (
        <ImageSection
          id={s.id} plate={p.id} fallbackPlate={p.launchFallback} layout={lay(p)} mirror={p.mirror} height={p.height ?? 'mid'}
          tone={p.tone === 'dolor' ? 'dolor' : 'sol'} mobile={p.mobile ?? (c.chat ? 'split' : 'top')} srcsetMax={p.srcsetMax ?? 1920}
          push={p.push ? { anchor: p.push.anchor ?? pan?.name ?? 'pecho', camFrom: p.push.from ?? 1.35, camTo: p.push.to ?? 1.6 } : undefined}
          alt={p.id === hp.id ? '' : undefined} class="svc-scene"
        >
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          <Fragment slot="more">
            {c.items?.length > 0 && <ul class="svc-bullets">{c.items.map((t: any) => <li><span class="node" aria-hidden="true"></span><span set:html={annotateFigures(typeof t === 'string' ? t : t.title ?? '')} /></li>)}</ul>}
            {c.slogan && <Copy text={c.slogan} as="p" class="t-deck svc-slogan" />}
            {built(c.links).length > 0 && <p class="svc-links">{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>}
            {c.chat && !pan && <ChatSim mode="inline" tabs={c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']} />}
          </Fragment>
          {pan && (
            <div slot="anchors" class="anchor anchor--panel svc-panel svc-ui" data-anchor={pan.name} data-lock style={pan.style}>
              <ChatSim mode="registered" tabs={c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']} note={false} />
            </div>
          )}
        </ImageSection>
      );
    }

    /* ───────────── Sección sin componente propio (texto sobre aura) ───────────── */
    return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-gen tpl-glow">
        {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
        {c.h2 && <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />}
        {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
        {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body" data-reveal />)}
        {c.items?.length > 0 && (
          <ScriptList rows={c.items.map((it: any, i: number) => (typeof it === 'string' ? { n: String(i + 1).padStart(2, '0'), title: it } : { n: it.n, title: it.title, line: it.line, href: hrefOr(it.href) }))} />
        )}
        {built(c.links).length > 0 && <p class="svc-links">{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>}
      </Intertitle>
    );
  })}
</BaseLayout>
