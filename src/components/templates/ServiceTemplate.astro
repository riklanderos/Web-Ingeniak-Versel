---
// ServiceTemplate · T-SERVICE (ESPEC §5.2 y §5.2.1). Una sola plantilla para las páginas de servicio:
// recorre sitemap.json → page.sections EN SU ORDEN y pinta cada id con el componente que le asigna §5.2.1,
// con el texto de src/content/paginas/<page.id>.json (área copy). Nada de texto fijo de página aquí.
//   hero                      → SharedTake + ImageSection (hero, Kain trabajando) + UI registrada en su superficie + Breadcrumbs
//   definicion · que-es       → Intertitle (sobre la toma desenfocada si sigue a la portada) + DefinitionBlock + MetricRow
//   senales · dolores         → ImageSection mid tone="dolor" (móvil split) + lista de señales (dolor ámbar → salida cian)
//   capacidades · entregables · que-hacemos · incluye · … → ScriptList (+ ChatSim en teléfono de cristal sobre aura)
//   como-funciona             → riel-servicios a sangre con los nodos del flujo REGISTRADOS sobre los 5 nodos de la placa
//                               (si la placa no trae nodo-1…5 o no son 5 nodos: SystemFlow sobre aura)
//   vs-chatbot · comparativa  → tabla comparativa por criterio (con `rows`) · si-no · fit · antes-despues → TwoColumnScript
//   integraciones · canales   → LogoCredits por grupo · casos → Montage (1–2 filas) + ResultsLedger · industrias → Still mini
//   vktor · vktor-cine → VktorRail (a sangre sobre metodologia-hero) · inversion → Intertitle de precio · faq → FAQAccordion
//   relacionados → Still ×3 · cta-final → Dawn
//   ids con placa no listados (crm-vivo, dashboard, este-sitio, como-medimos, kain-ejemplo, caso con imagen…) → ImageSection
//   mid con la UI de su `ui` registrada en la parte libre de la superficie (y en línea en móvil, R4)
// UI de portada por servicio (§5.2.1, `hero.ui`): bubbles → teléfono con ChatSim · roadmap → nodos de la ruta + leyenda ·
//   pipeline → embudo · canvas → lienzo de nodos · panels → paneles de anuncio + curva · blocks → wireframe ·
//   question/answer → respuesta de un motor de IA · modules → tablero de identidad. Siempre SIMULACIÓN/VISTA DEMO y data-nosnippet.
// Reglas: un azul por pantalla (solo portada y cierre llevan primario) · una .lit (portada) · cada sección con su id.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../nav/Breadcrumbs.astro';
import ImageSection from '../cine/ImageSection.astro';
import SharedTake from '../cine/SharedTake.astro';
import Intertitle from '../cine/Intertitle.astro';
import Montage from '../cine/Montage.astro';
import Dawn from '../cine/Dawn.astro';
import LightBranch from '../cine/LightBranch.astro';
import { resolvePlate, anchorStyle, plateReady, camCap, AURA_ISOTIPO, AURA_ONDAS, type Resolved } from '../cine/plate';
import Btn from '../ui/Btn.astro';
import Copy from '../ui/Copy.astro';
import Metric from '../ui/Metric.astro';
import ScriptList from '../ui/ScriptList.astro';
import ChatSim from '../ui/ChatSim.astro';
import PainList from '../ui/PainList.astro';
import TwoColumnScript from '../ui/TwoColumnScript.astro';
import VktorRail from '../ui/VktorRail.astro';
import SystemFlow from '../ui/SystemFlow.astro';
import DefinitionBlock from '../ui/DefinitionBlock.astro';
import FAQAccordion from '../ui/FAQAccordion.astro';
import ResultsLedger from '../ui/ResultsLedger.astro';
import FigCaption from '../cine/FigCaption.astro';
import Still from '../ui/Still.astro';
import KommoBadge from '../ui/KommoBadge.astro';
import Icon from '../ui/Icon.astro';
import { annotateFigures, esc, logoUrl, logoWide, TOOLS, VKTOR, SIM } from '../ui/ui-data';
import HeroCtas from './HeroCtas.astro';
import Aura from './Aura.astro';
import { ledeParts, eyebrowRepeatsCrumbs, builtCrumbs, builtRelated } from './heroKit';
import { getPlate, pages, waHref, SITE, linkTarget, isBuilt, plateAlt, type Page } from '../../lib/site';
import { METRICS, type MetricId } from '../../lib/metrics';

interface Props { page: Page; copy: any }
const { page, copy } = Astro.props;
const P = page as any;
const C: Record<string, any> = copy?.sections ?? {};

/* ── Secciones en el orden del sitemap (sin condicionales ni las que el copy omite) ── */
const list = ((P.sections ?? []) as any[]).filter((s) => s?.id && C[s.id] && !C[s.id]._omitir && s.status !== 'conditional');

const DEF = ['definicion', 'que-es'];
const PAIN = ['senales', 'dolores'];
const SCRIPT = ['capacidades', 'entregables', 'que-hacemos', 'incluye', 'construimos', 'implementamos', 'que-automatizamos', 'casos-uso', 'contenido', 'licencias'];
const TWO = ['vs-chatbot', 'comparativa', 'selector', 'fit', 'si-no', 'antes-despues'];
const SCENE = ['crm-vivo', 'agente-chat', 'calendario', 'este-sitio', 'dashboard', 'como-medimos', 'kain-ejemplo', 'vktor-cine'];
type Kind = 'hero' | 'def' | 'pain' | 'script' | 'flow' | 'compare' | 'two' | 'logos' | 'cases' | 'ind' | 'vktor' | 'price' | 'faq' | 'related' | 'dawn' | 'scene' | 'generic';
function kindOf(s: any): Kind {
  const id: string = s.id; const c = C[id] ?? {};
  if (id === 'hero') return 'hero';
  if (id === 'cta-final') return 'dawn';
  if (DEF.includes(id)) return 'def';
  if (PAIN.includes(id)) return 'pain';
  if (id === 'como-funciona') return 'flow';
  if (TWO.includes(id)) return c.rows?.length ? 'compare' : 'two';
  if (SCRIPT.includes(id)) return 'script';
  if (id === 'integraciones' || id === 'canales') return 'logos';
  if ((id === 'casos' || id === 'caso') && !s.plate) return 'cases';
  if (id === 'industrias') return 'ind';
  if (id === 'vktor' || id === 'vktor-cine') return 'vktor';
  if (id === 'inversion') return 'price';
  if (id === 'faq') return 'faq';
  if (id === 'relacionados') return 'related';
  if (s.plate && (SCENE.includes(id) || id === 'caso')) return 'scene';
  if (s.plate) return 'scene';
  return 'generic';
}

/* Bloques: la portada y la definición que la sigue comparten toma (SharedTake, §3.12) */
type Block = { kind: Kind; s: any; c: any; next?: { s: any; c: any } };
const blocks: Block[] = [];
for (let i = 0; i < list.length; i++) {
  const s = list[i];
  const kind = kindOf(s);
  if (kind === 'hero' && list[i + 1] && kindOf(list[i + 1]) === 'def') {
    blocks.push({ kind, s, c: C[s.id], next: { s: list[i + 1], c: C[list[i + 1].id] } });
    i++;
  } else blocks.push({ kind, s, c: C[s.id] });
}

/* ── Utilidades de texto ── */
const lastWord = (t = '') => (t.trim().split(/\s+/).pop() ?? '').replace(/[.,:;!?¿¡]+$/, '');
/** Espacio duro después de palabras de 1–2 letras (a, la, de, en, un, tu…): ninguna línea del titular termina en ellas.
 *  Se aplica al texto ya escapado y antes del SplitText (que respeta el espacio duro dentro de su línea). */
const NBSP_RX = /(?<=^|[\s\u00a0(¿¡])(a|al|de|el|en|la|lo|un|tu|su|mi|y|o|e|u|es|se|te|no|ni)\s+/gi;
/** Recorre el HTML ya escapado y solo toca el texto fuera de los nodos que guardan cifras o importes exactos
 *  ([data-allow-number], [data-metric]: precio, cifras de metrics.ts), que check-cifras compara literalmente. */
const keepShort = (html: string) => {
  let depth = 0;                              // profundidad dentro de un nodo protegido
  return html.replace(/(<[^>]+>)|([^<]+)/g, (_m: string, tag?: string, txt?: string) => {
    if (tag) {
      if (depth > 0) { if (/^<\//.test(tag)) depth--; else if (!/\/>$/.test(tag)) depth++; return tag; }
      if (/\sdata-(allow-number|metric)\b/.test(tag) && !/\/>$/.test(tag)) depth = 1;
      return tag;
    }
    return depth > 0 ? txt! : txt!.replace(NBSP_RX, (_x: string, w: string) => `${w}\u00a0`);
  });
};
/** Titular de dos voces {text, soft, lit?} → HTML (tokens resueltos; la .lit solo en la portada). */
function head(h: any, lit = false): string {
  if (!h) return '';
  return keepShort(headRaw(h, lit));
}
function headRaw(h: any, lit = false): string {
  if (!h) return '';
  let t = annotateFigures(h.text ?? '');
  if (lit) {
    const word = h.lit ?? lastWord(h.text);
    const w = esc(word);
    const at = word ? t.lastIndexOf(w) : -1;
    if (at >= 0) t = `${t.slice(0, at)}<span class="lit">${w}</span>${t.slice(at + w.length)}`;
  }
  return t + (h.soft ? ` <span class="soft">${annotateFigures(h.soft)}</span>` : '');
}
const toneOf = (t?: string) => (t === 'ambar' || t === 'amber' ? 'amber' : t === 'muted' ? 'muted' : 'cyan') as 'cyan' | 'amber' | 'muted';
const wa = (c: any) => (c?.ctaSecondary?.waMessage ? waHref(c.ctaSecondary.waMessage) : P.secondaryCta?.href ?? waHref('Hola Kain'));
const ext = (href = '') => /^https?:\/\//.test(href);
/** Enlaces del cuerpo (R12 · QA enlaces): solo rutas construidas; una planeada se omite o se pinta como texto (nunca '#'). */
const built = (list?: any[]) => (list ?? []).filter((l) => l?.href && isBuilt(l.href));
const hrefOr = (h?: string) => (h ? linkTarget(h) ?? undefined : undefined);

/* ── Placas de la página (para no repetir encuadre en los fotogramas) ── */
const plateOf = (s: any) => (s?.plate?.id ? s.plate : null);
const used = new Set<string>();
for (const s of list) { const p = plateOf(s); if (p) { const r = resolvePlate(p.id, { fallbackPlate: p.launchFallback, mirror: p.mirror }); if (r.id) used.add(r.id); } }

/* Fotograma de una página destino: su portada si ya existe y no se repite aquí; si no, un suplente con el mismo tema. */
const STAND_IN: Record<string, string> = {
  'kain-hero': 'home-kain', 'kommo-hero': 'home-sistema-3-organizar', 'gohighlevel-hero': 'home-sistema-3-organizar',
  'crm-ia-hero': 'home-sistema-3-organizar', 'n8n-hero': 'home-sistema-4-automatizar', 'software-hero': 'home-sistema-5-medir',
  'paid-media-hero': 'home-sistema-1-atraer', 'paginas-web-hero': 'home-sistema-1-atraer', 'seo-hero': 'home-sistema-1-atraer',
  'consultoria-hero': 'home-sistema-5-medir', 'metodologia-hero': 'metodologia-hero',
};
const NEUTRAL = ['home-problema-b', 'home-sistema-5-medir', 'home-kain', 'home-hero'];
const stillsTaken = new Set<string>();
function stillFor(href: string): string | undefined {
  const url = href.split('#')[0];
  const target = (pages as any[]).find((p) => p.url === url);
  const tried: string[] = [];
  for (const s of (target?.sections ?? []) as any[]) if (s.plate?.id) { tried.push(s.plate.id); if (s.plate.launchFallback) tried.push(typeof s.plate.launchFallback === 'string' ? s.plate.launchFallback : s.plate.launchFallback.plate); }
  const heroId = target?.sections?.find((s: any) => s.plate)?.plate?.id;
  if (heroId && STAND_IN[heroId]) tried.splice(1, 0, STAND_IN[heroId]);
  tried.push(...NEUTRAL);
  const pick = tried.find((id) => id && plateReady(id) && !used.has(id) && !stillsTaken.has(id) && id !== 'cta-amanecer');
  if (pick) stillsTaken.add(pick);
  return pick;
}

/* Panel registrado (superficie de cristal con ancho y alto: telefono, pantalla, tableta) en fracciones de la placa */
function panel(r: Resolved, names = ['telefono', 'pantalla', 'tableta', 'superficie']): { name: string; style: string; m: boolean } | null {
  if (!r.id) return null;
  const a = getPlate(r.id)?.anchors ?? {};
  const name = names.find((n) => Array.isArray(a[n]?.d) && a[n].d.length >= 4);
  if (!name) return null;
  const [x, y, w, h] = a[name].d as number[];
  let style = `--ax:${r.mirror ? 1 - x - w : x};--ay:${y};--aw:${w};--ah:${h};`;
  const m = a[name].m as number[] | null;
  if (Array.isArray(m) && m.length >= 4) style += `--ax-m:${r.mirror ? 1 - m[0] - m[2] : m[0]};--ay-m:${m[1]};--aw-m:${m[2]};--ah-m:${m[3]};`;
  return { name, style, m: Array.isArray(m) };
}

/* ── Portada ── */
const heroS = list.find((s) => s.id === 'hero');
const hp = plateOf(heroS) ?? { id: 'home-sistema-2-atender' };
const hr = resolvePlate(hp.id, { fallbackPlate: hp.launchFallback, mirror: hp.mirror, layout: hp.layout === 'sin sujeto' ? undefined : hp.layout });
const heroPanel = panel(hr);
const heroUi = C.hero?.ui;
const heroLines = heroUi?.bubbles?.length
  ? heroUi.bubbles.map((b: any, i: number, all: any[]) => ({
      who: b.who, text: b.text, time: b.time,
      delay: b.who === 'kain' ? 600 : i === 0 ? 500 : 900,
      event: i === all.length - 1 && heroUi.status ? heroUi.status : undefined,
    }))
  : null;
// R3 · intro móvil: lede ≤ 20 palabras (la oración con la cifra baja a `more`); etiqueta solo si no repite los crumbs
const heroLede = ledeParts(C.hero?.lede, 20);
const heroBubbles: any[] = (heroUi?.bubbles ?? []).slice(0, 2);
const heroEyebrowDup = eyebrowRepeatsCrumbs(C.hero?.eyebrow, P.breadcrumbs);
/* Titular largo (dos voces de más de ~44 caracteres): la escala baja para que portada, lede y CTAs quepan en el primer
   pantallazo (la medida en caracteres crece en la misma proporción: el bloque conserva su ancho) */
const h1Len = `${C.hero?.h1?.text ?? ''} ${C.hero?.h1?.soft ?? ''}`.replace(/\{\{[^}]+\}\}/g, 'xxxxxxxx').trim().length;
const h1Fit = h1Len > 44 ? Math.max(0.74, +Math.sqrt(44 / h1Len).toFixed(3)) : 1;

/* ── Señales: pie de foto "Fig. 02" en el piso de la placa, unido al teléfono de la persona (§3.8) ── */
const painS = list.find((s) => PAIN.includes(s.id));
const painFig: string | null = painS ? (C[painS.id]?.fig?.label ?? 'Lo que pasa a las 11:48\u00a0p.\u00a0m.') : null;
const painFigTarget = (id?: string) => {
  const r = id ? resolvePlate(id, {}) : null;
  return ['telefono', 'mano', 'rostro'].find((n) => r?.anchors[n]?.d) ?? 'mano';
};

/* ── 06 · Comparativa con placa propia (QA #16/#18/#19): ya no es la portada empujada (recortaba a Kain y en la placa
   vertical repetía el mismo encuadre). Es la estación Organizar del inicio: Kain, de cuerpo completo, sostiene la tarjeta
   del lead frente a los carriles del embudo (R13: pose y objeto distintos a la portada). La tarjeta de lead (SIMULACIÓN)
   se registra en la parte LIBRE de la superficie (nunca sobre Kain) y la tabla nace en la disolución inferior de la misma
   placa. Placa: la de sitemap.json si la sección la trae (pedido a orquestador); si no, CMP_PLATE si no se usa ya. ── */
const CMP_PLATE = 'home-sistema-3-organizar';
const cmpS = list.find((s) => TWO.includes(s.id) && C[s.id]?.rows?.length);
// El respaldo CMP_PLATE (Kain con la tarjeta del lead) solo cuenta algo en "agente vs. chatbot"; otra comparativa sin placa
// propia (selector de CRM, n8n vs. Zapier/Make) va sobre aura, sin la tarjeta "Lead nuevo → Cita agendada".
const cmpPlate: any = cmpS ? (plateOf(cmpS) ?? (cmpS.id === 'vs-chatbot' && plateReady(CMP_PLATE) && !used.has(CMP_PLATE) ? { id: CMP_PLATE } : null)) : null;
const cmpSceneId: string | null = cmpPlate ? cmpS.id : null;
if (cmpPlate) used.add(cmpPlate.id);
const LEAD_STAGES = ['Nuevo', 'Calificado', 'Cita agendada'];

/* ── 09 · VKTOR™ a sangre (QA #23: la segunda mitad de la página no tenía ninguna escena con placa): Kain de pie sobre la
   última de cinco losas de cristal (pose distinta a la comparativa y al cierre, R13); cada losa lleva registrada la letra
   de su fase y el riel completo nace en la disolución inferior. Placa: la de sitemap.json o VK_PLATE. ── */
const VK_PLATE = 'metodologia-hero';
const vkS = list.find((s) => s.id === 'vktor' || s.id === 'vktor-cine');
const vkPlate: any = vkS ? (plateOf(vkS) ?? (plateReady(VK_PLATE) && !used.has(VK_PLATE) ? { id: VK_PLATE } : null)) : null;
if (vkPlate) used.add(vkPlate.id);

/** Letra de cada fase en la cara de su losa (anclas escalon-1…5, escritorio y vertical). En la losa donde está parado Kain
 *  se corre a la parte libre, hacia afuera del sujeto (nunca sobre sus pies). */
function slabSteps(vr: Resolved) {
  const dir = vr.mirror ? -1 : 1;
  const clear = (p: [number, number] | null, sub: number[] | null): [number, number] | null => {
    if (!p || !sub || !(p[0] > sub[0] && p[0] < sub[2])) return p;
    return [dir > 0 ? Math.min(sub[2] - 0.055, p[0] + 0.07) : Math.max(sub[0] + 0.055, p[0] - 0.07), p[1]];
  };
  return VKTOR.map((f, i) => {
    const a = `escalon-${i + 1}`;
    const d = clear(vr.anchors[a]?.d ?? null, vr.subject.d), m = clear(vr.anchors[a]?.m ?? null, vr.subject.m);
    return { ...f, a, style: d ? `--ax:${+d[0].toFixed(4)};--ay:${d[1]};` + (m ? `--ax-m:${+m[0].toFixed(4)};--ay-m:${m[1]};` : '') + `--i:${i};` : '' };
  }).filter((f) => f.style);
}

/** Parte libre de una superficie de cristal ([x, y, w, h] de la placa): se recorta al lado del sujeto con 2 % de aire, así
 *  la UI registrada nunca queda sobre Kain (§0.1-5); `pad` la separa de los bordes superior e inferior de la superficie. */
function freeBox(r: Resolved, names: string[], pad = 0.08): { name: string; style: string } | null {
  if (!r.id) return null;
  const raw: any = getPlate(r.id);
  const name = names.find((n) => Array.isArray(raw?.anchors?.[n]?.d) && raw.anchors[n].d.length >= 4);
  if (!name) return null;
  let [x, y, w, h] = raw.anchors[name].d as number[];
  const sd = raw.subject?.d as number[] | undefined;
  if (sd) {
    if (sd[0] >= x + w * 0.5) w = Math.min(w, sd[0] - 0.02 - x);
    else if (sd[2] <= x + w * 0.5) { const nx = Math.max(x, sd[2] + 0.02); w = x + w - nx; x = nx; }
  }
  y += h * pad; h *= 1 - pad * 2;
  const X = r.mirror ? 1 - x - w : x;
  const f = (n: number) => +n.toFixed(4);
  return { name, style: `--ax:${f(X)};--ay:${f(y)};--aw:${f(w)};--ah:${f(h)};` };
}

/* ── UI registrada de cada servicio (portada y escenas con placa) ──
   Caja libre de una superficie de cristal ([x, y, w, h] de la placa, sin espejo): la parte de la superficie que no toca la
   caja del sujeto (el lado más ancho); si la superficie queda dentro del sujeto (la ventana que Kain arma, el tablero junto a
   él), su parte superior, por encima de la mano. Luego crece hasta un mínimo legible hacia el lado del texto (nunca hacia
   el sujeto) y sin bajar de la mano. Nunca queda sobre Kain (§0.1-5). */
type B4 = [number, number, number, number];
const f4 = (n: number) => +n.toFixed(4);
function rawAnchor(id: string | null, name: string): number[] | null {
  const a = id ? (getPlate(id) as any)?.anchors?.[name]?.d : null;
  return Array.isArray(a) && a.length >= 2 ? a : null;
}
function rawSubj(id: string | null): number[] | null {
  const s = id ? (getPlate(id) as any)?.subject?.d : null;
  return Array.isArray(s) && s.length >= 4 ? s : null;
}
function hudFree(id: string | null, names: string[], o: { minW?: number; minH?: number; gap?: number } = {}): { name: string; box: B4 } | null {
  const name = names.find((n) => (rawAnchor(id, n)?.length ?? 0) >= 4);
  if (!id || !name) return null;
  let [x, y, w, h] = rawAnchor(id, name)! as B4;
  const sj = rawSubj(id);
  const mano = rawAnchor(id, 'mano');
  const gap = o.gap ?? 0.02;
  const right = !sj || (sj[0] + sj[2]) / 2 >= x + w / 2;   // el sujeto está a la derecha de la superficie
  if (sj) {
    const lw = Math.min(x + w, sj[0] - gap) - x, rx = Math.max(x, sj[2] + gap), rw = x + w - rx;
    if (Math.max(lw, rw) >= 0.07) { if (lw >= rw) w = lw; else { x = rx; w = rw; } }
    else if (mano && mano[0] > x && mano[0] < x + w && mano[1] > y) h = Math.min(h, mano[1] - 0.015 - y);
  }
  const minW = o.minW ?? 0, minH = o.minH ?? 0;
  if (w < minW) { if (right) x = x + w - minW; w = minW; }
  if (h < minH) {
    const cy = y + h / 2;
    y = cy - minH / 2; h = minH;
    const floor = mano && mano[0] > x - 0.02 && mano[0] < x + w + 0.02 ? mano[1] - 0.015 : 0.9;
    if (y + h > floor) y = floor - h;
    y = Math.max(0.04, y);
  }
  return { name, box: [f4(x), f4(y), f4(w), f4(h)] };
}
const boxCss = (r: Resolved, b: B4) => `--ax:${f4(r.mirror ? 1 - b[0] - b[2] : b[0])};--ay:${b[1]};--aw:${b[2]};--ah:${b[3]};`;
/** Variante de la UI según las claves de `ui` (copy, §5.2.1) */
function hudKind(u: any): string | null {
  if (!u) return null;
  if (u.roadmap?.steps?.length) return 'roadmap';
  if (u.pipeline?.stages?.length) return 'pipeline';
  if (u.canvas?.nodes?.length) return 'canvas';
  if (u.blocks?.length) return 'wire';
  if (u.question && u.answer) return 'answer';
  if (u.modules?.length) return 'identity';
  if (u.layers?.length) return 'layers';
  if (u.rows?.length) return 'report';
  if (u.channels?.length) return 'channels';
  if (u.panels?.length && u.title) return 'dash';
  if (u.panels?.length) return 'ads';
  return null;
}
/** Caja de la UI en la placa de su escena, por variante */
function hudBox(kind: string, id: string | null): { name: string; box: B4 } | null {
  if (!id) return null;
  if (kind === 'roadmap') {
    // Leyenda bajo la ruta de 5 nodos del panel (la ruta de la placa queda a la vista, con sus nodos numerados)
    const P = rawAnchor(id, 'pantalla'), R = rawAnchor(id, 'ruta'), sj = rawSubj(id);
