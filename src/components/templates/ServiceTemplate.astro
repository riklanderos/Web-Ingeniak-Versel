          {heroHud && <LightBranch from="mano" via=".svc-hud--reg" />}
          {heroHud && heroKind && (
            <div slot="anchors" class={`anchor anchor--panel svc-hud svc-hud--reg svc-hud--${heroKind}`} data-anchor={heroHud.name} data-lock data-m="none"
              data-nosnippet style={boxCss(hr, heroHud.box)} role="img" aria-label={HUD_ARIA[heroKind]}>{hud(heroKind, heroUi)}</div>
          )}
          {heroRouteNodes.length > 1 && (
            <Fragment slot="anchors">
              {heroRouteNodes.map((n, i) => (
                <span class:list={['anchor svc-rm__dot', i === (heroUi.roadmap.active ?? 0) && 'is-on', i < (heroUi.roadmap.active ?? 0) && 'is-done']}
                  data-anchor={n} style={anchorStyle(n, `--i:${i};`)} aria-hidden="true"><b>{String(i + 1).padStart(2, '0')}</b></span>
              ))}
            </Fragment>
          )}
          {heroLines && heroPanel && (
            <div slot="anchors" class="anchor anchor--panel svc-panel svc-ui" data-anchor={heroPanel.name} data-lock style={heroPanel.style} data-nosnippet>
              <ChatSim mode="registered" scripts={{ portada: heroLines }} tabs={[{ id: 'portada', label: 'WhatsApp' }]} note={false} />
            </div>
          )}
          {/* R3/R4: en móvil la cifra del lede y las 2 burbujas del guion (versión en línea de la UI registrada) bajan
              después de la placa, dentro de la misma sección; en el teléfono de la placa queda la miniatura encendida */}
          {(heroLede.rest || heroBubbles.length > 0 || heroKind) && (
            <Fragment slot="more">
              {heroLede.rest && <Copy text={heroLede.rest} as="p" class="t-lede t-lede--2 svc-hero__proof tpl-dhide" />}
              {heroKind && (
                <div class={`svc-hud svc-hud--inline svc-hud--${heroKind}${heroHud ? ' tpl-dhide' : ''}`} role="img" aria-label={HUD_ARIA[heroKind]} data-nosnippet>{hud(heroKind, heroUi)}</div>
              )}
              {heroBubbles.length > 0 && (
                <div class="svc-bubbles tpl-dhide" role="group" aria-label="Simulación de una conversación por WhatsApp" data-nosnippet>
                  <p class="svc-bubbles__top">
                    <span class="chip-sim">SIMULACIÓN</span>
                    {heroBubbles[0]?.time && <span class="t-micro svc-bubbles__time" data-allow-number>{heroUi?.timeLabel ?? 'Hora ilustrativa'} · {heroBubbles[0].time}</span>}
                  </p>
                  {heroBubbles.map((b: any) => (
                    <p class:list={['svc-bubble', b.who === 'kain' ? 'svc-bubble--kain' : 'svc-bubble--cliente']}>
                      <span class="sr-only">{b.who === 'kain' ? 'Kain' : 'Cliente'}: </span><span set:html={annotateFigures(b.text)} />
                    </p>
                  ))}
                  {heroUi?.status && <p class="t-micro svc-bubbles__status"><span class="node" aria-hidden="true"></span>{heroUi.status}</p>}
                </div>
              )}
            </Fragment>
          )}
        </ImageSection>

        {b.next && (
          <Intertitle id={b.next.s.id} rack aura="none" labelledby={`${b.next.s.id}-def-q`} class="svc-def tpl-glow">
            <Aura kind="ondas" x="40%" y="104%" o={1} only="d" />
            <DefinitionBlock
              id={`${b.next.s.id}-def`}
              faqId={b.next.c.definition?.faqId}
              heading={b.next.c.definition?.heading ?? b.next.c.h2?.text}
              text={b.next.c.definition?.text}
              label={b.next.c.eyebrow}
            />
            {(b.next.c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body svc-def__body" data-reveal />)}
            {b.next.c.metricRow?.metricIds?.length > 0 && (
              <Metric variant="row" ids={b.next.c.metricRow.metricIds} heading={b.next.c.metricRow.title} note={b.next.c.metricRow.sourceNote !== false} class="svc-def__row" />
            )}
          </Intertitle>
        )}
      </SharedTake>
    );

    /* ───────────── Definición suelta (si no sigue a la portada) ───────────── */
    if (b.kind === 'def') return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-def-q`} class="svc-def tpl-glow">
        <DefinitionBlock id={`${s.id}-def`} faqId={c.definition?.faqId} heading={c.definition?.heading ?? c.h2?.text} text={c.definition?.text} label={c.eyebrow} />
        {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body svc-def__body" data-reveal />)}
        {c.metricRow?.metricIds?.length > 0 && <Metric variant="row" ids={c.metricRow.metricIds} heading={c.metricRow.title} note={c.metricRow.sourceNote !== false} class="svc-def__row" />}
        <Fragment set:html={aura('isotipo', 'right')} />
      </Intertitle>
    );

    /* ───────────── 03 · Señales (persona en luz ámbar) ───────────── */
    if (b.kind === 'pain') {
      const items = (c.items ?? []) as { pain: string; painLine?: string; fix: string }[];
      const withLine = items.some((it) => it.painLine);
      // Con el respaldo de lanzamiento (p. ej. dolor-anuncios → dolor-operacion) manda el lado del sujeto de la placa que se
      // pinta, no el de la placa pedida: si no, el texto y el velo quedan del lado de la persona
      const pr = resolvePlate(p?.id ?? 'home-problema-a', { fallbackPlate: p?.launchFallback, mirror: p?.mirror });
      return (
        <ImageSection
          id={s.id} plate={p?.id ?? 'home-problema-a'} fallbackPlate={p?.launchFallback} layout={pr.usedFallback ? undefined : lay(p)} mirror={p?.mirror}
          height={p?.height ?? 'mid'} tone="dolor" mobile={p?.mobile ?? 'split'} srcsetMax={p?.srcsetMax ?? 1920} alt="" class="svc-pain tpl-glow-m"
        >
          <span class="tpl-introglow" aria-hidden="true"></span>
          {c.eyebrow && <p class="t-label t-label--amber eyebrow"><span class="node node--amber" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          {/* Pie de foto anclado al piso (ancla fig de la placa; en la vertical es null → no se pinta en móvil, R4) */}
          {painFig && <FigCaption slot="anchors" n={2} title={painFig} anchor="fig" target={painFigTarget(p?.id)}></FigCaption>}
          <Fragment slot="more">
            <Aura kind="ondas" x="50%" o={1} only="m" sticky />
            {withLine ? (
              <div class="pain pain--draw svc-signals" data-pain="draw">
                <ol class="pain__list" aria-label={c.eyebrow ?? 'Señales y su solución'}>
                  {items.map((it, i) => (
                    <li class="pain__item" style={`--i:${i}`} data-pain-item>
                      <p class="pain__pain"><span class="pain__node" aria-hidden="true"></span><span class="sr-only">Señal: </span><span set:html={annotateFigures(it.pain)} /></p>
                      {it.painLine && <p class="svc-signals__line" set:html={annotateFigures(it.painLine)} />}
                      <p class="pain__fix">
                        <span class="pain__branch" aria-hidden="true"><svg viewBox="0 0 28 20" preserveAspectRatio="none"><path d="M1 1v7l8 8h18" pathLength="1" /></svg></span>
                        <span class="sr-only">Con el sistema: </span><span class="pain__fix-t" set:html={annotateFigures(it.fix)} />
                      </p>
                    </li>
                  ))}
                </ol>
              </div>
            ) : <PainList items={items} mode="draw" label={c.eyebrow} />}
            {c.remate && <Copy text={c.remate} as="p" class="pain__remate" />}
          </Fragment>
        </ImageSection>
      );
    }

    /* ───────────── 04 · Capacidades (filas de guion + teléfono de cristal sobre aura) ───────────── */
    if (b.kind === 'script') {
      const rows = (c.items ?? []).map((it: any, i: number) => ({ n: it.n ?? String(i + 1).padStart(2, '0'), title: it.title, line: it.line, href: hrefOr(it.href), external: ext(it.href) }));
      const groups = c.groups?.map((g: any) => ({ label: g.label, glyph: g.glyph, rows: (g.items ?? []).map((it: any) => ({ title: it.title, line: it.line, href: hrefOr(it.href) })) }));
      const tabs = c.chat ? (c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']) : null;
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class={tabs ? 'svc-cap svc-cap--chat tpl-glow' : 'svc-cap tpl-glow'}>
          <div class="svc-cap__grid">
            <div class="svc-cap__main">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
              {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
              <ScriptList rows={groups ? [] : rows} groups={groups} label={c.eyebrow} class="svc-cap__rows" />
              {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body" data-reveal />)}
              {built(c.links).length > 0 && (
                <p class="svc-links" data-reveal>{built(c.links).map((l: any) => <a class="lnk" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}<Icon name={l.external ? 'external' : 'arrow'} size={16} /></a>)}</p>
              )}
            </div>
            {tabs && (
              <div class="svc-cap__aside">
                <Fragment set:html={aura('isotipo', 'phone')} />
                <ChatSim mode="inline" tabs={tabs} title={c.chat.title ?? "Agente de IA"} />
              </div>
            )}
          </div>
          {!tabs && <Fragment set:html={aura('isotipo', 'right')} />}
          <Aura kind="ondas" x="30%" y="100%" o={1} only="d" />
        </Intertitle>
      );
    }

    /* ───────────── 05 · Cómo funciona (nodos registrados sobre el riel de la placa) ───────────── */
    if (b.kind === 'flow') {
      const nodes = ((c.nodes ?? []) as any[]).filter((n) => n.confirmed !== false);
      const fp = flowPlate(s);
      const regs = fp?.r.id ? nodes.map((_, i) => `nodo-${i + 1}`) : [];
      const registrable = !!fp?.r.id && nodes.length > 1 && regs.every((n) => fp!.r.anchors[n]?.d) && !fp!.r.anchors[`nodo-${nodes.length + 1}`];
      if (registrable) return (
        <ImageSection
          id={s.id} plate={fp!.p.id} fallbackPlate={fp!.p.launchFallback} layout="subject-center" mirror={fp!.p.mirror}
          height="mid" align="start" mobile="top" srcsetMax={fp!.p.srcsetMax ?? 1920} alt="" class="svc-flow tpl-glow-m" data-nodes={nodes.length}
        >
          <span class="tpl-introglow tpl-introglow--d" aria-hidden="true"></span>
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          {c.note && <Copy text={c.note} as="p" class="svc-flow__note t-small" />}
          <Fragment slot="anchors">
            <span class="svc-bead" aria-hidden="true" style={beadStyle(nodes.length)}></span>
            <ol class="svc-nodes" aria-label={c.h2?.text ?? 'Cómo funciona'}>
              {nodes.map((n, i) => {
                const isKain = n.kain ?? /^kain\b/i.test(n.label ?? '');
                return (
                  <li class="anchor svc-node" data-anchor={`nodo-${i + 1}`} style={anchorStyle(`nodo-${i + 1}`, `--k:${i};--nn:${nodes.length};`)}>
                    <span class="svc-node__stem" aria-hidden="true"></span>
                    <span class="svc-node__card">
                      <span class="svc-node__top">
                        <span class="svc-node__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        {isKain && <span class="kain-mark svc-node__kain" aria-hidden="true">kain</span>}
                        {(n.logos ?? []).map((l: string) => (
                          <span class:list={['logo-mask', logoWide(l) && 'logo-mask--wide']} style={`--logo:url(${logoUrl(l)})`} role="img" aria-label={TOOLS[l]?.name ?? l}></span>
                        ))}
                      </span>
                      <span class="svc-node__t">{n.label}</span>
                      {n.line && <span class="svc-node__l" set:html={annotateFigures(n.line)} />}
                    </span>
                  </li>
                );
              })}
            </ol>
          </Fragment>
        </ImageSection>
      );
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-flow-alt tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          <SystemFlow nodes={nodes.map((n) => ({ label: n.label, line: n.line, logo: n.logos?.[0], kain: n.kain ?? /^kain\b/i.test(n.label ?? ''), confirmed: n.confirmed }))} title={c.h2?.text} />
          {c.note && <Copy text={c.note} as="p" class="t-small" />}
          <Fragment set:html={aura('isotipo', 'center')} />
        </Intertitle>
      );
    }

    /* ───────────── 06 · Agente vs. chatbot (tabla por criterio) ───────────── */
    if (b.kind === 'compare') {
      const L = c.left ?? { title: 'Antes' }; const R = c.right ?? { title: 'Después' };
      const lt = toneOf(L.tone ?? 'ambar'); const rt = toneOf(R.tone ?? 'cian');
      const table = (
          <table class="svc-cmp" data-ui-reveal>
            <caption class="sr-only">{c.h2?.text} {c.h2?.soft}</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Criterio</span></th>
                <th scope="col" class={`svc-cmp__h tone-${lt}`}><span class={`tcs__node tcs__node--${lt === 'amber' ? 'no' : lt === 'cyan' ? 'yes' : 'neutral'}`} aria-hidden="true"></span>{L.title}</th>
                <th scope="col" class={`svc-cmp__h tone-${rt}`}><span class={`tcs__node tcs__node--${rt === 'amber' ? 'no' : rt === 'cyan' ? 'yes' : 'neutral'}`} aria-hidden="true"></span>{R.title}</th>
              </tr>
            </thead>
            <tbody>
              {c.rows.map((r: any, i: number) => (
                <tr style={`--i:${i}`}>
                  <th scope="row" class="svc-cmp__k">{r.criterio ?? r.k ?? r.label}</th>
                  <td class={`svc-cmp__c tone-${lt}`}><span class="svc-cmp__mk" aria-hidden="true">{L.title}</span><span set:html={annotateFigures(r.chatbot ?? r.left ?? r.antes ?? '')} /></td>
                  <td class={`svc-cmp__c tone-${rt}`}><span class="svc-cmp__mk" aria-hidden="true">{R.title}</span><span set:html={annotateFigures(r.agente ?? r.right ?? r.despues ?? '')} /></td>
                </tr>
              ))}
            </tbody>
          </table>
      );
      const cmpLinks = built(c.links).length > 0 && (
        <p class="svc-links" data-reveal>{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>
      );
      /* Escena con placa propia (QA #16/#18/#19): Kain de cuerpo completo con la tarjeta del lead; la tarjeta de lead
         (SIMULACIÓN) va registrada en la parte libre de la superficie de cristal y la tabla nace en la disolución inferior de
         la misma placa (una sola composición, nunca dos cajas). En móvil la superficie queda detrás de Kain → la tarjeta
         baja al flujo, antes de la tabla (R4: data-m="none" + versión en línea). */
      if (s.id === cmpSceneId) {
        const rr = resolvePlate(cmpPlate.id, { fallbackPlate: cmpPlate.launchFallback, mirror: cmpPlate.mirror });
        const pan = freeBox(rr, ['superficie', 'pantalla', 'telefono', 'tableta']);
        const leadAria = 'Simulación: un lead de WhatsApp llega a la etapa Cita agendada de tu CRM';
        const leadCard = () => (
          <div class="svc-lead__card" aria-hidden="true">
            <p class="svc-lead__top"><span class="chip-sim">SIMULACIÓN</span></p>
            <p class="svc-lead__k"><span class="node" aria-hidden="true"></span>Lead nuevo · WhatsApp</p>
            <ol class="svc-lead__stages">
              {LEAD_STAGES.map((t, i) => <li class:list={['svc-lead__st', i === LEAD_STAGES.length - 1 && 'is-on']} style={`--i:${i}`}><i></i><span>{t}</span></li>)}
            </ol>
            <p class="svc-lead__evt"><span class="svc-lead__ok"></span>Cita registrada en tu CRM</p>
          </div>
        );
        return (
          <ImageSection
            id={s.id} plate={cmpPlate.id} fallbackPlate={cmpPlate.launchFallback} layout={lay(cmpPlate)} mirror={cmpPlate.mirror} height="mid" align="start"
            mobile="split" srcsetMax={cmpPlate.srcsetMax ?? 1920} alt="" class="svc-back tpl-glow-m"
          >
            <span class="tpl-introglow" aria-hidden="true"></span>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
            {pan && (
              <div slot="anchors" class="anchor anchor--panel svc-lead" data-anchor={pan.name} data-m="none" data-lock data-nosnippet style={pan.style}
                role="img" aria-label={leadAria}>{leadCard()}</div>
            )}
            <Fragment slot="more">
              {pan && <div class="svc-lead svc-lead--inline tpl-dhide" role="img" aria-label={leadAria} data-nosnippet>{leadCard()}</div>}
              <div class="svc-back__table">
                <Aura kind="ondas" x="55%" y="70%" o={1} only="d" />
                {table}
                {cmpLinks}
              </div>
            </Fragment>
          </ImageSection>
        );
      }
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-cmp-sec tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
          {table}
          {cmpLinks}
          <Fragment set:html={aura('ondas', 'cmp')} />
        </Intertitle>
      );
    }

    /* ───────────── 06b · Lo que sí / lo que no · Es para ti si · Antes y después ───────────── */
    if (b.kind === 'two') {
      const variant = s.id === 'antes-despues' ? 'before-after' : s.id === 'si-no' ? 'dodont' : 'fit';
      const side = (x: any, d: 'cyan' | 'amber') => ({ title: x?.title ?? '', items: x?.items ?? [], tone: x?.tone ? toneOf(x.tone) : d });
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-two tpl-glow">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
          <Aura kind="ondas" x="50%" o={1} only="m" sticky />
          <TwoColumnScript variant={variant} left={side(c.left, 'cyan')} right={side(c.right, 'amber')} slogan={c.slogan} class="svc-two__cols" />
          {built(c.links).length > 0 && (
            <p class="svc-links svc-two__links" data-reveal>{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>
          )}
          <Fragment set:html={aura('ondas', 'two')} />
        </Intertitle>
      );
    }

    /* ───────────── 08 · Integraciones (créditos de herramientas por grupo) ───────────── */
    if (b.kind === 'logos') {
      const groups = (c.groups ?? (c.logos ? [{ label: c.eyebrow ?? '', logos: c.logos }] : [])) as any[];
      return (
        <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-int tpl-glow">
            <Aura kind="ondas" x="50%" o={1} only="m" sticky />
            <div class="svc-int__head">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            </div>
            <dl class="svc-int__groups" data-ui-stagger>
              {groups.map((g, i) => (
                <div class="svc-int__g" style={`--i:${i}`}>
                  <dt class="t-label svc-int__label">{g.label}</dt>
                  <dd class="svc-int__logos">
                    {(g.logos ?? []).length ? (g.logos as any[]).map((l) => {
                      const lh = hrefOr(l.href);
                      const Tag = lh ? 'a' : 'span';
                      return (
                        <Tag class="logo-credit svc-int__logo" href={lh}>
                          <span class:list={['logo-mask', logoWide(l.slug) && 'logo-mask--wide']} style={`--logo:url(${logoUrl(l.slug)})`} aria-hidden="true"></span>
                          <span class="logo-credit__name">{l.label ?? TOOLS[l.slug]?.name ?? l.slug}</span>
                        </Tag>
                      );
                    }) : <span class="logo-credit svc-int__logo"><Icon name="calendar" size={22} /><span class="sr-only">{g.label}</span></span>}
                  </dd>
                  {g.line && <dd class="svc-int__line" set:html={annotateFigures(g.line)} />}
                </div>
              ))}
            </dl>
            {c.note && (
              <div class="svc-int__note" data-reveal>
                {(groups.some((g) => (g.logos ?? []).some((l: any) => l.slug === 'kommo')) || /kommo/i.test(c.note)) && <KommoBadge size="sm" />}
                <Copy text={c.note} as="p" class="t-small" />
              </div>
            )}
            <Fragment set:html={aura('isotipo', 'int')} />
        </Intertitle>
      );
    }

    /* ───────────── 07 · Casos (Montage de 1–2 filas + registro filtrado) ───────────── */
    if (b.kind === 'cases') {
      const { rowIds, ledgerIds, stillMap } = casesData(c);
      return (
        <>
          <Montage id={s.id} ids={rowIds} stillFor={stillMap} anonNote={c.note ?? 'Nombres de clientes anonimizados.'} class={['svc-mt', 'tpl-glow', ledgerIds.length > 0 && 'svc-mt--ledger'].filter(Boolean).join(' ')}>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
            {/* El registro filtrado vive DENTRO de #casos (pie del montaje), con su propio titular */}
            <Fragment slot="foot">
              {ledgerIds.length > 0 && (
                <div class="svc-ledger" role="group" aria-labelledby={`${s.id}-registro-h`}>
                  <Fragment set:html={aura('ondas', 'ledger')} />
                  <h3 id={`${s.id}-registro-h`} class="t-label t-label--cyan eyebrow svc-ledger__h"><span class="node" aria-hidden="true"></span>{c.ledger?.caption ?? 'Registro de resultados'}</h3>
                  <ResultsLedger ids={ledgerIds} caption={c.ledger?.caption} id={`${s.id}-registro`} />
                </div>
              )}
              {[{ href: '/casos/', label: 'Ver todos los casos' }, { href: '/casos/#registro', label: 'Registro de resultados completo' }].filter((l) => isBuilt(l.href)).map((l) => (
                <a class="lnk" href={l.href}>{l.label} <Icon name="arrow" size={16} /></a>
              ))}
            </Fragment>
          </Montage>
        </>
      );
    }

    /* ───────────── 08b · Industrias: filas de guion (R7: una sola fila de stills por página fuera de los hubs, que es
       "Sigue explorando"). Sector, una línea y "Ver industria →" solo si la industria ya existe. ───────────── */
    if (b.kind === 'ind') return (
      <section id={s.id} class="svc-sec svc-ind tpl-glow" aria-labelledby={`${s.id}-t`}>
        <Fragment set:html={aura('ondas', 'ind')} />
        <div class="frame svc-ind__frame">
          <div class="svc-sec__head svc-ind__head">
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          </div>
          <ol class="svc-ind__list" role="list" data-ui-stagger>
            {(c.items ?? []).map((it: any, i: number) => {
              const href = hrefOr(it.href);
              const inner = (
                <>
                  <span class="svc-ind__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-ind__sector t-label">{it.label}</span>
                  <h3 class="svc-ind__t">{it.title}</h3>
                  {it.line && <span class="svc-ind__l">{it.line}</span>}
                  {href && <span class="svc-ind__go lnk--mono">Ver industria <span aria-hidden="true">→</span></span>}
                </>
              );
              return (
                <li class="svc-ind__row" style={`--i:${i}`}>
                  {href ? <a class="svc-ind__link" href={href}>{inner}</a> : <div class="svc-ind__link svc-ind__link--static">{inner}</div>}
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    );

    /* ───────────── 09 · VKTOR™ aplicado al servicio ───────────── */
    if (b.kind === 'vktor') {
      const link = c.links?.[0];
      // `phases` (vktor) o, en vktor-cine, las 5 viñetas "Fase · línea" en orden V·K·T·O·R
      const lines: string[] = (c.phases ?? []).length
        ? c.phases.map((f: any) => f.line)
        : ((c.items ?? []) as any[]).map((t) => String(typeof t === 'string' ? t : t?.line ?? '').replace(/^[^·:]{2,24}[·:]\s*/, ''));
      const rail = (
        <VktorRail variant="phases" lines={lines} href={hrefOr(link?.href ?? '/metodologia/') ?? false} linkLabel={link?.label ?? 'Conoce el protocolo completo'} class="svc-vk__rail" />
      );
      /* A sangre (QA #23): las cinco losas de la placa son las cinco fases; cada una lleva su letra registrada (escritorio y
         vertical, R4) y el riel con el texto de cada fase nace en la disolución inferior de la misma placa. */
      if (vkPlate) {
        const vr = resolvePlate(vkPlate.id, { fallbackPlate: vkPlate.launchFallback, mirror: vkPlate.mirror });
        const steps = slabSteps(vr);
        return (
          <ImageSection
            id={s.id} plate={vkPlate.id} fallbackPlate={vkPlate.launchFallback} layout={lay(vkPlate)} mirror={vkPlate.mirror} height="mid" align="start"
            mobile="split" srcsetMax={vkPlate.srcsetMax ?? 1920} alt="" class="svc-vks tpl-glow-m"
          >
            <span class="tpl-introglow" aria-hidden="true"></span>
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
            {steps.length === 5 && (
              <Fragment slot="anchors">
                {steps.map((f) => (
                  <span class="anchor svc-slab" data-anchor={f.a} style={f.style} aria-hidden="true">
                    <b class="svc-slab__l">{f.l}</b><span class="svc-slab__n">{f.name}</span>
                  </span>
                ))}
              </Fragment>
            )}
            <Fragment slot="more">{rail}</Fragment>
          </ImageSection>
        );
      }
      return (
        <section id={s.id} class="svc-sec svc-vk tpl-glow" aria-labelledby={`${s.id}-t`}>
          <div class="frame">
            <div class="svc-sec__head">
              {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
              <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
            </div>
            {rail}
          </div>
          <Fragment set:html={aura('ondas', 'vk')} />
        </section>
      );
    }

    /* ───────────── 10 · Inversión (una línea + 3 factores, sin tabla) ───────────── */
    if (b.kind === 'price') return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-price tpl-glow">
        <div class="svc-price__grid">
          <div class="svc-price__head">
            <Fragment set:html={aura('isotipo', 'price')} />
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-display-2 svc-price__h" data-split set:html={head(c.h2)} />
          </div>
          <div class="svc-price__body">
            <Aura kind="ondas" x="50%" y="110%" o={1} only="d" />
            {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
            {c.items?.length > 0 && (
              <ol class="svc-factors" data-ui-stagger>
                {c.items.map((it: any, i: number) => (
                  <li class="svc-factor" style={`--i:${i}`}>
                    <span class="svc-factor__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="svc-factor__t" set:html={annotateFigures(it.title)} />
                    {it.line && <span class="svc-factor__l" set:html={annotateFigures(it.line)} />}
                  </li>
                ))}
              </ol>
            )}
            {c.remate && <Copy text={c.remate} as="p" class="t-deck svc-price__remate" data-reveal />}
          </div>
        </div>
      </Intertitle>
    );

    /* ───────────── 11 · Preguntas frecuentes ───────────── */
    if (b.kind === 'faq') return (
      <Intertitle id={s.id} aura="none" layout="split" labelledby={`${s.id}-t`} class="svc-faq tpl-glow">
        <Fragment slot="head">
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.footer && (
            <p class="svc-faq__foot t-small" data-reveal set:html={annotateFigures(c.footer).replace(SITE.email, `<a href="mailto:${SITE.email}">${SITE.email}</a>`)} />
          )}
          <div class="svc-faq__cta" data-reveal><Btn variant="ghost" href={wa(C.hero)} label={C.hero?.ctaSecondary?.label ?? 'Escríbele a Kain'} /></div>
        </Fragment>
        <Aura kind="ondas" x="50%" o={1} only="m" sticky />
        <FAQAccordion ids={c.faqIds ?? []} glass id={`${s.id}-list`} label={c.h2?.text ?? 'Preguntas frecuentes'} />
        <Fragment set:html={aura('ondas', 'faq')} />
      </Intertitle>
    );

    /* ───────────── 12 · Sigue explorando (Still ×3, texto dentro de la penumbra) ───────────── */
    if (b.kind === 'related' && !relItems.length) return null;
    if (b.kind === 'related') return (
      <section id={s.id} class="svc-sec svc-rel tpl-glow" aria-labelledby={`${s.id}-t`}>
        <div class="frame">
          <div class="svc-sec__head">
            {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
            <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          </div>
          <ul class="svc-rel__grid" role="list" data-ui-stagger>
            {relItems.map((it: any, i: number) => (
              <li style={`--i:${i}`}><Still href={it.href} plate={stillFor(it.href)} label={it.label} title={it.title} line={it.line} /></li>
            ))}
          </ul>
        </div>
      </section>
    );

    /* ───────────── 13 · Cierre (Dawn) ───────────── */
    if (b.kind === 'dawn') return (
      <Dawn id={s.id} plate={p?.id ?? 'cta-amanecer'} mirror={p?.mirror} fallbackPlate={p?.launchFallback} layout={lay(p)} class="tpl-glow-m">
        {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
        <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
        {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
        <div class="ctas">
          <Btn variant="primary" href={c.ctaPrimary?.href ?? SITE.discovery} label={c.ctaPrimary?.label ?? 'Agenda tu Discovery Session'} micro />
          <Btn variant="ghost" href={wa(c.ctaSecondary ? c : C.hero)} label={c.ctaSecondary?.label ?? 'Escríbele a Kain'} />
        </div>
        {/* c.micro ("Sin costo · Sin compromiso · 30 minutos…") repetiría la microcopia del primario y el lede:
            solo se imprime si el lede no dice ya lo mismo */}
        {c.micro && !/sin compromiso/i.test(c.lede ?? '') && <p class="t-micro dawn__note" data-allow-number>{c.micro}</p>}
      </Dawn>
    );

    /* ───────────── Escena con placa (crm-vivo, dashboard, agente-chat…) ───────────── */
    if (b.kind === 'scene') {
      /* Escena con placa (R5: el set de la portada se revisita con push; o la persona ilustrativa de un caso). La placa mide
         una pantalla (no se estira con el texto) y la columna de texto termina/empieza en el borde que calcula sceneGeo, con
         el sujeto y la UI ya empujados: el texto nunca pisa a Kain ni a la UI registrada. */
      const g = sceneGeo(p, c, s.id);
      const r = g.r;
      const pan = c.chat ? panel(r) : null;
      const hk = pan ? null : g.kind;
      const links = built(c.links);
      const hasMore = c.items?.length > 0 || !!c.slogan || links.length > 0 || (c.chat && !pan) || !!hk;
      const illus = /^(caso|ind)-/.test(r.id ?? '') ? (c.illus ?? 'Imagen ilustrativa del sector') : null;
      const hudCls = hk === 'lead' ? 'svc-hud svc-hud--lead svc-lead' : `svc-hud svc-hud--${hk}`;
      return (
        <ImageSection
          id={s.id} plate={p.id} fallbackPlate={p.launchFallback} layout={g.r.usedFallback ? undefined : lay(p)} mirror={p.mirror} height={p.height ?? 'mid'}
          tone={p.tone === 'dolor' ? 'dolor' : 'sol'} mobile={p.mobile === 'below' ? 'below' : hasMore ? 'split' : (p.mobile ?? 'top')} srcsetMax={p.srcsetMax ?? 1920}
          push={g.push} alt={p.id === hp.id ? '' : undefined} class={`svc-scene ${g.eClass} tpl-glow-m`}
        >
          <span class="tpl-introglow" aria-hidden="true"></span>
          {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
          <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
          {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" />}
          {illus && <p slot="over" class="chip-illus svc-illus tpl-mhide">{illus}</p>}
          {hk && g.hb && (
            <div slot="anchors" class={`anchor anchor--panel ${hudCls} svc-hud--reg`} data-anchor={g.hb.name} data-lock data-m="none" data-nosnippet
              style={boxCss(r, g.hb.box)} role="img" aria-label={HUD_ARIA[hk]}>{hud(hk, c.ui)}</div>
          )}
          {hasMore && (
            <Fragment slot="more">
              {hk && <div class={`${hudCls} svc-hud--inline${g.hb ? ' tpl-dhide' : ''}`} role="img" aria-label={HUD_ARIA[hk]} data-nosnippet>{hud(hk, c.ui)}</div>}
              {c.items?.length > 0 && <ul class="svc-bullets">{c.items.map((t: any) => <li><span class="node" aria-hidden="true"></span><span set:html={annotateFigures(typeof t === 'string' ? t : t.title ?? '')} /></li>)}</ul>}
              {c.slogan && <Copy text={c.slogan} as="p" class="t-deck svc-slogan" />}
              {links.length > 0 && <p class="svc-links">{links.map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>}
              {c.chat && !pan && <ChatSim mode="inline" tabs={c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']} />}
              {illus && <p class="chip-illus svc-illus-m tpl-dhide">{illus}</p>}
            </Fragment>
          )}
          {pan && (
            <div slot="anchors" class="anchor anchor--panel svc-panel svc-ui" data-anchor={pan.name} data-lock style={pan.style}>
              <ChatSim mode="registered" tabs={c.chat.tabs ?? c.chat.scripts ?? [c.chat.script ?? 'default']} note={false} />
            </div>
          )}
        </ImageSection>
      );
    }

    /* ───────────── Sección sin componente propio (texto sobre aura) ───────────── */
    return (
      <Intertitle id={s.id} aura="none" labelledby={`${s.id}-t`} class="svc-gen tpl-glow">
        {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
        {c.h2 && <h2 id={`${s.id}-t`} class="t-h2" data-split set:html={head(c.h2)} />}
        {c.lede && <Copy text={c.lede} as="p" class="t-lede t-lede--2" data-reveal />}
        {(c.body ?? []).map((t: string) => <Copy text={t} as="p" class="svc-body" data-reveal />)}
        {c.items?.length > 0 && (
          <ScriptList rows={c.items.map((it: any, i: number) => (typeof it === 'string' ? { n: String(i + 1).padStart(2, '0'), title: it } : { n: it.n, title: it.title, line: it.line, href: hrefOr(it.href) }))} />
        )}
        {built(c.links).length > 0 && <p class="svc-links">{built(c.links).map((l: any) => <a class="lnk" href={l.href}>{l.label}<Icon name={ext(l.href) ? 'external' : 'arrow'} size={16} /></a>)}</p>}
      </Intertitle>
    );
  })}
</BaseLayout>
