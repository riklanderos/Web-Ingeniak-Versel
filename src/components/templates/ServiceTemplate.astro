    const x1 = Math.min(P[0] + P[2], sj ? sj[0] - 0.02 : 1) - 0.004, y1 = P[1] + P[3] - 0.03;
    return x1 - x >= 0.08 && y1 - y >= 0.12 ? { name: 'pantalla', box: [f4(x), f4(y), f4(x1 - x), f4(y1 - y)] } : null;
  }
  if (kind === 'pipeline') return hudFree(id, ['superficie', 'carriles', 'pantalla'], { minW: 0.17, minH: 0.3 });
  if (kind === 'canvas') return hudFree(id, ['constelacion', 'superficie', 'pantalla'], { minW: 0.13, minH: 0.36, gap: 0.03 });
  if (kind === 'ads') return hudFree(id, ['pantalla', 'superficie'], { minW: 0.12, minH: 0.34, gap: 0.004 });
  if (kind === 'wire' || kind === 'layers') return hudFree(id, ['ventana', 'superficie', 'pantalla'], { minW: 0.13, minH: 0.18 });
  if (kind === 'answer' || kind === 'report') return hudFree(id, ['tarjeta', 'superficie', 'pantalla'], { minW: 0.16, minH: 0.225 });
  if (kind === 'identity' || kind === 'channels') return hudFree(id, ['superficie', 'pantalla', 'tableta'], { minW: 0.13, minH: 0.18 });
  if (kind === 'dash') return hudFree(id, ['superficie', 'pantalla'], { minW: 0.14, minH: 0.34 });
  if (kind === 'lead') return hudFree(id, ['superficie', 'pantalla', 'telefono', 'tableta'], { minW: 0.15, minH: 0.3 });
  return null;
}
