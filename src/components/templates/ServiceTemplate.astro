/** Logo de una herramienta por su nombre en el copy ("Meta Ads" → meta, "n8n" → n8n); null si no hay logo registrado */
const norm = (t = '') => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '');
const TOOL_KEYS = Object.keys(TOOLS).filter((k) => /^[a-z0-9]+$/.test(k)).sort((a, b) => b.length - a.length);
function toolSlug(label: string): string | null {
  const n = norm(label);
  if (!n) return null;
  return TOOL_KEYS.find((k) => n === k || n === norm((TOOLS as any)[k]?.name) || (n.startsWith(k) && k.length >= 4)) ?? null;
}
/** Escena con placa (crm-vivo, este-sitio, dashboard, como-medimos, kain-ejemplo, caso con imagen): empuje acotado a lo que
 *  deja al sujeto entero (camCap) y borde de la columna de texto en la placa, con el sujeto y la UI ya empujados (+3 %). */
function sceneGeo(p: any, c: any, sid: string) {
  const r = resolvePlate(p.id, { fallbackPlate: p.launchFallback, mirror: p.mirror });
  const kind = hudKind(c.ui) ?? (sid === 'crm-vivo' && r.id ? 'lead' : null);
  const hb = kind ? hudBox(kind, r.id) : null;
  const L = r.usedFallback ? r.layout : (lay(p) ?? r.layout);   // con respaldo manda el lado del sujeto de la placa pintada
  const sj = rawSubj(r.id);
  let push: { anchor: string; camFrom: number; camTo: number } | undefined;
  let cam = 1, ox = 0.5;
  if (p.push && r.id) {
    const an = p.push.anchor ?? hb?.name ?? 'superficie';
    const a = rawAnchor(r.id, an);
    if (a) {
      ox = a.length >= 4 ? a[0] + a[2] / 2 : a[0];
      const oy = a.length >= 4 ? a[1] + a[3] / 2 : a[1];
      const cap = camCap(sj as any, [ox, oy], Math.min(p.push.camTo ?? p.push.to ?? 1.6, 1.6));
      cam = cap;
      push = { anchor: an, camFrom: Math.max(1, Math.min(p.push.camFrom ?? p.push.from ?? 1.35, cap - 0.06)), camTo: cap };
    }
  }
  // En coordenadas ya espejadas (las de la pantalla): sujeto de resolvePlate y caja de la UI espejada
  const sjm = r.subject.d;
  const hbm = hb ? (r.mirror ? [1 - hb.box[0] - hb.box[2], hb.box[1], hb.box[2], hb.box[3]] : hb.box) : null;
  const oxm = r.mirror ? 1 - ox : ox;
  const at = (x: number) => (push ? oxm + (x - oxm) * cam : x);
  const e = L === 'subject-left'
    ? Math.max(sjm ? at(sjm[2]) : 0.46, hbm ? at(hbm[0] + hbm[2]) : 0) + 0.03
    : Math.min(sjm ? at(sjm[0]) : 0.54, hbm ? at(hbm[0]) : 1) - 0.03;
  const eClass = L === 'subject-left'
    ? `svc-e-${Math.min(70, Math.max(30, Math.ceil(e * 50) * 2))}`
    : `svc-e-${Math.min(70, Math.max(30, Math.floor(e * 50) * 2))}`;
  return { r, kind, hb, push, eClass, L };
}
