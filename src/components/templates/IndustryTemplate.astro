---
// IndustryTemplate · T-INDUSTRY (ESPEC-v2 §5.3, §12.2 R2/R3/R4/R5/R7/R11) · ejemplo /industrias/salud/
// Misma plantilla para las 8 industrias (salud es el modelo aprobado): todo sale de la placa usada (o su launchFallback),
// del copy y de sitemap.json; nada depende del sector (el guion de ChatSim sale de src/data/chats/<sector>.json).
// Data-driven: recorre page.sections (src/data/sitemap.json) en su orden y pinta cada id con su componente;
// el texto sale de src/content/paginas/<page.id>.json (área copy). Secciones sin copy o con `_omitir` no se pintan.
//   hero          SharedTake + ImageSection hero (persona/Kain del sector) + chip de prueba anclado a la tableta + IMAGEN ILUSTRATIVA
//   definicion    Intertitle (rack: copia desenfocada de la portada) + DefinitionBlock (texto del banco de FAQ)
//   dolores       DayTimeline "La jornada" (horas ilustrativas, sin cifras)
//   automatizamos Intertitle + ScriptList (6 tareas)
//   kain-sector   ImageSection mid (Kain del lado opuesto, push hacia el panel) + ChatSim registrado; móvil `split` (chat en el flujo)
//   cifras        Montage (con caso) · EditorNote + Montage (sin caso propio: `note` en el copy)
//   servicios     Still ×3 (texto dentro de la penumbra del fotograma, R7)
//   datos         Intertitle con reglas cortas (solo salud, nutrición y finanzas)
//   faq           Intertitle (aura de ondas) + FAQAccordion (sin las "validar"; el FAQPage lo emite SEOHead con las mismas ids)
//   cta-final     Dawn (placa de sitemap.json)
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSection from '../cine/ImageSection.astro';
import SharedTake from '../cine/SharedTake.astro';
import Intertitle from '../cine/Intertitle.astro';
import DayTimeline from '../cine/DayTimeline.astro';
import Montage from '../cine/Montage.astro';
import Dawn from '../cine/Dawn.astro';
import { resolvePlate, anchorStyle, plateReady } from '../cine/plate';
import Breadcrumbs from '../nav/Breadcrumbs.astro';
import Btn from '../ui/Btn.astro';
import Metric from '../ui/Metric.astro';
import Copy from '../ui/Copy.astro';
import ScriptList from '../ui/ScriptList.astro';
import Still from '../ui/Still.astro';
import ChatSim from '../ui/ChatSim.astro';
import DefinitionBlock from '../ui/DefinitionBlock.astro';
import FAQAccordion from '../ui/FAQAccordion.astro';
import EditorNote from '../ui/EditorNote.astro';
import { annotateFigures, esc, getFaqItems } from '../ui/ui-data';
import HeroCtas from './HeroCtas.astro';
import Aura from './Aura.astro';
import { ledeParts, eyebrowRepeatsCrumbs, builtCrumbs } from './heroKit';
import { getPlate, pages, waHref, linkTarget, isBuilt, type Page } from '../../lib/site';
import { METRICS, type MetricId } from '../../lib/metrics';

interface Props { page: Page; copy: any }
const { page, copy } = Astro.props;
const P = page as any;
const C = copy?.sections ?? {};
const dev = import.meta.env.DEV;

/* ── utilidades ─────────────────────────────────────────────────────────── */
const sec = (id: string) => (P.sections as any[]).find((s) => s.id === id);
const cp = (id: string) => (C[id] && !C[id]._omitir ? C[id] : null);
/** Titular de dos voces ({text, soft, lit?}) → HTML con tokens resueltos; `lit` envuelve su subcadena en .lit. */
function headHtml(h: any, lit?: string | null): string {
  if (!h) return '';
  let first = annotateFigures(h.text ?? '');
  const l = lit ?? h.lit;
  if (l && (h.text ?? '').includes(l)) {
    const i = (h.text as string).lastIndexOf(l);
    first = annotateFigures(h.text.slice(0, i)) + `<span class="lit">${esc(l)}</span>` + annotateFigures(h.text.slice(i + l.length));
  }
  return h.soft ? `${first} <span class="soft">${annotateFigures(h.soft)}</span>` : first;
}
const wa = P.secondaryCta?.href ?? waHref(C.hero?.ctaSecondary?.waMessage ?? 'Hola Kain');
const waLabel = (c: any) => c?.ctaSecondary?.label ?? P.secondaryCta?.label ?? 'Escríbele a Kain';

/** Placa de una sección según sitemap.json (id, layout, espejo, respaldo de lanzamiento). */
const plateOf = (id: string) => sec(id)?.plate ?? null;
const resolveSec = (id: string, extra: Record<string, any> = {}) => {
  const p = plateOf(id);
  if (!p) return null;
  return resolvePlate(p.id, { mirror: !!p.mirror, fallbackPlate: p.launchFallback, where: `#${id}`, ...extra });
};

/** Ancla de caja [x, y, w, h] (pantalla, teléfono, tableta) de la placa realmente usada: resolvePlate ya la trae espejada
 *  (anchors[n].box) y anchorStyle(n) da --ax/--ay/--aw/--ah (y sus -m) para registrar UI encima. */
type Box = [number, number, number, number];
function boxAnchor(r: ReturnType<typeof resolvePlate> | null, names: string[]) {
  for (const n of names) {
    const b = r?.anchors?.[n]?.box;
    if (b?.d) return { name: n, d: b.d as Box, m: (b.m as Box | null) ?? null };
  }
  return null;
}
/** Punto con nombre de la placa usada ([x, y], espejado). */
function pointAnchor(r: ReturnType<typeof resolvePlate> | null, name: string): [number, number] | null {
  const a = r?.anchors?.[name]?.d;
  return a ? [a[0], a[1]] : null;
}

/* ── 01 · portada ───────────────────────────────────────────────────────── */
const hero = cp('hero');
const heroPlate = plateOf('hero');
const rHero = resolveSec('hero', { srcsetMax: 2752, mobileMax: 1536 });
const lcpPlate = rHero?.id ?? undefined;
// Una sola .lit por página (§2.3): la del copy; si el copy no la marca, la última palabra de la primera voz del H1.
const heroLit: string | null = hero?.h1?.lit ?? (hero?.h1?.text ? (hero.h1.text as string).trim().split(/\s+/).pop()!.replace(/[.,:;]$/, '') : null);
// H1 largos (D: industrial 63 caracteres, HoReCa 59, belleza 55): un paso menos de tamaño para que el bloque completo
// (crumbs, H1, lede y CTA) quepa en el primer pantallazo de 1280 × 720 a 1920 × 1080 sin invadir el lado del sujeto.
const heroH1Long = `${hero?.h1?.text ?? ''} ${hero?.h1?.soft ?? ''}`.trim().length > 48;
// Fila de CTA de escritorio: scene.ts acota la columna al borde de la caja del sujeto (− 32 px). Si la placa declara que,
// a la altura de los CTA (franja baja, donde ya no está la mano), la zona segura de texto sigue más allá de esa caja
// (belleza: safe.d [.46–.55 × .58–.97] frente al sujeto en .47), la fila puede usar ese hueco (≤ 4vw, siempre ≤ .04 del
// ancho de la placa) y el WhatsApp no cae debajo de la microcopia del primario. Solo con el texto a la izquierda.
const heroCtaBand: boolean = (() => {
  if (!rHero?.id || rHero.aura || rHero.layout !== 'subject-right') return false;
  const sx0 = rHero.subject?.d?.[0];
  const zones: number[][] = ((getPlate(rHero.id) as any)?.safe?.d ?? [])
    .filter((z: any) => Array.isArray(z) && z.length >= 4)
    .map((z: number[]) => (rHero.mirror ? [1 - z[2], z[1], 1 - z[0], z[3]] : z));
  const main = zones.find((z) => z[0] <= 0.12);
  if (typeof sx0 !== 'number' || !main) return false;
  const reach = Math.max(...zones.filter((z) => Math.abs(z[0] - main[2]) <= 0.02 && z[1] <= 0.65 && z[3] >= 0.9).map((z) => z[2]), 0);
  return reach - sx0 >= 0.06;
})();
const heroEyebrow: string = hero?.eyebrow ?? `Industria · ${(P.breadcrumbs as any[])?.at(-1)?.name ?? ''}`;
// R3 · intro móvil: lede ≤ 20 palabras (el resto baja a `more`); la etiqueta repite los crumbs → solo en móvil
const heroLede = ledeParts(hero?.lede, 20);
const heroEyebrowDup = eyebrowRepeatsCrumbs(heroEyebrow, P.breadcrumbs);

// Chip de prueba anclado (solo si el sector tiene caso: hero.chip en el copy). Va en la zona de piso, unido a la tableta
// con una línea guía (§3.8); nunca sobre cara ni torso. Posición: anchors.chip de la placa (plates.json); si la placa aún
// no lo trae, el ancla `fig`.
const chipMetric: MetricId | null = hero?.chip?.metricId && (METRICS as any)[hero.chip.metricId] ? hero.chip.metricId : null;
let chip: null | { x: number; y: number; side: 'right' | 'left'; tx: number; ty: number; target: string; leader: boolean } = null;
if (chipMetric && rHero && !rHero.aura) {
  const rawChip = rHero.id ? getPlate(rHero.id)?.anchors?.chip?.d : null;
  const fig = pointAnchor(rHero, 'fig');
  // El chip vive a la derecha del ancla (en el piso, junto a los pies); en espejo, a su izquierda
  const at: { d: [number, number]; side: 'right' | 'left' } | null = rawChip
    ? { d: [rHero.mirror ? 1 - rawChip[0] : rawChip[0], rawChip[1]], side: (rawChip[2] === -1) !== !!rHero.mirror ? 'left' : 'right' }
    : fig ? { d: fig, side: 'left' } : null;
  const tb = boxAnchor(rHero, ['tableta', 'telefono', 'pantalla']);
  const tp = tb ? ([tb.d[0] + tb.d[2] * 0.5, tb.d[1] + tb.d[3] * 0.62] as [number, number]) : pointAnchor(rHero, 'mano');
  // La línea guía nunca cruza el cuerpo del sujeto: si el punto de origen (sin tableta/teléfono, la mano) queda del otro
  // lado del pecho respecto al chip (HoReCa: mano izquierda, chip a la derecha), el chip va solo, sin línea.
  const cx = pointAnchor(rHero, 'pecho')?.[0];
  const crosses = !!(!tb && at && tp && typeof cx === 'number' && (tp[0] - cx) * (at.d[0] - cx) < 0);
  if (at && tp) chip = { x: at.d[0], y: at.d[1], side: at.side, tx: tp[0], ty: tp[1], target: tb?.name ?? 'mano', leader: !crosses };
}

/* ── 02 · definición (texto del banco de FAQ; si la pregunta aún está en "validar", el texto de la página igual se muestra
       como párrafo, pero NO entra al FAQPage) ── */
const defi = cp('definicion');
let defText: { q: string; a: string } | null = null;
// Solo preguntas aprobadas del banco (getFaqItems excluye las de "validar"); si la pregunta aún no está aprobada, el texto
// propio del copy (definition.text) o nada: nunca el texto crudo de una pregunta pendiente (aviso de copy, ronda 2).
const okFaq = defi?.definition?.faqId ? getFaqItems([defi.definition.faqId])[0] : null;
if (okFaq) defText = { q: defi.definition.heading ?? okFaq.q, a: okFaq.a };
else if (defi?.definition?.text) defText = { q: defi.definition.heading ?? defi.h2?.text, a: defi.definition.text };

/* ── 05 · Kain en el sector ─────────────────────────────────────────────── */
const ks = cp('kain-sector');
const ksPlate = plateOf('kain-sector');
const rKs = resolveSec('kain-sector', { srcsetMax: 2752 });
const panel = boxAnchor(rKs, ['pantalla', 'telefono', 'superficie', 'tableta']);
// §3.7: en móvil, si la superficie mide menos de 180 px de ancho (a 390 px), la conversación baja al flujo del texto (chat
// en línea, .glass-panel) y en la pantalla de la placa queda la miniatura encendida de ChatSim (nunca un cristal vacío).
const panelInPlateM = !!(panel?.m && panel.m[2] * 390 >= 180);
const panelStyle = panel ? anchorStyle(panel.name) : '';
// Columna del texto: empieza donde termina la zona segura de la placa (sujeto + panel ocupan el otro lado).
const ksSafeX: number = (() => {
  const raw = rKs?.id ? getPlate(rKs.id) : null;
  const s = raw?.safe?.d?.[0];
  if (!s) return 0.5;
  return rKs!.mirror ? 1 - s[2] : s[0];
})();
// Móvil `split`: el resto del contenido (chat en línea, límite, nota) empieza DEBAJO de los pies del sujeto (caja subject.m),
// nunca encima: Kain siempre de cuerpo completo y ningún cristal sobre el sujeto (§3.6, §0.1-5).
const ksSubjBottomM: number = (() => {
  const raw = rKs?.id ? getPlate(rKs.id) : null;
  const b = raw?.subject?.m?.[3];
  return typeof b === 'number' && b > 0.5 && b <= 1 ? b : 1;
})();
const ksLayout = rKs?.layout ?? ksPlate?.layout ?? 'subject-left';
// Columna del texto según la placa realmente usada: el borde derecho del panel (con el zoom del pin crece hacia el texto) y
// el inicio de la zona segura. Salud (panel .43, safe .49) queda en la columna por defecto (7 / span 6); inmobiliario (panel
// .48) en la 8 / span 5; HoReCa (panel .52) y el respaldo home-sistema-2-atender (safe .56) en la 9 / span 4.
const ksPanelR: number = panel ? panel.d[0] + panel.d[2] : 0;
const ksCol = ksLayout !== 'subject-left' ? '' : ksSafeX > 0.55 || ksPanelR > 0.5 ? 'ind-kain--c8' : ksPanelR > 0.47 ? 'ind-kain--c7' : '';
// Titulares de escena largos (> 36 caracteres; salud tiene 31): un paso menos para que el bloque quepa mientras está fijado
const ksLong = `${ks?.h2?.text ?? ''} ${ks?.h2?.soft ?? ''}`.trim().length > 36;
// Guion del sector (R2: uno propio por industria): src/data/chats/<guion>.json (área copy). Las 8 industrias ya tienen el
// suyo; si alguno faltara, el guion general (default), nunca el de salud (limpieza dental) en otra industria.
const chatFiles = import.meta.glob('../../data/chats/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const hasChatFile = (k: string) => Object.keys(chatFiles).some((x) => x.endsWith(`/${k}.json`));
const wantedScript: string = ks?.chat?.script ?? (Array.isArray(ks?.chat?.scripts) ? ks.chat.scripts[0] : null) ?? 'default';
const chatScript: string = hasChatFile(wantedScript) || wantedScript === 'salud' ? wantedScript : 'default';

/* ── 06 · cifras ────────────────────────────────────────────────────────── */
const cif = cp('cifras');
const cifIds: MetricId[] = (cif?.rows ?? []).map((r: any) => r.metricId).filter((m: string) => (METRICS as any)[m]);
const caseHero = (href?: string) => {
  if (!href) return undefined;
  const pg = pages.find((x: any) => x.url === href.split('#')[0]) as any;
  return pg?.sections?.find((s: any) => s.plate)?.plate?.id as string | undefined;
};
const stillFor: Partial<Record<MetricId, string>> = {};
for (const id of cifIds) stillFor[id] = caseHero((METRICS as any)[id].href) ?? heroPlate?.id;

/* ── 07 · servicios (Still ×3) ──────────────────────────────────────────── */
const svc = cp('servicios');
// Fotogramas distintos (R7/R13): la portada del destino si ya existe; si no, un suplente con el mismo tema que no se repita
// en la fila (GoHighLevel → la estación Organizar); Kommo sin placa propia → aura con el sello oficial (Still de ui).
// Las placas que la página YA pinta cuentan como tomadas: la planeada y la realmente usada (respaldo de lanzamiento). Sin
// ind-<sector>-kain-sector, la escena 05 usa home-sistema-2-atender en espejo: el still de "Agentes de IA para WhatsApp"
// (cuya portada es esa misma placa) pasa a home-kain (Kain con su teléfono de cristal flotante), nunca la misma toma dos veces.
const STAND_IN: Record<string, string> = { 'gohighlevel-hero': 'home-sistema-3-organizar', 'crm-ia-hero': 'home-sistema-3-organizar', 'n8n-hero': 'home-sistema-4-automatizar', 'home-sistema-2-atender': 'home-kain' };
const svcTaken = new Set<string>([heroPlate?.id, rHero?.id, sec('kain-sector')?.plate?.id, rKs?.id, sec('cta-final')?.plate?.id].filter(Boolean) as string[]);
const svcItems = (svc?.items ?? []).slice(0, 3).map((it: any) => {
  const own = caseHero(it.href);
  const cand = [own, own ? STAND_IN[own] : undefined].find((id) => id && plateReady(id) && !svcTaken.has(id));
  if (cand) svcTaken.add(cand);
  return { ...it, plate: cand };
});

/* ── riel / FAQ / cierre ───────────────────────────────────────────────── */
const datos = cp('datos');
const faq = cp('faq');
const cta = cp('cta-final');
const ctaPlate = plateOf('cta-final');
const order: string[] = (P.sections as any[]).map((s) => s.id);
if (dev) {
  const known = new Set(['hero', 'definicion', 'dolores', 'automatizamos', 'kain-sector', 'cifras', 'servicios', 'datos', 'faq', 'cta-final']);
  for (const id of order) {
    if (!known.has(id)) console.warn(`[IndustryTemplate] ${P.id}: sección "${id}" sin componente en la plantilla`);
    else if (!C[id]) console.warn(`[IndustryTemplate] ${P.id}: falta el copy de la sección "${id}"`);
  }
}
---
<BaseLayout page={page} lcpPlate={lcpPlate} lcpSrcsetMax={2752} bodyClass="ind">
  {order.map((id) => {
    /* ── 01 + 02 · portada y definición en la misma toma (SharedTake) ── */
    if (id === 'hero' && hero && heroPlate) return (
      <SharedTake plate={heroPlate.id} fallbackPlate={heroPlate.launchFallback} mirror={!!heroPlate.mirror}>
        <ImageSection
          id="hero"
          plate={heroPlate.id}
          fallbackPlate={heroPlate.launchFallback}
          mirror={!!heroPlate.mirror}
          height="hero"
          mobile="split"
          priority
          take
          encendido
          class:list={['ind-hero tpl-hero', heroCtaBand && 'ind-hero--cta-band']}
        >
          {/* Crumbs en escritorio; la etiqueta "Industria · Salud" los repite → solo en móvil, donde los crumbs se ocultan (R3) */}
          <Breadcrumbs page={page} items={builtCrumbs(P.breadcrumbs)} class="tpl-mhide" />
          <p class:list={['t-label t-label--cyan eyebrow', heroEyebrowDup && 'tpl-dhide']}><span class="node" aria-hidden="true"></span>{heroEyebrow}</p>
          <h1 id="hero-t" class:list={['t-display-2', heroH1Long && 'ind-h1--long']} data-split set:html={headHtml(hero.h1, heroLit)} />
          {hero.lede && (
            <p class="t-lede t-lede--2"><Copy text={heroLede.intro} />{heroLede.rest && <span class="tpl-mhide"> <Copy text={heroLede.rest} /></span>}</p>
          )}
          <HeroCtas href={hero.ctaPrimary?.href ?? '/discovery/'} label={hero.ctaPrimary?.label ?? 'Agenda tu Discovery Session'}
            waHref={wa} waLabel={waLabel(hero)} />
          {/* QA #46 · escritorios 4:3 a 3:2 (1024 × 768): el chip anclado se recorta y se retira → la prueba va en una línea
              bajo los CTA (solo en ese rango; en móvil la lleva `more` y en panorámico el chip) */}
          {chipMetric && (
            <p class="ind-proof-m ind-proof-43">
              <span class="node" aria-hidden="true"></span>
              <span><Metric id={chipMetric} variant="inline" label link /><span class="ind-proof-m__sep" aria-hidden="true"> · </span><span class="ind-proof-m__ctx">{hero.chip?.context ?? METRICS[chipMetric].ctx}</span></span>
            </p>
          )}
          {hero.illus && <p slot="over" class="chip-illus ind-illus tpl-mhide">{hero.illus}</p>}
          {/* R3 · móvil: después de la placa (misma sección) van la cola del lede y la prueba con su contexto */}
          {(heroLede.rest || chipMetric || hero.illus) && (
            <Fragment slot="more">
              {hero.illus && <p class="chip-illus tpl-illus-m tpl-dhide" aria-hidden="true">{hero.illus}</p>}
              {heroLede.rest && <Copy as="p" class="t-lede t-lede--2 ind-hero__rest tpl-dhide" text={heroLede.rest} />}
              {chipMetric && (
                <p class="ind-proof-m tpl-dhide">
                  <span class="node" aria-hidden="true"></span>
                  <span><Metric id={chipMetric} variant="inline" label link /><span class="ind-proof-m__sep" aria-hidden="true"> · </span><span class="ind-proof-m__ctx">{hero.chip?.context ?? METRICS[chipMetric].ctx}</span></span>
                </p>
              )}
            </Fragment>
          )}
          {chip && (
            <Fragment slot="anchors">
              {chip.leader && <span class="leader ind-leader" data-anchor={`${chip.target} chip`} data-lock aria-hidden="true"
                style={`--ax:${chip.tx};--ay:${chip.ty};--bx:${chip.x};--by:${chip.y};`}></span>}
              {chip.leader && <span class="anchor leader-node ind-leader-node" data-anchor={chip.target} data-lock aria-hidden="true"
                style={`--ax:${chip.tx};--ay:${chip.ty};`}></span>}
              <div class:list={['ind-proof', `ind-proof--${chip.side}`]} data-anchor="chip" style={`--ax:${chip.x};--ay:${chip.y};`}>
                <Metric id={chipMetric!} variant="chip" link class="anchor ind-proof__chip" />
              </div>
            </Fragment>
          )}
        </ImageSection>

        {defi && order.includes('definicion') && (
          <Intertitle id="definicion" rack aura="none" class="ind-def tpl-glow" labelledby={defText ? "definicion-d-q" : undefined}>
            <Aura kind="ondas" x="45%" y="108%" o={1} only="d" />
            {defText ? (
              <DefinitionBlock heading={defText.q} text={defText.a} label={defi.eyebrow ?? 'Definición'} headingLevel={2} id="definicion-d" />
            ) : (
              <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{defi.eyebrow}</p>
            )}
            {(defi.body ?? []).map((b: string) => <Copy as="p" class="t-lede t-lede--2 ind-def__body" text={b} data-reveal />)}
          </Intertitle>
        )}
      </SharedTake>
    );
    if (id === 'definicion') return null; // va dentro de la toma compartida de la portada

    /* ── 03 · la jornada ── */
    if (id === 'dolores') {
      const d = cp('dolores');
      if (!d?.entries?.length) return null;
      return (
        <DayTimeline id="dolores" entries={d.entries} rack={rHero?.rack ?? undefined} class="ind-day tpl-glow">
          <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{d.eyebrow}</p>
          <h2 id="dolores-t" class="t-h2" data-split set:html={headHtml(d.h2)} />
          {d.lede && <Copy as="p" class="t-lede t-lede--2 ind-day__lede" text={d.lede} data-reveal />}
        </DayTimeline>
      );
    }

    /* ── 04 · qué automatizamos ── */
    if (id === 'automatizamos') {
      const a = cp('automatizamos');
      if (!a?.items?.length) return null;
      return (
        <Intertitle id="automatizamos" aura="none" class="ind-auto tpl-glow">
          {/* QA #39: el aura del isotipo vive en una caja de bordes disueltos (tpl-aura-box): la sección ya no la recorta con
              un filo recto contra la jornada */}
          <Aura kind="isotipo" x="76%" y="20%" w="min(62vw,920px)" o={0.85} only="d" />
          <div class="ind-auto__head">
            <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{a.eyebrow}</p>
            <h2 id="automatizamos-t" class="t-h2" data-split set:html={headHtml(a.h2)} />
            {a.lede && <Copy as="p" class="t-lede t-lede--2" text={a.lede} data-reveal />}
          </div>
          <Aura kind="ondas" x="40%" y="104%" o={1} only="d" />
          <Aura kind="ondas" x="50%" o={1} only="m" sticky />
          <ScriptList rows={a.items.map((r: any) => ({ n: r.n, title: r.title, line: r.line, href: r.href ? linkTarget(r.href) ?? undefined : undefined }))} label={a.eyebrow} class="ind-auto__list" />
        </Intertitle>
      );
    }

    /* ── 05 · así trabaja Kain en el sector ── */
    if (id === 'kain-sector') {
      if (!ks || !ksPlate) return null;
      return (
        <ImageSection
          id="kain-sector"
          plate={ksPlate.id}
          fallbackPlate={ksPlate.launchFallback}
          mirror={!!ksPlate.mirror}
          height="mid"
          mobile={ksPlate.mobile === 'below' ? 'below' : 'split'}
          push={{ anchor: panel?.name ?? 'pantalla', to: 1.6 }}
          pin="+=100%"
          class={['ind-kain', ksCol, ksLong && 'ind-kain--long'].filter(Boolean).join(' ')}
        >
          <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{ks.eyebrow}</p>
          <h2 id="kain-sector-t" class="t-h2" data-split set:html={headHtml(ks.h2)} />
          {ks.lede && <Copy as="p" class="t-lede t-lede--2" text={ks.lede} />}
          <div slot="more" class="ind-kain__more" style={`--sb:${ksSubjBottomM}`}>
            {!panelInPlateM && <div class="only-m ind-kain__chat"><ChatSim mode="inline" script={chatScript} aura={false} note={false} id="ks-chat-m" /></div>}
            {ks.limite && (
              <p class="ind-limit"><span class="node" aria-hidden="true"></span><Copy text={ks.limite} /></p>
            )}
            {ks.note && <Copy as="p" class="t-micro ind-kain__note" text={ks.note} />}
          </div>
          {/* §3.7: en móvil (superficie < 180 px) la UI baja al flujo; la placa ya trae su cristal encendido */}
          {panel && (
            <div slot="anchors" class:list={['anchor anchor--panel ind-panel', !panelInPlateM && 'ind-panel--mini']} data-anchor={panel.name} data-lock
              data-m={panel.m ? undefined : 'none'} style={panelStyle}>
              {/* Escritorio: el guion avanza con el scroll de la escena fijada (una burbuja por tramo); móvil: miniatura */}
              <ChatSim mode="registered" script={chatScript} note={false} control="external" id="ks-chat" />
            </div>
          )}
        </ImageSection>
      );
    }

    /* ── 06 · cifras ── */
    if (id === 'cifras') {
      if (!cif || !cifIds.length) return null;
      return (
        <Montage id="cifras" ids={cifIds} transversal={cif.transversal} stillFor={stillFor} class="ind-cifras tpl-glow">
          <Aura kind="ondas" x="50%" y="6%" o={1} clip />
          <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{cif.eyebrow}</p>
          <h2 id="cifras-t" class="t-h2" data-split set:html={headHtml(cif.h2)} />
          {cif.lede && <Copy as="p" class="t-lede t-lede--2 ind-cifras__lede" text={cif.lede} data-reveal />}
          {cif.note && (
            <EditorNote label={cif.noteLabel ?? 'Nota del editor'} class="ind-cifras__enote"><Copy as="p" text={cif.note} /></EditorNote>
          )}
          <Fragment slot="foot">
            {(cif.links ?? []).filter((l: any) => l?.href && isBuilt(l.href)).map((l: any) => <a class="lnk" href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
          </Fragment>
        </Montage>
      );
    }

    /* ── 07 · servicios recomendados ── */
    if (id === 'servicios') {
      if (!svcItems.length) return null;
      return (
        <section id="servicios" class="ind-sec ind-svc tpl-glow" aria-labelledby="servicios-t">
          <Aura kind="isotipo" x="18%" y="12%" o={0.9} clip />
          <div class="frame ind-sec__head">
            <div class="ind-sec__intro">
              <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{svc.eyebrow}</p>
              <h2 id="servicios-t" class="t-h2" data-split set:html={headHtml(svc.h2)} />
            </div>
          </div>
          <div class="frame ind-svc__grid" data-reveal="stagger">
            {svcItems.map((it: any) => (
              <Still href={it.href} plate={it.plate} label={it.label} title={it.title} line={it.line} />
            ))}
          </div>
        </section>
      );
    }

    /* ── 08 · tus datos ── */
    if (id === 'datos') {
      if (!datos) return null;
      return (
        <Intertitle id="datos" aura="none" layout="split" class="ind-datos tpl-glow">
          {/* Contraste AA (el titular es fijo y pasaba sobre el núcleo del isotipo) y menos isotipos repetidos (QA #52): ondas
              tenues bajo el titular, en su caja de bordes disueltos */}
          <Aura kind="ondas" x="24%" y="80%" w="min(96vw,1400px)" o={0.75} only="d" />
          <Fragment slot="head">
            <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{datos.eyebrow}</p>
            <h2 id="datos-t" class="t-h2" data-split set:html={headHtml(datos.h2)} />
            {datos.lede && <Copy as="p" class="t-lede t-lede--2" text={datos.lede} data-reveal />}
          </Fragment>
          <Aura kind="ondas" x="50%" o={1} only="m" sticky />
          {datos.items?.length > 0 && (
            <ol class="ind-rules" role="list" data-reveal="stagger">
              {datos.items.map((it: any, i: number) => (
                <li class="ind-rules__item">
                  <span class="ind-rules__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="ind-rules__t"><Copy text={it.title} /></h3>
                  <Copy as="p" class="ind-rules__l" text={it.line} />
                </li>
              ))}
            </ol>
          )}
          {datos.note && <Copy as="p" class="t-micro ind-datos__note" text={datos.note} data-reveal />}
        </Intertitle>
      );
    }

    /* ── 09 · preguntas frecuentes ── */
    if (id === 'faq') {
      if (!faq?.faqIds?.length) return null;
      return (
        <Intertitle id="faq" aura="ondas" layout="split" class="ind-faq tpl-glow">
          <Fragment slot="head">
            <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{faq.eyebrow}</p>
            <h2 id="faq-t" class="t-h2" data-split set:html={headHtml(faq.h2)} />
            {faq.footer && <Copy as="p" class="t-lede t-lede--2 ind-faq__foot" text={faq.footer} data-reveal />}
            {faq.footer && <div class="ind-faq__cta" data-reveal><Btn variant="ghost" href={wa} label={waLabel(cta ?? hero)} /></div>}
          </Fragment>
          <Aura kind="ondas" x="50%" y="104%" o={1} only="d" />
          <FAQAccordion ids={faq.faqIds} glass id="faq-list" label={faq.eyebrow} />
        </Intertitle>
      );
    }

    /* ── 10 · cierre ── */
    if (id === 'cta-final') {
      if (!cta) return null;
      return (
        <Dawn id="cta-final" plate={ctaPlate?.id ?? 'cta-amanecer'} mirror={!!ctaPlate?.mirror} fallbackPlate={ctaPlate?.launchFallback} layout={ctaPlate?.layout} class="tpl-glow-m">
          {cta.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{cta.eyebrow}</p>}
          <h2 id="cta-final-t" class="t-h2" data-split set:html={headHtml(cta.h2)} />
          {cta.lede && <Copy as="p" class="t-lede t-lede--2" text={cta.lede} />}
          <div class="ctas">
            {cta.micro ? (
              <div class="cta-p">
                <Btn variant="primary" href={cta.ctaPrimary?.href ?? '/discovery/'} label={cta.ctaPrimary?.label ?? 'Agenda tu Discovery Session'} />
                <Copy as="p" class="t-micro btn-micro" text={cta.micro} data-allow-number />
              </div>
            ) : (
              <Btn variant="primary" href={cta.ctaPrimary?.href ?? '/discovery/'} label={cta.ctaPrimary?.label ?? 'Agenda tu Discovery Session'} micro />
            )}
            <Btn variant="ghost" href={wa} label={waLabel(cta)} />
          </div>
        </Dawn>
      );
    }
    return null;
  })}
</BaseLayout>
<script>
  // Regla de un azul (respaldo local; pedido en peticiones.md · "Construcción · industrias (plantilla)"): ui.ts vuelve a medir
  // el primario visible en cada evento de scroll, pero la entrada del cierre (Dawn) termina DESPUÉS del último scroll → el CTA
  // del encabezado se quedaba azul junto al primario del amanecer. Cuando el scroll se asienta, se piden re-mediciones
  // mientras dura la entrada (≈ 3 s). Sin efecto si nada cambió (ui.ts solo alterna el atributo cuando hace falta).
  let settle: number[] = [];
  const ping = () => document.dispatchEvent(new CustomEvent('cine:primary-change', { detail: { source: 'industria' } }));
  addEventListener('scroll', () => {
    settle.forEach((t) => clearTimeout(t));
    settle = [180, 520, 950, 1500, 2200, 3000].map((ms) => window.setTimeout(ping, ms));
  }, { passive: true });
</script>
