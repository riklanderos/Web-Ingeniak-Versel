---
// HubMap · /servicios/#mapa (ESPEC §5.5: "línea del sistema (5 nodos) + ScriptList de los 11 servicios por etapa").
// Escritorio: a la izquierda (fija mientras corre la lista) el riel del sistema con sus 5 etapas; la etapa cuyo grupo
// está en pantalla se enciende y el pilar se llena hasta ella. A la derecha, las filas de guion por etapa (ScriptList con
// fotograma que sigue al cursor). Móvil: el riel va en horizontal bajo el titular, sin fijar.
// Sin JS: el riel queda estático (todo visible); con JS sus etapas son botones que llevan a su grupo.
import Intertitle from '../../cine/Intertitle.astro';
import ScriptList from '../../ui/ScriptList.astro';
import Copy from '../../ui/Copy.astro';
import Icon from '../../ui/Icon.astro';
import Aura from '../Aura.astro';
import { heroPlateOf } from '../../layout/navData';
import { linkTarget } from '../../../lib/site';
import { head, inWords } from './hubKit';

interface Props { id: string; c: any }
const { id, c } = Astro.props;
const groups = ((c.groups ?? []) as any[]).map((g) => ({
  label: g.label,
  glyph: g.glyph,
  line: g.line,
  rows: ((g.items ?? []) as any[]).map((it) => ({
    title: it.title,
    line: it.line,
    metricId: it.metricId,
    href: it.href ? linkTarget(it.href) ?? undefined : undefined,
    plate: it.href ? heroPlateOf(it.href) : undefined,
  })),
}));
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---
<Intertitle id={id} aura="none" layout="split" class="hub-map tpl-glow">
  <Fragment slot="head">
    <div class="hub-map__head">
      {c.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{c.eyebrow}</p>}
      <h2 id={`${id}-t`} class="t-h2" data-split set:html={head(c.h2)} />
      {c.lede && <Copy as="p" class="t-lede t-lede--2 hub-map__lede" text={c.lede} data-reveal />}
      <nav class="hub-spine" aria-label={`Las ${inWords(groups.length)} etapas del sistema`} data-hub-spine>
        <span class="hub-spine__pillar" aria-hidden="true"><span class="hub-spine__fill"></span></span>
        <ol class="hub-spine__list" role="list">
          {groups.map((g, i) => (
            <li class="hub-spine__st" data-i={i} style={`--i:${i}`}>
              <button class="hub-spine__btn" type="button" data-hub-stage={i} disabled aria-label={`${g.label}: ${inWords(g.rows.length)} ${g.rows.length === 1 ? 'servicio' : 'servicios'}`}>
                <span class="hub-spine__node" aria-hidden="true"></span>
                {g.glyph && <Icon name={g.glyph} size={20} class="hub-spine__glyph" />}
                <span class="hub-spine__name">{g.label}</span>
                <span class="hub-spine__n t-label" aria-hidden="true">{String(g.rows.length).padStart(2, '0')}</span>
              </button>
              {g.line && <span class="hub-spine__line">{g.line}</span>}
            </li>
          ))}
        </ol>
      </nav>
      {c.closing && <Copy as="p" class="hub-map__closing" text={c.closing} data-reveal />}
    </div>
  </Fragment>
  <Aura kind="isotipo" x="8%" y="10%" o={0.85} only="d" />
  <Aura kind="ondas" x="60%" y="96%" o={1} only="d" />
  <Aura kind="ondas" x="50%" o={1} only="m" sticky />
  <ScriptList groups={groups} followStill label={`Los ${inWords(total)} servicios de Ingeniak por etapa`} class="hub-map__list" />
</Intertitle>

<script>
  // Riel del mapa: enciende la etapa cuyo grupo está en pantalla y llena el pilar hasta ella. Con movimiento reducido el
  // estado cambia sin transición (CSS). Las etapas pasan a botones que llevan a su grupo.
  const spine = document.querySelector<HTMLElement>('[data-hub-spine]');
  const blocks = spine ? [...(spine.closest('section')?.querySelectorAll<HTMLElement>('.script__block') ?? [])] : [];
  if (spine && blocks.length) {
    const items = [...spine.querySelectorAll<HTMLElement>('.hub-spine__st')];
    const btns = [...spine.querySelectorAll<HTMLButtonElement>('[data-hub-stage]')];
    let cur = -1;
    const set = (i: number) => {
      if (i === cur) return;
      cur = i;
      items.forEach((li, k) => { li.classList.toggle('is-on', k === i); li.classList.toggle('is-past', k < i); });
      btns.forEach((b, k) => (k === i ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
      spine.style.setProperty('--hub-fill', String(items.length > 1 ? i / (items.length - 1) : 1));
    };
    blocks.forEach((b, i) => { if (!b.id) b.id = `mapa-etapa-${i + 1}`; });
    btns.forEach((b, i) => {
      b.disabled = false;
      b.addEventListener('click', () => {
        const t = blocks[i];
        if (!t) return;
        const lenis = (window as any).__lenis;
        const off = -((parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hdr')) || 72) + 24);
        if (lenis) lenis.scrollTo(t, { offset: off });
        else window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY + off, behavior: 'smooth' });
        t.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      });
    });
    const ratios = new Map<Element, number>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => ratios.set(e.target, e.isIntersecting ? e.intersectionRect.height : 0));
      let best = -1, bestH = 0;
      blocks.forEach((b, i) => { const h = ratios.get(b) ?? 0; if (h > bestH) { bestH = h; best = i; } });
      if (best >= 0) set(best);
    }, { rootMargin: '-30% 0px -30% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });
    blocks.forEach((b) => io.observe(b));
    set(0);
  }
</script>
