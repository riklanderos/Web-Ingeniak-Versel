---
// CaseTemplate · T-CASE (ESPEC §5.4, §5.4.1, §12.2 R2/R8/R11). Caso de estudio como reportaje.
// Datos: src/data/sitemap.json (URL, H1, placas, breadcrumbs, CTAs, publishGate) + src/content/paginas/<page.id>.json (texto).
// Sirve a todos los casos: cada sección se pinta en el orden de sitemap.sections y solo si su copy existe y no trae `_omitir`.
//   01 hero          ImageSection hero (persona a la derecha) + Breadcrumbs + H1 en 3 voces (kicker · cifra mega · texto);
//                    H1 y lede acotados a la zona segura de la placa en escritorio; hero.ledeM = lede corto del intro móvil
//   02 ficha         entradilla (.t-standfirst) + EntitySheet variant="case" (Quick Jump: el riel muestra etiquetas en casos)
//   03 punto-partida Prose + nota al margen en ámbar
//   04 cifra         CaseFigure (variante de §5.4.1; fijada +100 % en escritorio). index/multiplier/nodes: en escritorio la
//                    escena va a la derecha del texto (pages.css); envuelta en case/CaseFigureLocal (el "$" de multiplier)
//   05 implementacion SystemFlow (los nodos con confirmed:false no se publican)
//   06 resultado     ImageSection mid (Kain del lado opuesto) + agenda registrada sobre el panel de cristal (SIMULACIÓN)
//   07 vktor         VktorRail (hitos confirmados → "milestones"; si no, fases genéricas)
//   08 replicar      ScriptList (3 filas) + enlace a la industria
//   09 testimonio    condicional: SOLO con aprobación escrita (copy.testimonio.aprobacion + frase + nombre). Si no, no existe.
//   10 relacionados  ScriptList (servicio e industria) + Still variant="next" (Siguiente reportaje)
//   11 cta-final     Dawn
// Puerta R2: si sitemap trae publishGate y el copy no lo marca como confirmado (copy.publishGate.ok === true),
// la página sale como "caso breve". Su indexación se autoriza aparte con publishGate.indexBrief (indexacion.mjs).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageSection from '../cine/ImageSection.astro';
import CaseFigure from '../cine/CaseFigure.astro';
import CaseFigureLocal from './case/CaseFigureLocal.astro';
import Dawn from '../cine/Dawn.astro';
import { resolvePlate, AURA_ISOTIPO, AURA_ONDAS, type Resolved } from '../cine/plate';
import Breadcrumbs from '../nav/Breadcrumbs.astro';
import Btn from '../ui/Btn.astro';
import HeroCtas from './HeroCtas.astro';
import { primaryLabel as quoteLabel, quoteLink } from '../layout/cta';
import Aura from './Aura.astro';
import { builtCrumbs } from './heroKit';
import Copy from '../ui/Copy.astro';
import Metric from '../ui/Metric.astro';
import EntitySheet from '../ui/EntitySheet.astro';
import SystemFlow from '../ui/SystemFlow.astro';
import VktorRail from '../ui/VktorRail.astro';
import ScriptList from '../ui/ScriptList.astro';
import Still from '../ui/Still.astro';
import Icon from '../ui/Icon.astro';
import Prose from '../content/Prose.astro';
import Quote from '../content/Quote.astro';
import { getCopy, getPage, getPlate, waHref, resolveTokens, SITE, linkTarget, pageNoindex, type Page } from '../../lib/site';
import { CASE_BRIEF_SECTIONS } from '../../lib/indexacion.mjs';
import { METRICS, SOURCE_NOTE, type MetricId } from '../../lib/metrics';

interface Props { page: Page; devCompleto?: boolean }
const page = Astro.props.page as any;
const copy = getCopy(page.id);
const C: Record<string, any> = copy.sections ?? {};
const sitemapSecs: any[] = page.sections ?? [];
const plateOf = (id: string) => sitemapSecs.find((s) => s.id === id)?.plate ?? null;

// ── Qué secciones existen ─────────────────────────────────────────────────────
// testimonio (y cualquier sección "conditional"): solo con aprobación escrita registrada en el copy.
const approved = (c: any) => !!(c?.aprobacion && c?.frase && c?.nombre);
const shows = (s: any) => {
  const c = C[s.id];
  if (!c || c._omitir) return false;
  if (s.status === 'conditional') return approved(c);
  return true;
};
// ── Puerta de publicación (R2) ───────────────────────────────────────────────
// Caso breve (QA #54): mientras ficha, punto de partida e implementación no estén confirmados por escrito, la página solo
// pinta portada, ficha (filas confirmadas), CaseFigure, qué puedes replicar, relacionados y cierre. La indexación no abre esta puerta editorial.
// Lo no confirmado no llega al HTML público (no basta con noindex).
// Solo en desarrollo: /casos/<slug>--completo/ (casos/[slug].astro) pinta la versión completa de un caso breve para revisar
// su maqueta (implementación, resultado y VKTOR con sus placas o su launchFallback) antes de que el cliente abra la puerta.
// Esa ruta no existe en el build y sale en noindex.
const devCompleto = import.meta.env.DEV && Astro.props.devCompleto === true;
const breve = !!page.publishGate && copy.publishGate?.ok !== true && !devCompleto;
const BREVE = CASE_BRIEF_SECTIONS;
const order: string[] = sitemapSecs.filter(shows).map((s) => s.id).filter((id) => !breve || BREVE.includes(id));

// ── Utilidades ───────────────────────────────────────────────────────────────
// Etiqueta del primario «Cotizar proyecto» (CAMBIO-COTIZAR §1): copy → _comun.cta.cotizar, nunca la variante de sitemap.json
// ni la heredada de la Discovery (regla de un azul, §0.1). El destino siempre es el modal (data-cotizar).
const primaryLabel = (c: any): string => quoteLabel(c);
// El mensaje de WhatsApp acepta los mismos tokens que el copy ({{metric:ID}}, |full, |prose): una cifra del mensaje sale de
// metrics.ts, nunca escrita a mano (§0.1-2)
const wa = (msg?: string) => (msg ? waHref(resolveTokens(msg)) : page.secondaryCta?.href ?? waHref('Hola Kain, quiero información.'));
/** Enlaces del cuerpo (R12 · QA enlaces): solo rutas construidas; una planeada se pinta como texto (nunca '#'). */
const hrefOr = (h?: string) => (h ? linkTarget(h) ?? undefined : undefined);
const TOKEN = /\{\{metric:([a-z0-9-]+)(?:\|full)?\}\}/g;
const metricIdsIn = (s: string): MetricId[] => [...String(s ?? '').matchAll(TOKEN)].map((m) => m[1] as MetricId);
const H2 = (h: any) => h ?? { text: '' };
// Duración de la Discovery ("30 minutos") en titulares: no es cifra comercial → data-allow-number (check-cifras, §8.6).
const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const allowDur = (s: string) => esc(s).replace(/\b(\d+\s?(?:minutos|min))\b/g, '<span data-allow-number>$1</span>');

// Panel de cristal de la placa (ancla con caja [x, y, w, h]) para registrar UI encima (§3.7). Respeta el espejo.
const BOX_ANCHORS = ['pantalla', 'telefono', 'tableta', 'superficie'];
function panelOf(r: Resolved | null) {
  const raw: any = r?.id ? getPlate(r.id) : null;
  const name = BOX_ANCHORS.find((n) => raw?.anchors?.[n]?.d?.length === 4);
  if (!raw || !name) return null;
  const mir = (b: number[]) => (r!.mirror ? [+(1 - b[0] - b[2]).toFixed(4), b[1], b[2], b[3]] : b);
  const d = mir(raw.anchors[name].d);
  const m = raw.anchors[name].m?.length === 4 ? mir(raw.anchors[name].m) : null;
  const style = `--ax:${d[0]};--ay:${d[1]};--aw:${d[2]};--ah:${d[3]};` + (m ? `--ax-m:${m[0]};--ay-m:${m[1]};--aw-m:${m[2]};--ah-m:${m[3]};` : '');
  return { name, style, mobile: !!m };
}

// ── 01 Portada ───────────────────────────────────────────────────────────────
const hero = C.hero ?? {};
const heroPlate = plateOf('hero');
const heroR = heroPlate ? resolvePlate(heroPlate.id, { mirror: heroPlate.mirror, fallbackPlate: heroPlate.launchFallback }) : null;
const h1 = hero.h1 ?? {};
const ledeFig = /\{\{metric:/.test(hero.lede ?? '');   // el lede lleva cifra → llamada ¹ a la nota de fuente
// Móvil (R3): hero.ledeM (opcional) es la versión corta del lede para el intro; el lede completo queda en escritorio.
// Sin ledeM no cambia nada (caso dental).
const ledeM: string | null = hero.ledeM ?? null;
const ledeMFig = /\{\{metric:/.test(ledeM ?? '');
// Zona segura de la portada (escritorio, QA casos). El titular (y la cifra mega) no pasan del borde de la zona segura de texto
// de la placa (safe.d) en su franja (y 0.2–0.8; retail: 0.42 aunque arriba y abajo llegue a 0.56): --case-edge, fracción de la
// placa; pages.css lo proyecta con la geometría "cover" de la portada (como cine.css safeCol, sobre el alto de pantalla, sin
// realimentarse con el alto real). El lede se acota igual (.case-edge, con la tolerancia de la zona segura). La columna completa
// NO se acota: los CTA ya caben y, si la portada crece, la placa crece y el borde se corre (la realimentación que vimos con
// safeCol a 1280 × 720).
//   --fig-em: ancho de la cifra mega en em (fuente display a -0.065em; las letras van en .metric__word a .34em): se encoge si no cabe.
//   --txt-em: ancho del texto del H1 en una línea, en em; solo en titulares cortos (≤ 13 em): en escritorios bajos (≤ 820 px de
//   alto) el texto se ajusta a una línea en lugar de partirse (la portada no crece; HoReCa: "sostenido con paid media").
const heroRaw: any = heroR?.id ? getPlate(heroR.id) : null;
const zonesD: number[][] = heroR && !heroR.mirror && (heroR.layout ?? 'subject-right') === 'subject-right'
  ? (heroRaw?.safe?.d ?? []).filter((z: any) => Array.isArray(z) && z.length >= 4 && z[0] <= 0.12) : [];
const edgeAll = zonesD.length ? Math.max(...zonesD.map((z) => z[2])) : null;
const bandZ = zonesD.filter((z) => z[1] < 0.8 && z[3] > 0.2);
const edgeText = bandZ.length ? Math.min(...bandZ.map((z) => z[2])) : edgeAll;
const figEm = (v: string) => +[...String(v ?? '')].reduce((n, ch) => n + (/\d/.test(ch) ? 0.46 : /[.,]/.test(ch) ? 0.2
  : /[+\-−]/.test(ch) ? 0.5 : ch === '%' ? 0.62 : ch === '×' ? 0.32 : ch === ' ' ? 0.12 : /\p{L}/u.test(ch) ? 0.25 : 0.5), 0).toFixed(2);
const txtEm = +[...String(h1.text ?? '')].reduce((n, ch) => n + (/\s/.test(ch) ? 0.3 : 0.53), 0).toFixed(2);
const h1Vars = [
  edgeText !== null && `--case-edge:${edgeText}`,
  h1.metricId && (METRICS as any)[h1.metricId] && `--fig-em:${Math.max(0.9, figEm((METRICS as any)[h1.metricId].value))}`,
  txtEm > 0 && txtEm <= 13 && `--txt-em:${txtEm}`,
].filter(Boolean);
const h1Style = h1Vars.length ? h1Vars.join(';') : undefined;
// Tableta vertical (QA casos · logística a 1024 × 1366): si en la placa vertical hay ≥ 0.04 entre el final de la zona segura
// (safe.m) y la cabeza del sujeto (subject.m), la última línea del intro ('Escríbele a Kain') quedaba en esa franja. data-case-gap
// agranda el aire bajo el intro solo en pantallas de 600 px o más (pages.css); en teléfono sigue en 30 px.
const safeM: number[][] = (heroRaw?.safe?.m ?? []).filter((z: any) => Array.isArray(z) && z.length >= 4 && z[1] < 0.2);
const heroGapM = !!heroRaw?.subject?.m && safeM.length > 0 && Math.round((heroRaw.subject.m[1] - Math.max(...safeM.map((z) => z[3]))) * 1000) >= 40;

// ── 02 Ficha ─────────────────────────────────────────────────────────────────
const ficha = C.ficha ?? {};
// Filas con tokens de cifra → salen como filas "Cifra" con <Metric> (EntitySheet imprime el resto como texto).
// Caso breve: solo filas con confirmed:true en el copy (y las cifras, que salen de metrics.ts). Si el copy aún no marca la
// ciudad/sector, la ficha dice el contexto de la cifra tal como lo registra metrics.ts y su fuente (SOURCE_NOTE): nada se rellena.
const textRows = (ficha.entity ?? []).filter((r: any) => !/\{\{/.test(r.value) && (!breve || r.confirmed === true));
const ctxMetric = h1.metricId && (METRICS as any)[h1.metricId] ? (METRICS as any)[h1.metricId] : null;
const fichaRows = [
  ...(breve && !textRows.length && ctxMetric?.ctx ? [{ term: 'Caso', value: ctxMetric.ctx }] : []),
  ...textRows.map((r: any) => ({ ...r, href: hrefOr(r.href) })),
  ...(breve ? [{ term: 'Fuente de las cifras', value: SOURCE_NOTE }] : []),
];
// Entradilla: en el caso breve, la versión breve del copy si existe (deckBreve); el texto lo valida el área copy
const fichaDeck: string | null = (breve ? ficha.deckBreve ?? ficha.deck : ficha.deck) ?? null;
const fichaMetrics = [...new Set((ficha.entity ?? []).flatMap((r: any) => metricIdsIn(r.value)))] as MetricId[];
const rack = heroR?.rack ?? null;

// ── 04 Cifra ─────────────────────────────────────────────────────────────────
const cifra = C.cifra ?? {};
const VARIANT_BY_METRIC: Record<string, any> = {
  'dental-respuesta': 'stopwatch', 'dental-citas': 'stopwatch', 'retail-conversiones': 'index-up',
  'ecom-cpl': 'index-down', 'horeca-roas': 'multiplier', 'logistica-procesos': 'nodes',
};
const cifraIds: MetricId[] = cifra.metricIds ?? (h1.metricId ? [h1.metricId] : []);
const cifraVariant = cifra.figure?.variant ?? VARIANT_BY_METRIC[cifraIds[0]] ?? 'stopwatch';

// ── 05 Implementación ────────────────────────────────────────────────────────
const impl = C.implementacion ?? {};
// Los nodos sin confirmar (confirmed:false) no se publican: ni en el HTML ni en el JSON-LD (§5.4 #05, R2)
const flowNodes = (impl.nodes ?? []).filter((n: any) => n.confirmed !== false).map((n: any) => ({
  label: n.label, line: n.line, logo: n.logo ?? n.logos?.[0], kain: /\bkain\b/i.test(n.label), confirmed: true,
}));

// ── 06 Resultado ─────────────────────────────────────────────────────────────
const res = C.resultado ?? {};
const resPlate = plateOf('resultado');
const resR = resPlate ? resolvePlate(resPlate.id, { mirror: resPlate.mirror, layout: resPlate.layout, fallbackPlate: resPlate.launchFallback }) : null;
const panel = panelOf(resR);
const ui = res.ui ?? null;
// Casillas de la agenda: patrón fijo e ilustrativo (SIMULACIÓN; no es un dato). 4 horarios por día.
const LIT = ['1011', '1101', '0111', '1110', '1011', '1100', '0110'];
let litIndex = 0;
const agenda = (ui?.days ?? []).map((d: string, i: number) => ({
  d, slots: [...(LIT[i % LIT.length])].map((c) => (c === '1' ? { on: true, k: litIndex++ } : { on: false, k: -1 })),
}));

// ── 07 VKTOR ─────────────────────────────────────────────────────────────────
const vk = C.vktor ?? {};
const vkMilestones: (string | null)[] | null = Array.isArray(vk.milestones) && vk.milestones.some(Boolean) ? vk.milestones : null;
const vkLink = vk.links?.[0];

// ── 08 Replicar ──────────────────────────────────────────────────────────────
const rep = C.replicar ?? {};

// ── 09 Testimonio (condicional) ──────────────────────────────────────────────
const testi = C.testimonio ?? {};

// ── 10 Relacionados + Siguiente reportaje ────────────────────────────────────
const rel = C.relacionados ?? {};
const next = rel.next ?? null;
let nextPlate: string | undefined;
// Siguiente reportaje: solo si el caso siguiente ya existe (si no, no se anuncia una puerta cerrada)
const nextHref = next?.href ? linkTarget(next.href) : null;
if (nextHref) {
  try { nextPlate = (getPage(next.href) as any).sections?.find((s: any) => s.id === 'hero')?.plate?.id; } catch { nextPlate = undefined; }
}

// ── 11 Cierre ────────────────────────────────────────────────────────────────
const cta = C['cta-final'] ?? {};
const ctaPlate = plateOf('cta-final');

// ── JSON-LD (Article de SEOHead + about → Service de la ficha; autor = Organization hasta confirmar, R8) ──
const svcRow = (ficha.entity ?? []).find((r: any) => /^\/servicios\//.test(r.href ?? '') && (!breve || r.confirmed === true));
// about → Service del Article de SEOHead (nav · articleAbout): un solo nodo Article en el @graph
const articleAbout = svcRow
  ? { '@type': 'Service', '@id': `${SITE.url}${svcRow.href}#service`, name: svcRow.value, url: `${SITE.url}${svcRow.href}` }
  : undefined;
const dates = copy.actualizado ? { datePublished: copy.publicado ?? copy.actualizado, dateModified: copy.actualizado } : {};

// ── Riel "Quick Jump" (§4.7, §5.4 #02): Contexto · Reto · Cifra · Solución · Resultado · VKTOR · Replicar ──
// nav ya oculta las etiquetas del riel sobre la portada (html:not([data-fold])): el riel vuelve a tener todas las escenas.
// QA #57: sin portada, relacionados ni cierre (la etiqueta más larga pasa a ser "Resultado" y el riel no pisa el contenido)
const NOT_IN_RAIL: string[] = ['hero', 'relacionados', 'cta-final', 'testimonio'];
const rail = order.filter((id) => !NOT_IN_RAIL.includes(id))
  .map((id) => ({ id, label: C[id]?.rail ?? sitemapSecs.find((s) => s.id === id)?.name ?? id }));
---
<BaseLayout
  page={page}
  lcpPlate={heroR?.id ?? undefined}
  lcpSrcsetMax={heroPlate?.srcsetMax}
  noindex={pageNoindex(page) || devCompleto}
  articleAbout={articleAbout}
  rail={rail.length > 1 ? rail : false}
  railMode="labels"
  {...dates}
  bodyClass="t-case"
>
  {order.map((id) => {
    /* ───────────── 01 · Portada ───────────── */
    if (id === 'hero') return (
      <ImageSection
        id="hero"
        plate={heroPlate?.id ?? 'caso-hero'}
        layout={heroPlate?.layout}
        mirror={heroPlate?.mirror}
        mobile="split"
        srcsetMax={heroPlate?.srcsetMax}
        fallbackPlate={heroPlate?.launchFallback}
        height="hero"
        priority
        data-case-gap={heroGapM ? '' : undefined}
        class="case-hero tpl-hero tpl-glow"
      >
        {/* R3: en móvil el intro es solo H1 + lede + CTAs (crumbs fuera); la fila de datos baja a `more` en una línea */}
        <Breadcrumbs page={page} items={builtCrumbs(page.breadcrumbs)} class="tpl-mhide" />
        <span class="tpl-introglow" aria-hidden="true"></span>
        <span class="case-hero__floor" aria-hidden="true"></span>
        <h1 id="hero-t" class="case-h1" style={h1Style}>
          {h1.kicker && <span class="t-h4 case-h1__kicker">{h1.kicker}</span>}
          {' '}
          {h1.metricId && <Metric id={h1.metricId} variant="mega" label={false} as="span" class="case-h1__fig lit" />}
          {' '}
          <span class="t-display-2 case-h1__text">{h1.text}</span>
        </h1>
        {hero.chips?.length > 0 && (
          <ul class="case-specs tpl-mhide" role="list" aria-label="Datos del caso">
            {hero.chips.map((c: string) => <li class="chip-spec">{c}</li>)}
          </ul>
        )}
        {hero.lede && (
          <p class:list={['t-lede t-lede--2 case-hero__lede', ledeM && 'tpl-mhide', edgeText !== null && 'case-edge']} style={edgeText !== null ? `--case-edge:${edgeText}` : undefined}>
            <Copy text={hero.lede} />{ledeFig && <sup class="case-fn" aria-hidden="true">1</sup>}
          </p>
        )}
        {ledeM && <p class="t-lede t-lede--2 case-hero__lede tpl-dhide"><Copy text={ledeM} />{ledeMFig && <sup class="case-fn" aria-hidden="true">1</sup>}</p>}
        <HeroCtas label={primaryLabel(hero)} section="hero"
          waHref={wa(hero.ctaSecondary?.waMessage ?? page.secondaryCta?.waMessage)} waLabel={hero.ctaSecondary?.label ?? 'Escríbele a Kain'} />
        {/* QA #63 · §0.1-2: toda cifra lleva su nota de fuente, también en la portada */}
        {h1.metricId && <p class="t-micro case-hero__src tpl-mhide"><sup class="case-fn" aria-hidden="true">1</sup> {SOURCE_NOTE}.</p>}
        {hero.illus && <p slot="aside" class="chip-illus case-illus tpl-mhide">{hero.illus}</p>}
        {(hero.chips?.length > 0 || hero.illus || h1.metricId) && (
          <Fragment slot="more">
            {/* R3: en el intro móvil no cabe; la nota de fuente va justo después de la placa, antes de la fila de datos */}
            {h1.metricId && <p class="t-micro case-hero__src case-hero__src--m tpl-dhide"><sup class="case-fn" aria-hidden="true">1</sup> {SOURCE_NOTE}.</p>}
            {hero.illus && <p class="chip-illus tpl-illus-m tpl-dhide" aria-hidden="true">{hero.illus}</p>}
            {hero.chips?.length > 0 && (
              <ul class="case-specs case-specs--m tpl-dhide" role="list" aria-label="Datos del caso" tabindex="0">
                {hero.chips.map((c: string) => <li class="chip-spec">{c}</li>)}
              </ul>
            )}
          </Fragment>
        )}
      </ImageSection>
    );

    /* ───────────── 02 · Ficha del caso ───────────── */
    if (id === 'ficha') return (
      <section id="ficha" class="tpl-glow case-sec case-ficha" aria-labelledby="ficha-t">
        {rack && <span class="case-ficha__rack" aria-hidden="true"><img src={rack} alt="" width="320" height="179" loading="lazy" decoding="async" /></span>}
        <span class="tpl-aura-box" aria-hidden="true"><span class="case-aura case-aura--ficha"><img src={AURA_ISOTIPO} alt="" width="640" height="640" loading="lazy" decoding="async" /></span></span>
        <div class="frame case-ficha__frame">
          <div class="case-ficha__lead">
            <h2 id="ficha-t" class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{ficha.eyebrow ?? 'Ficha del caso'}</h2>
            {fichaDeck && <Copy as="p" class="t-standfirst case-ficha__deck" text={fichaDeck} data-reveal />}
            {(ficha.byline || ficha.note) && (
              <div class="case-byline" data-reveal>
                {ficha.byline && <p class="case-byline__by"><span class="case-byline__mark" aria-hidden="true"></span>{ficha.byline}</p>}
                {ficha.note && <p class="t-small case-byline__note">{ficha.note}</p>}
              </div>
            )}
          </div>
          <div class="case-ficha__sheet" data-reveal>
            <EntitySheet variant="case" title={false} rows={fichaRows} metricIds={fichaMetrics} />
          </div>
        </div>
      </section>
    );

    /* ───────────── 03 · Punto de partida ───────────── */
    if (id === 'punto-partida') { const R = C['punto-partida']; return (
      <section id="punto-partida" class="tpl-glow case-sec case-reto" data-tone="dolor" aria-labelledby="punto-partida-t">
        <span class="case-glow case-glow--amber" aria-hidden="true"></span>
        <span class="tpl-aura-box" aria-hidden="true"><span class="case-aura case-aura--reto"><img src={AURA_ONDAS} alt="" width="960" height="640" loading="lazy" decoding="async" /></span></span>
        <div class="frame case-reto__frame">
          <header class="case-head case-reto__head">
            {R.eyebrow && <p class="t-label t-label--amber eyebrow"><span class="node node--amber" aria-hidden="true"></span>{R.eyebrow}</p>}
            <h2 id="punto-partida-t" class="t-h2" data-split>{H2(R.h2).text}{R.h2?.soft && <> <span class="soft">{R.h2.soft}</span></>}</h2>
          </header>
          {R.margin?.text && (
            <aside class="case-reto__margin" aria-label="Nota al margen" data-reveal>
              <span class="node node--amber" aria-hidden="true"></span>
              <Copy as="p" text={R.margin.text} />
            </aside>
          )}
          <Prose class="case-reto__prose">
            {(R.body ?? []).map((p: string) => <Copy as="p" text={p} />)}
          </Prose>
        </div>
      </section>
    ); }

    /* ───────────── 04 · La cifra (CaseFigure) ───────────── */
    if (id === 'cifra' && cifraIds.length) return (
      <CaseFigureLocal>
        <CaseFigure id="cifra" variant={cifraVariant} metricIds={cifraIds} labels={{ before: cifra.figure?.before, after: cifra.figure?.after }} class="case-cifra tpl-glow">
          {cifra.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{cifra.eyebrow}</p>}
          <h2 id="cifra-t" class="t-h2" data-split>{H2(cifra.h2).text}{cifra.h2?.soft && <> <span class="soft">{cifra.h2.soft}</span></>}</h2>
          {cifra.figure?.caption && <p class="t-micro case-cifra__cap" data-reveal>{cifra.figure.caption}</p>}
          {cifra.line && <Fragment slot="foot"><Copy as="p" class="t-lede t-lede--2 case-cifra__line" text={cifra.line} /></Fragment>}
        </CaseFigure>
      </CaseFigureLocal>
    );

    /* ───────────── 05 · Qué implementamos (SystemFlow) ───────────── */
    if (id === 'implementacion') return (
      <section id="implementacion" class="tpl-glow case-sec case-impl" aria-labelledby="implementacion-t">
        <span class="case-glow case-glow--cyan" aria-hidden="true"></span>
        <Aura kind="ondas" x="55%" y="40%" o={1} />
        <div class="frame">
          <header class="case-head">
            {impl.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{impl.eyebrow}</p>}
            <h2 id="implementacion-t" class="t-h2" data-split>{H2(impl.h2).text}{impl.h2?.soft && <> <span class="soft">{impl.h2.soft}</span></>}</h2>
            {impl.lede && <Copy as="p" class="t-lede t-lede--2" text={impl.lede} data-reveal />}
          </header>
          {flowNodes.length > 0 && (
            <div class="case-impl__flow" data-reveal>
              <SystemFlow nodes={flowNodes} title={H2(impl.h2).text} />
            </div>
          )}
          {impl.body?.length > 0 && (
            <div class="case-impl__body" data-reveal>
              {impl.body.map((p: string) => <Copy as="p" class="t-body" text={p} />)}
            </div>
          )}
        </div>
      </section>
    );

    /* ───────────── 06 · Resultado (ImageSection mid + agenda registrada) ───────────── */
    if (id === 'resultado') return (
      <ImageSection
        id="resultado"
        plate={resPlate?.id ?? 'caso-resultado'}
        layout={resPlate?.layout ?? 'subject-left'}
        mirror={resPlate?.mirror}
        mobile={resPlate?.mobile ?? 'top'}
        srcsetMax={resPlate?.srcsetMax ?? 1920}
        fallbackPlate={resPlate?.launchFallback}
        height="mid"
        push={{ anchor: 'mano', to: 1.08 }}
        alt=""
        class="case-res"
      >
        {res.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{res.eyebrow}</p>}
        <h2 id="resultado-t" class="t-h2">{H2(res.h2).text}{res.h2?.soft && <> <span class="soft">{res.h2.soft}</span></>}</h2>
        {res.quote && <Copy as="p" class="t-deck case-res__quote" text={res.quote} />}
        {res.sourceNote && <p class="t-micro case-res__src"><span class="node" aria-hidden="true"></span>{SOURCE_NOTE}.</p>}
        {ui && panel && (
          <p class="case-res__legend only-m" data-nosnippet>
            <span class="chip-sim">SIMULACIÓN</span>
            <span>{ui.title}{ui.slot && <> · <i class="case-agenda__dot" aria-hidden="true"></i>{ui.slot}</>}</span>
          </p>
        )}
        {ui && panel && (
          <div slot="anchors" class="anchor anchor--panel case-agenda" style={panel.style} data-anchor={panel.name} data-lock
            data-m={panel.mobile ? undefined : 'none'} data-nosnippet role="img"
            aria-label={`Simulación: ${ui.title ?? 'agenda'}${ui.slot ? `; cada casilla encendida es una ${ui.slot.toLowerCase()}` : ''}.`}>
            <div class="ui case-agenda__ui" aria-hidden="true">
              <p class="case-agenda__top"><span class="chip-sim">SIMULACIÓN</span><span class="case-agenda__t">{ui.title}</span></p>
              <ol class="case-agenda__days" role="list">
                {agenda.map((row: any) => (
                  <li class="case-agenda__day">
                    <span class="case-agenda__d">{row.d}</span>
                    <span class="case-agenda__slots">
                      {row.slots.map((s: any) => <i class:list={[s.on && 'is-on']} style={s.on ? `--k:${s.k}` : undefined}></i>)}
                    </span>
                  </li>
                ))}
              </ol>
              {ui.slot && <p class="case-agenda__key"><i class="is-on"></i>{ui.slot}</p>}
            </div>
          </div>
        )}
      </ImageSection>
    );

    /* ───────────── 07 · VKTOR ───────────── */
    if (id === 'vktor') return (
      <section id="vktor" class="tpl-glow case-sec case-vktor" aria-labelledby="vktor-t">
        <Aura kind="ondas" x="40%" y="55%" o={1} />
        <div class="frame">
          <header class="case-head">
            {vk.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{vk.eyebrow}</p>}
            <h2 id="vktor-t" class="t-h2" data-split>{H2(vk.h2).text}{vk.h2?.soft && <> <span class="soft">{vk.h2.soft}</span></>}</h2>
            {vk.lede && <Copy as="p" class="t-lede t-lede--2" text={vk.lede} data-reveal />}
          </header>
          <div class="case-vktor__rail">
            <VktorRail
              variant={vkMilestones ? 'milestones' : 'phases'}
              milestones={vkMilestones ?? undefined}
              lines={(vk.phases ?? []).map((p: any) => p.line)}
              href={hrefOr(vkLink?.href ?? '/metodologia/') ?? false}
              linkLabel={vkLink?.label ?? 'Conoce el protocolo completo'}
            />
          </div>
        </div>
      </section>
    );

    /* ───────────── 08 · Qué puedes replicar ───────────── */
    if (id === 'replicar') return (
      <section id="replicar" class="tpl-glow case-sec case-rep" aria-labelledby="replicar-t">
        <Aura kind="ondas" x="72%" y="55%" o={0.9} />
        <div class="frame">
          <header class="case-head">
            {rep.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{rep.eyebrow}</p>}
            <h2 id="replicar-t" class="t-h2" data-split>{H2(rep.h2).text}{rep.h2?.soft && <> <span class="soft">{rep.h2.soft}</span></>}</h2>
          </header>
          <div class="case-rep__list">
            <ScriptList rows={(rep.items ?? []).map((r: any) => ({ n: r.n, title: r.title, line: r.line, href: hrefOr(r.href) }))} label={H2(rep.h2).text} />
            {(rep.links ?? []).some((l: any) => hrefOr(l.href)) && (
              <p class="case-links">{(rep.links as any[]).map((l) => quoteLink(l, 'replica', page.url)).filter((l) => hrefOr(l.href)).map((l: any) => <a class="lnk" href={l.href} {...l.attrs}>{l.label}<Icon name="arrow" size={18} /></a>)}</p>
            )}
          </div>
        </div>
      </section>
    );

    /* ───────────── 09 · Testimonio (solo con aprobación escrita) ───────────── */
    if (id === 'testimonio') return (
      <section id="testimonio" class="tpl-glow case-sec case-testi" aria-labelledby="testimonio-t">
        <div class="frame">
          <header class="case-head">
            <h2 id="testimonio-t" class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{testi.eyebrow ?? 'En sus palabras'}</h2>
          </header>
          <div class="case-testi__q">
            <Quote source={testi.nombre} role={[testi.cargo, testi.empresa].filter(Boolean).join(', ')}>{testi.frase}</Quote>
          </div>
        </div>
      </section>
    );

    /* ───────────── 10 · Sigue explorando + Siguiente reportaje ───────────── */
    if (id === 'relacionados') return (
      <section id="relacionados" class="tpl-glow case-sec case-rel" aria-labelledby="relacionados-t">
        <Aura kind="ondas" x="50%" y="60%" o={1} only="m" />
        <div class="frame">
          <header class="case-head">
            <h2 id="relacionados-t" class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{rel.eyebrow ?? 'Sigue explorando'}</h2>
          </header>
          {rel.items?.length > 0 && (
            <div class="case-rel__list">
              <ScriptList rows={rel.items.map((r: any) => ({ title: r.title, line: r.line, href: hrefOr(r.href) }))} label={rel.eyebrow ?? 'Sigue explorando'} />
            </div>
          )}
        </div>
        {nextHref && (
          <div class="case-next">
            <Still variant="next" href={nextHref} plate={nextPlate} title={next.title} metricId={next.metricId} headingLevel={3} />
          </div>
        )}
      </section>
    );

    /* ───────────── 11 · Cierre (Dawn) ─────────────
       Contenido por slot (no por `copy`): primario «Cotizar proyecto» con la microcopia compartida (_comun.cta.micro).
       Una duración en el titular ("30 minutos") no es cifra comercial (allowDur). */
    if (id === 'cta-final') return (
      <Dawn
        plate={ctaPlate?.id ?? 'cta-amanecer'}
        mirror={ctaPlate?.mirror}
        layout={ctaPlate?.layout}
        fallbackPlate={ctaPlate?.launchFallback}
        class="tpl-glow-m"
      >
        {cta.eyebrow && <p class="t-label t-label--cyan eyebrow"><span class="node" aria-hidden="true"></span>{cta.eyebrow}</p>}
        <h2 id="cta-final-t" class="t-h2" data-split>
          <Fragment set:html={allowDur(H2(cta.h2).text)} />{cta.h2?.soft && <> <span class="soft" set:html={allowDur(cta.h2.soft)} /></>}
        </h2>
        {cta.lede && <Copy as="p" class="t-lede t-lede--2" text={cta.lede} />}
        <div class="ctas">
          <Btn variant="primary" cotizar data-section="cta-final" label={primaryLabel(cta)} micro />
          <Btn variant="ghost" href={wa(cta.ctaSecondary?.waMessage ?? page.secondaryCta?.waMessage)} label={cta.ctaSecondary?.label ?? 'Escríbele a Kain'} />
        </div>
      </Dawn>
    );
    return null;
  })}
</BaseLayout>
