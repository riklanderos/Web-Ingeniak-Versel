---
// SEOHead — title, meta, canonical, Open Graph / Twitter, robots y @graph JSON-LD (ESPEC §8.4–8.5).
// Props:
//   page          entrada de src/data/sitemap.json (obligatoria)
//   faq?          [{ q, a }] preguntas VISIBLES en la página (FAQPage idéntico al texto)
//   faqIds?       ids del banco (G01, W03…) → src/data/faq.json (sin "validar"); por defecto, las del copy de la página
//   title?, description?  sobrescriben los de sitemap.json (solo páginas de desarrollo)
//   ogImage?      ruta pública; por defecto /img/og/<page.id>.jpg → /img/og/ingeniak.jpg
//   noindex?      fuerza "noindex,follow" (casos breves, R2). El 404 y las no indexables ya lo llevan.
//   datePublished?, dateModified?  ISO, para Article/BlogPosting
//   jsonLd?       nodos extra para el @graph (Person, etc.)
//   articleAbout? Article/BlogPosting → about (casos: el Service; CaseTemplate #9)
//   articleExtra? propiedades extra del MISMO nodo Article/BlogPosting (wordCount, articleSection, keywords, citation, timeRequired)
//   howToSteps?   [{ name, text }] × 5: texto completo de cada fase del HowTo (T-METHOD); por defecto, los verbos de VKTOR™
// FAQPage: faqPageLd() de src/components/ui/ui-data.ts (la misma fuente, filtro y texto que FAQAccordion; una sola implementación).
import fs from 'node:fs';
import path from 'node:path';
import { SITE, getPlate, type Page } from '../../lib/site';
import { buildGraph, type FaqItem } from './jsonld';
import { tryCopy } from './copyText';
import { faqPageLd, tokensToText } from '../ui/ui-data';
import { heroPlateOf } from './navData';

interface Props {
  page: Page;
  faq?: FaqItem[];
  faqIds?: string[];
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  jsonLd?: Record<string, any>[];
  articleAbout?: Record<string, any> | Record<string, any>[];
  articleExtra?: Record<string, any>;
  howToSteps?: { name: string; text: string }[];
}
const p = Astro.props;
const page = p.page as any;

const title: string = p.title ?? page.title ?? 'Ingeniak';
const description: string = p.description ?? page.metaDescription ?? '';
const is404 = page.id === '404' || page.template === 'T-404';
const robots = is404 || p.noindex || page.indexable === false ? 'noindex,follow' : 'index,follow,max-image-preview:large';
const canonical: string = page.canonical ?? `${SITE.url}${page.url}`;

// Imagen OG: la de la página si ya existe en public/img/og/, si no la general.
const pub = (u: string) => fs.existsSync(path.join(process.cwd(), 'public', u));
const ownCard = pub(`/img/og/${page.id}.jpg`);
const ogImage =
  p.ogImage ??
  (ownCard ? `/img/og/${page.id}.jpg` : pub('/img/og/ingeniak.jpg') ? '/img/og/ingeniak.jpg' : '/img/og-ingeniak.jpg');
const ogAbs = `${SITE.url}${ogImage}`;
// og:image:alt describe la TARJETA (no repite el H1 como si fuera la imagen). Tarjeta por página (tarea 5 del orquestador):
// still de su portada + su titular + logotipo. Tarjeta general: logotipo, isotipo de cristal y el lema.
const heroPlate = heroPlateOf(page.url);
// El alt de la placa ya trae su propio paréntesis ("… (imagen ilustrativa)", aviso que se conserva): la escena va tras una
// coma, no entre paréntesis, para no anidarlos (QA r2 · /discovery/).
const heroAlt = ((heroPlate ? (getPlate(heroPlate) as any)?.alt : '') as string) || '';
const sceneOf = heroAlt.replace(/\.$/, '').trim();
const lc1 = (s: string) => (s && !/^(Kain|Ingeniak)\b/.test(s) ? s[0].toLowerCase() + s.slice(1) : s);
const cardOf = page.url === '/' ? 'de la portada' : `de la página «${page.breadcrumbs?.at?.(-1)?.name ?? title}»`;
const ogAlt = ownCard && !p.ogImage
  ? `Tarjeta de Ingeniak ${cardOf}: su titular y el logotipo de Ingeniak sobre la escena de su portada${sceneOf ? `, ${lc1(sceneOf)}` : ''}`
  : 'Tarjeta de Ingeniak: logotipo, isotipo de cristal azul y el lema «Agentizamos empresas.» sobre fondo azul noche';

// FAQ (FAQPage idéntico al texto visible): 1) las que la página pasa (faq); 2) faqIds; 3) las faqIds del copy de la página
// (src/content/paginas/<id>.json → sections.faq.faqIds) si la página tiene sección "faq". 2 y 3 salen de faqPageLd (ui-data):
// banco src/data/faq.json (sin "validar"), respaldo sitemap.json → page.faq, tokens {{metric:…}} en texto plano.
const autoIds: string[] | undefined = (page.sections ?? []).some((s: any) => s.id === 'faq') ? tryCopy(page.id)?.sections?.faq?.faqIds : undefined;
const ids = p.faq ? undefined : p.faqIds ?? (autoIds?.length ? autoIds : undefined);
const faq: FaqItem[] | undefined = p.faq?.map((f) => ({ ...f, q: tokensToText(f.q), a: tokensToText(f.a) }));
const faqNode = ids?.length ? faqPageLd(ids, canonical) : null;

const graph = is404 ? [] : buildGraph(page, { faq, faqNode, title, description, ogImage, datePublished: p.datePublished, dateModified: p.dateModified, extra: p.jsonLd, articleAbout: p.articleAbout, articleExtra: p.articleExtra, howToSteps: p.howToSteps });
const isArticle = page.template === 'T-ARTICLE' || page.template === 'T-CASE';
const ld = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c') : '';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!is404 && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:locale" content="es_MX" />
<meta property="og:site_name" content="Ingeniak" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogAbs} />
{ld && <script type="application/ld+json" set:html={ld} />}
