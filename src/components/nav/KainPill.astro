---
// KainPill — píldora "Escríbele a Kain" en escritorio (≥ 768 px), abajo a la derecha (ESPEC §4.6, F21).
// Visible desde el segundo viewport y SOLO mientras el encabezado está oculto (html[data-hdr="hidden"]).
// Se oculta en secuencias fijadas (html[data-sala]) y con el cierre visible (html[data-dawn-visible]). Nunca azul.
// Kain aparece de cuerpo completo (regla de marca), en miniatura.
import { SITE } from '../../lib/site';
interface Props { waHref?: string }
const { waHref = SITE.waBase } = Astro.props;
---
<a class="kpill" href={waHref} target="_blank" rel="noopener" data-kpill>
  <span class="kpill__kain" aria-hidden="true"><img src="/img/kain/kain-presenta.webp" alt="" width="560" height="996" loading="lazy" decoding="async" /></span>
  <span class="kpill__txt">
    <span class="kpill__t">Escríbele a Kain</span>
    <span class="kpill__s"><span class="dot-live" aria-hidden="true"></span>responde 24/7</span>
  </span>
</a>
