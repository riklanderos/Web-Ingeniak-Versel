---
// Prose · ESPEC §6 #43. Cuerpo editorial (Inter 19 px, 64ch) para artículos MDX, casos y aviso legal.
// toc → índice (TOC) sticky en columnas 1–2 en escritorio; plegable (<details>) en móvil. El cuerpo va en columnas 3–9.
// Subcomponentes: ./Figure.astro (figura con pie, sin tarjeta) y ./Quote.astro (solo citas con fuente).
// Notas al pie: <sup class="fn"><a href="#fn-1" id="ref-1">1</a></sup> … <ol class="footnotes"><li id="fn-1">…</li></ol>
interface Props { toc?: { id: string; text: string; level?: 2 | 3 }[]; tocLabel?: string; class?: string; id?: string }
const { toc, tocLabel = 'En este artículo', class: cls, id } = Astro.props;
---
<div class:list={['prose-wrap', toc?.length && 'prose-wrap--toc', cls]} id={id}>
  {toc && toc.length > 0 && (
    <nav class="toc" aria-label={tocLabel} data-toc>
      <details class="toc__details" open>
        <summary class="toc__sum t-label"><span class="node" aria-hidden="true"></span>{tocLabel}</summary>
        <ol class="toc__list">
          {toc.map((t) => <li class:list={['toc__item', t.level === 3 && 'toc__item--sub']}><a href={`#${t.id}`} data-toc-link>{t.text}</a></li>)}
        </ol>
      </details>
    </nav>
  )}
  <div class="prose"><slot /></div>
</div>
