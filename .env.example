# Ingeniak · variables de entorno (CAMBIO-COTIZAR §3.6 y §5.8).
# Plantilla SIN valores: los reales solo se capturan en Vercel → Settings → Environment Variables
# (Production y Preview) y después se hace Redeploy. Nunca escribas un token o una llave real aquí.
# VERCEL_ENV lo pone Vercel solo (production | preview | development); no la definas.
# Sin KOMMO_SUBDOMAIN/KOMMO_TOKEN, fuera de producción, /api/cotizar/ responde en modo simulación.

# ── Cotización → Kommo ─────────────────────────────────────────────────────────────
# Subdominio de la cuenta: lo que va antes de .kommo.com (obligatoria en producción).
KOMMO_SUBDOMAIN=
# Token de larga duración de la integración privada (SECRETA: tipo Secret en Vercel; obligatoria en producción).
KOMMO_TOKEN=
# Id numérico del embudo de las cotizaciones (opcional; sin él, el embudo principal).
KOMMO_PIPELINE_ID=
# Id numérico de la etapa, p. ej. «Nuevo · Sitio web» (opcional; debe pertenecer a ese embudo).
KOMMO_STATUS_ID=
# Id numérico del usuario responsable de las cotizaciones (opcional; sin él, la asignación por defecto de Kommo).
KOMMO_RESPONSIBLE_USER_ID=
# Id del embudo de las reservas de la agenda (opcional; por defecto, el de la cotización).
KOMMO_AGENDA_PIPELINE_ID=
# Id de la etapa de las reservas de la agenda (opcional; por defecto, la de la cotización).
KOMMO_AGENDA_STATUS_ID=
# URL que recibe una copia de cada lead y las alertas de Kommo, p. ej. n8n o Make (opcional; secreta).
NOTIFY_WEBHOOK_URL=
# Valor que viaja en la cabecera x-webhook-secret del webhook de aviso (opcional; SECRETA).
NOTIFY_WEBHOOK_SECRET=
# Solo pruebas locales: URL de un simulador de Kommo. Nunca se define en Vercel.
KOMMO_BASE_URL=

# ── Agenda (Discovery Session y Power Session; mismos nombres que riklanderos.tech) ──
# Id del Google Calendar de las Power Sessions (el mismo de riklanderos.tech con la opción A).
POWER_CALENDAR_ID=
# Id del Google Calendar de las Discovery Sessions (el mismo de riklanderos.tech con la opción A).
DISCOVERY_CALENDAR_ID=
# Llave secreta de Stripe de la cuenta que cobra (SECRETA; en Preview usa la de prueba sk_test_).
STRIPE_SECRET_KEY=
# Cadena aleatoria larga que Vercel manda al cron de limpieza de apartados (SECRETA).
CRON_SECRET=
# URL del proyecto de Supabase para guardar leads de la agenda (solo con la opción A1).
SUPABASE_URL=
# Llave service role de Supabase (SECRETA; solo con la opción A1).
SUPABASE_SERVICE_ROLE_KEY=
# Conector de Vercel Connect para Google (solo si cambia el valor por defecto google/riklanderos-web).
AGENDA_GOOGLE_CONNECTOR=
# Sujeto del conector de Google (solo si cambia el valor por defecto rik).
AGENDA_GOOGLE_SUBJECT=
# URL base para los enlaces de pago y confirmación (solo si cambia la detectada, p. ej. https://ingeniak.mx).
AGENDA_BASE_URL=
# Plan B sin Vercel Connect: id del cliente OAuth de Google (SECRETA).
GOOGLE_CLIENT_ID=
# Plan B sin Vercel Connect: secreto del cliente OAuth de Google (SECRETA).
GOOGLE_CLIENT_SECRET=
# Plan B sin Vercel Connect: refresh token de Google Calendar (SECRETA).
GOOGLE_REFRESH_TOKEN=
# Solo local: 1 activa los adaptadores simulados de Google y Stripe. Nunca en Vercel.
AGENDA_MOCK=
# Solo local: 1 llena la semana de Power Session en la simulación. Nunca en Vercel.
AGENDA_MOCK_LLENO=
